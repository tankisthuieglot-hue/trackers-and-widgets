{
 "id": "75b8c613-9736-55d4-a015-28fe183951dd",
 "scriptName": "💰 VLD LOOT · ru",
 "findRegex": "/\\[\\[VLD_LOOT(?![A-Z0-9_])(?=[^\\]]*\\|\\s*S\\s*=[ \\t]*([^|\\]<]*)|)(?=[^\\]]*\\|\\s*I1\\s*=[ \\t]*([^|\\]<]*)|)(?=[^\\]]*\\|\\s*R1\\s*=[ \\t]*(junk|plain|good|rare|prize|legend)|)(?=[^\\]]*\\|\\s*I2\\s*=[ \\t]*([^|\\]<]*)|)(?=[^\\]]*\\|\\s*R2\\s*=[ \\t]*(junk|plain|good|rare|prize|legend)|)(?=[^\\]]*\\|\\s*I3\\s*=[ \\t]*([^|\\]<]*)|)(?=[^\\]]*\\|\\s*R3\\s*=[ \\t]*(junk|plain|good|rare|prize|legend)|)(?=[^\\]]*\\|\\s*I4\\s*=[ \\t]*([^|\\]<]*)|)(?=[^\\]]*\\|\\s*R4\\s*=[ \\t]*(junk|plain|good|rare|prize|legend)|)(?=[^\\]]*\\|\\s*M\\s*=[ \\t]*([^|\\]<]*)|)[^\\]]*\\]\\]/g",
 "replaceString": "<div class=\"vld-w vld-loot\">\n  <div class=\"haul\">\n    <div class=\"src\">\n      <span class=\"k\">откуда</span>\n      <span class=\"v\">$1</span>\n    </div>\n\n    <ul class=\"items\">\n      <li class=\"it r-$3\"><span class=\"pip\"></span><span class=\"nm\">$2</span></li>\n      <li class=\"it r-$5\"><span class=\"pip\"></span><span class=\"nm\">$4</span></li>\n      <li class=\"it r-$7\"><span class=\"pip\"></span><span class=\"nm\">$6</span></li>\n      <li class=\"it r-$9\"><span class=\"pip\"></span><span class=\"nm\">$8</span></li>\n    </ul>\n\n    <div class=\"coin\"><span class=\"sum\">$10</span></div>\n  </div>\n  <style>\n    /* Цвет здесь не мера, а разряд: «редкое» не больше «обычного», оно другое.\n       Поэтому никакой шкалы — только метка у строки и рамка вокруг неё, как в\n       играх, откуда эта привычка и взялась.\n\n       Одна вольность: легендарному разряду разрешён бегущий блик. Он заметно\n       дороже остальных строк по вниманию, и это ровно то, чего от него ждут —\n       но именно поэтому в промпте написано использовать его почти никогда. */\n\n    .vld-loot {\n      --ink: #e9e6df;\n      --dim: #86837c;\n      --plate: #16171a;\n      --hair: rgba(233, 230, 223, .1);\n\n      --junk: 122, 120, 116;\n      --plain: 196, 196, 192;\n      --good: 118, 172, 118;\n      --rare: 104, 152, 208;\n      --prize: 172, 124, 204;\n      --legend: 214, 164, 68;\n\n      --mono: ui-monospace, \"Cascadia Mono\", \"Consolas\", \"DejaVu Sans Mono\", monospace;\n      --sans: ui-sans-serif, system-ui, \"Segoe UI\", Roboto, sans-serif;\n\n      width: min(100%, 344px);\n      margin: 14px auto;\n      color: var(--ink);\n      filter: drop-shadow(0 12px 26px rgba(0, 0, 0, .45));\n    }\n\n    .vld-loot * {\n      box-sizing: border-box;\n    }\n\n    .vld-loot .haul {\n      padding: 12px 13px 11px;\n      border-radius: 3px;\n      background: var(--plate);\n      box-shadow: inset 0 0 0 1px var(--hair);\n      animation: vld-loot-in .3s ease both;\n    }\n\n    @keyframes vld-loot-in {\n      from { opacity: 0; transform: translateY(5px); }\n    }\n\n    .vld-loot .src {\n      display: grid;\n      grid-template-columns: auto 1fr;\n      gap: 8px;\n      align-items: baseline;\n      padding-bottom: 10px;\n      border-bottom: 1px solid var(--hair);\n    }\n\n    .vld-loot .k {\n      font: 400 8.5px/1.5 var(--mono);\n      text-transform: uppercase;\n      letter-spacing: .13em;\n      color: var(--dim);\n    }\n\n    .vld-loot .src .v {\n      font: 400 12px/1.3 var(--sans);\n    }\n\n    .vld-loot .items {\n      margin: 0;\n      padding: 0;\n      list-style: none;\n      display: grid;\n      gap: 3px;\n    }\n\n    .vld-loot .it {\n      --tone: var(--plain);\n\n      position: relative;\n      overflow: hidden;\n      display: flex;\n      align-items: center;\n      gap: 9px;\n      margin-top: 9px;\n      padding: 7px 10px;\n      border-radius: 2px;\n      background: rgba(var(--tone), .07);\n      box-shadow: inset 0 0 0 1px rgba(var(--tone), .3);\n      animation: vld-loot-slide .34s cubic-bezier(.2, .85, .3, 1) both;\n    }\n\n    /* Вещи выкладываются одна за другой — как их и достают из ящика. */\n    .vld-loot .items .it:nth-child(2) { animation-delay: .08s; }\n    .vld-loot .items .it:nth-child(3) { animation-delay: .16s; }\n    .vld-loot .items .it:nth-child(4) { animation-delay: .24s; }\n\n    @keyframes vld-loot-slide {\n      from { opacity: 0; transform: translateX(-8px); }\n    }\n\n    .vld-loot .r-junk   { --tone: var(--junk); }\n    .vld-loot .r-plain  { --tone: var(--plain); }\n    .vld-loot .r-good   { --tone: var(--good); }\n    .vld-loot .r-rare   { --tone: var(--rare); }\n    .vld-loot .r-prize  { --tone: var(--prize); }\n    .vld-loot .r-legend { --tone: var(--legend); }\n\n    /* Хлам и выглядит хламом. Разряд читается ещё до того, как прочитано имя. */\n    .vld-loot .r-junk .nm {\n      color: rgba(233, 230, 223, .55);\n    }\n\n    .vld-loot .pip {\n      flex: 0 0 auto;\n      width: 8px;\n      height: 8px;\n      /* Ромб, а не кружок: круглых точек в интерфейсах и так довольно. */\n      transform: rotate(45deg);\n      border-radius: 1px;\n      background: rgb(var(--tone));\n      box-shadow: 0 0 9px rgba(var(--tone), .6);\n    }\n\n    .vld-loot .nm {\n      min-width: 0;\n      font: 400 12.5px/1.35 var(--sans);\n    }\n\n    /* Единственная вещь в паке, которой позволено сиять. */\n    .vld-loot .r-legend {\n      box-shadow: inset 0 0 0 1px rgba(var(--legend), .6), 0 0 18px rgba(var(--legend), .16);\n    }\n\n    .vld-loot .r-legend::after {\n      content: \"\";\n      position: absolute;\n      inset: 0;\n      pointer-events: none;\n      background: linear-gradient(102deg, transparent 40%, rgba(255, 226, 158, .17) 50%, transparent 60%);\n      animation: vld-loot-shine 3.4s ease-in-out 1.2s infinite;\n    }\n\n    @keyframes vld-loot-shine {\n      0%      { transform: translateX(-110%); }\n      55%,\n      100%    { transform: translateX(110%); }\n    }\n\n    .vld-loot .coin {\n      margin-top: 11px;\n      padding-top: 9px;\n      border-top: 1px dashed rgba(233, 230, 223, .16);\n      text-align: right;\n    }\n\n    .vld-loot .sum {\n      font: 500 12.5px/1 var(--mono);\n      font-variant-numeric: tabular-nums;\n      color: rgb(var(--legend));\n    }\n\n    .vld-loot .sum::before {\n      content: \"+ \";\n      opacity: .55;\n    }\n\n    .vld-loot .coin:has(.sum:empty),\n    .vld-loot .it:has(.nm:empty),\n    .vld-loot .src:has(.v:empty) {\n      display: none;\n    }\n\n    /* Ни одной вещи и ни денег — нечего показывать. */\n    .vld-loot .haul:not(:has(.nm:not(:empty))):not(:has(.sum:not(:empty))) {\n      display: none;\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      .vld-loot .haul,\n      .vld-loot .it,\n      .vld-loot .r-legend::after {\n        animation: none;\n      }\n\n      .vld-loot .r-legend::after {\n        display: none;\n      }\n    }\n  </style>\n</div>",
