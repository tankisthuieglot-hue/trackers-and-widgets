{
 "id": "383d1f7d-3ac1-53b0-aba7-9fedaa160252",
 "scriptName": "🎲 VLD DICE · ru",
 "findRegex": "/\\[\\[VLD_DICE(?![A-Z0-9_])(?=[^\\]]*\\|\\s*A\\s*=[ \\t]*([^|\\]<]*)|)(?=[^\\]]*\\|\\s*R\\s*=[ \\t]*([0-9]{0,3})|)(?=[^\\]]*\\|\\s*D\\s*=[ \\t]*([0-9]{0,3})|)(?=[^\\]]*\\|\\s*O\\s*=[ \\t]*(crit|pass|edge|fail|fumble)|)(?=[^\\]]*\\|\\s*C\\s*=[ \\t]*([^|\\]<]*)|)[^\\]]*\\]\\]/g",
 "replaceString": "<div class=\"vld-w vld-dice\">\n  <div class=\"throw o-$4\">\n    <div class=\"die\">\n      <span class=\"facets\"></span>\n      <b class=\"roll\">$2</b>\n    </div>\n\n    <div class=\"read\">\n      <div class=\"act\">$1</div>\n\n      <div class=\"verdict\">\n        <span class=\"word\">\n          <span class=\"w-crit\">критический успех</span>\n          <span class=\"w-pass\">успех</span>\n          <span class=\"w-edge\">на волоске</span>\n          <span class=\"w-fail\">провал</span>\n          <span class=\"w-fumble\">катастрофа</span>\n        </span>\n        <span class=\"dc\">нужно <b>$3</b></span>\n      </div>\n\n      <div class=\"cost\">$5</div>\n    </div>\n  </div>\n  <style>\n    /* Единственный виджет в паке, который показывает не состояние, а мгновение:\n       бросок уже случился, и переигрывать его нельзя. Отсюда и подача — кубик\n       прилетает и останавливается, а не наливается плавно, как шкала.\n\n       Все пять исходов написаны в разметке, лишние прячет CSS по классу. Так\n       слово исхода переведено на язык пользователя, а не приезжает от модели\n       английским словом из списка. */\n\n    .vld-dice {\n      --ink: #ece9e3;\n      --dim: #8a8781;\n      --plate: #17181b;\n      --hair: rgba(236, 233, 227, .1);\n\n      --crit: 214, 176, 84;\n      --pass: 124, 176, 108;\n      --edge: 208, 162, 78;\n      --fail: 150, 152, 158;\n      --fumble: 202, 84, 88;\n\n      --mono: ui-monospace, \"Cascadia Mono\", \"Consolas\", \"DejaVu Sans Mono\", monospace;\n\n      width: min(100%, 356px);\n      margin: 14px auto;\n      color: var(--ink);\n      filter: drop-shadow(0 12px 24px rgba(0, 0, 0, .45));\n    }\n\n    .vld-dice * {\n      box-sizing: border-box;\n    }\n\n    .vld-dice .throw {\n      --tone: var(--fail);\n\n      display: grid;\n      grid-template-columns: 74px 1fr;\n      gap: 13px;\n      align-items: center;\n      padding: 13px 14px;\n      border-radius: 3px;\n      background: var(--plate);\n      box-shadow: inset 0 0 0 1px var(--hair);\n    }\n\n    .vld-dice .o-crit   { --tone: var(--crit); }\n    .vld-dice .o-pass   { --tone: var(--pass); }\n    .vld-dice .o-edge   { --tone: var(--edge); }\n    .vld-dice .o-fail   { --tone: var(--fail); }\n    .vld-dice .o-fumble { --tone: var(--fumble); }\n\n    /* Двадцатигранник узнаётся силуэтом, поэтому он и вырезан многоугольником,\n       а не нарисован кружком с цифрой. */\n    .vld-dice .die {\n      position: relative;\n      width: 74px;\n      height: 68px;\n      display: grid;\n      place-items: center;\n      clip-path: polygon(50% 0, 100% 26%, 100% 74%, 50% 100%, 0 74%, 0 26%);\n      background: linear-gradient(160deg, rgba(var(--tone), .3), rgba(var(--tone), .1));\n      box-shadow: inset 0 0 0 1px rgba(var(--tone), .45);\n      animation: vld-dice-land .46s cubic-bezier(.16, .9, .3, 1) both;\n    }\n\n    /* Кубик прилетает уже брошенным: приходит крупным, довёрнутым и садится на\n       место. Крутиться дальше ему незачем — результат известен. */\n    @keyframes vld-dice-land {\n      from { opacity: 0; transform: scale(1.7) rotate(-38deg); }\n    }\n\n    /* Грани: три линии от вершин к центру превращают шестиугольник в объём. */\n    .vld-dice .facets {\n      position: absolute;\n      inset: 0;\n      background:\n        linear-gradient(150deg, transparent calc(50% - .5px), rgba(255, 255, 255, .12) calc(50% - .5px) calc(50% + .5px), transparent calc(50% + .5px)),\n        linear-gradient(210deg, transparent calc(50% - .5px), rgba(255, 255, 255, .12) calc(50% - .5px) calc(50% + .5px), transparent calc(50% + .5px)),\n        linear-gradient(180deg, transparent 50%, rgba(0, 0, 0, .22));\n    }\n\n    .vld-dice .roll {\n      position: relative;\n      font: 600 27px/1 var(--mono);\n      font-variant-numeric: tabular-nums;\n      color: rgb(var(--tone));\n      text-shadow: 0 0 16px rgba(var(--tone), .5);\n    }\n\n    /* Двадцатка светится и держит на себе взгляд — это единственный бросок,\n       который стоит отпраздновать. Единица дрожит. */\n    .vld-dice .o-crit .die {\n      box-shadow: inset 0 0 0 1px rgba(var(--crit), .8), 0 0 26px rgba(var(--crit), .38);\n      animation: vld-dice-land .46s cubic-bezier(.16, .9, .3, 1) both,\n                 vld-dice-glow 2.2s ease-in-out .5s infinite;\n    }\n\n    @keyframes vld-dice-glow {\n      50% { box-shadow: inset 0 0 0 1px rgba(var(--crit), 1), 0 0 40px rgba(var(--crit), .6); }\n    }\n\n    .vld-dice .o-fumble .die {\n      animation: vld-dice-land .46s cubic-bezier(.16, .9, .3, 1) both,\n                 vld-dice-shake 3.3s steps(1, end) .5s infinite;\n    }\n\n    @keyframes vld-dice-shake {\n      0%, 90%   { transform: none; }\n      92%       { transform: translateX(-2px) rotate(-1.5deg); }\n      94%       { transform: translateX(2px) rotate(1.5deg); }\n      96%, 100% { transform: none; }\n    }\n\n    .vld-dice .read {\n      min-width: 0;\n    }\n\n    .vld-dice .act {\n      font: 400 12.5px/1.35 var(--mono);\n      color: var(--ink);\n    }\n\n    .vld-dice .verdict {\n      display: flex;\n      align-items: baseline;\n      gap: 9px;\n      margin-top: 7px;\n    }\n\n    .vld-dice .word {\n      font: 600 11px/1 var(--mono);\n      text-transform: uppercase;\n      letter-spacing: .13em;\n      color: rgb(var(--tone));\n    }\n\n    /* Пять слов лежат в разметке, показывается одно. Модель прислала не то —\n       не показывается ни одного, и виджет молчит вместо того, чтобы врать. */\n    .vld-dice .word span {\n      display: none;\n    }\n\n    .vld-dice .o-crit   .w-crit,\n    .vld-dice .o-pass   .w-pass,\n    .vld-dice .o-edge   .w-edge,\n    .vld-dice .o-fail   .w-fail,\n    .vld-dice .o-fumble .w-fumble {\n      display: inline;\n    }\n\n    .vld-dice .dc {\n      font: 400 10px/1 var(--mono);\n      letter-spacing: .06em;\n      color: var(--dim);\n    }\n\n    .vld-dice .dc b {\n      font-weight: 600;\n      color: rgba(236, 233, 227, .75);\n    }\n\n    .vld-dice .cost {\n      margin-top: 6px;\n      padding-top: 6px;\n      border-top: 1px solid var(--hair);\n      font: 400 11.5px/1.4 var(--mono);\n      color: var(--dim);\n    }\n\n    /* Порога нет — не показывать «нужно» без числа. */\n    .vld-dice .dc:has(b:empty),\n    .vld-dice .cost:empty {\n      display: none;\n    }\n\n    /* Без броска и без действия показывать нечего. */\n    .vld-dice .throw:has(.roll:empty),\n    .vld-dice .throw:has(.act:empty) {\n      display: none;\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      .vld-dice .die,\n      .vld-dice .o-crit .die,\n      .vld-dice .o-fumble .die {\n        animation: none;\n      }\n    }\n  </style>\n</div>",
