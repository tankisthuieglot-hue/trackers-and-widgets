{
 "id": "383d1f7d-3ac1-53b0-aba7-9fedaa160252",
 "scriptName": "🎲 VLD DICE · ru",
 "findRegex": "/\\[\\[VLD_DICE(?![A-Z0-9_])(?=[^\\]]*\\|\\s*A\\s*=[ \\t]*([^|\\]<]*)|)(?=[^\\]]*\\|\\s*R\\s*=[ \\t]*([0-9]{0,3})|)(?=[^\\]]*\\|\\s*D\\s*=[ \\t]*([0-9]{0,3})|)(?=[^\\]]*\\|\\s*O\\s*=[ \\t]*(crit|pass|edge|fail|fumble)|)(?=[^\\]]*\\|\\s*C\\s*=[ \\t]*([^|\\]<]*)|)[^\\]]*\\]\\]/g",
 "replaceString": "<div class=\"vld-w vld-dice\">\n  <div class=\"throw o-$4\">\n    <div class=\"arena\" data-bounces=\"0\">\n      <span class=\"die-shadow\"></span>\n      <button class=\"die\" type=\"button\" aria-label=\"Бросить снова\">\n        <span class=\"facets\"></span>\n        <b class=\"roll\" data-final=\"$2\">$2</b>\n      </button>\n    </div>\n\n    <div class=\"read\" aria-hidden=\"false\">\n      <div class=\"act\">$1</div>\n\n      <div class=\"verdict\">\n        <span class=\"word\">\n          <span class=\"w-crit\">критический успех</span>\n          <span class=\"w-pass\">успех</span>\n          <span class=\"w-edge\">на волоске</span>\n          <span class=\"w-fail\">провал</span>\n          <span class=\"w-fumble\">катастрофа</span>\n        </span>\n        <span class=\"dc\">нужно <b>$3</b></span>\n      </div>\n\n      <div class=\"cost\">$5</div>\n    </div>\n  </div>\n  <style>\n    /* Единственный виджет в паке, который показывает не состояние, а мгновение:\n       бросок уже случился, и переигрывать его нельзя. Отсюда и подача — кубик\n       прилетает и останавливается, а не наливается плавно, как шкала.\n\n       Все пять исходов написаны в разметке, лишние прячет CSS по классу. Так\n       слово исхода переведено на язык пользователя, а не приезжает от модели\n       английским словом из списка. */\n\n    .vld-dice {\n      --ink: #ece9e3;\n      --dim: #8a8781;\n      --plate: #17181b;\n      --hair: rgba(236, 233, 227, .1);\n\n      --crit: 214, 176, 84;\n      --pass: 124, 176, 108;\n      --edge: 208, 162, 78;\n      --fail: 150, 152, 158;\n      --fumble: 202, 84, 88;\n\n      --mono: ui-monospace, \"Cascadia Mono\", \"Consolas\", \"DejaVu Sans Mono\", monospace;\n\n      width: min(100%, 356px);\n      margin: 14px auto;\n      color: var(--ink);\n      filter: drop-shadow(0 12px 24px rgba(0, 0, 0, .45));\n    }\n\n    .vld-dice * {\n      box-sizing: border-box;\n    }\n\n    .vld-dice .throw {\n      --tone: var(--fail);\n\n      display: grid;\n      grid-template-columns: 86px 1fr;\n      gap: 10px;\n      align-items: center;\n      min-height: 104px;\n      padding: 13px 14px;\n      overflow: hidden;\n      border-radius: 3px;\n      background: var(--plate);\n      box-shadow: inset 0 0 0 1px var(--hair);\n    }\n\n    .vld-dice .o-crit   { --tone: var(--crit); }\n    .vld-dice .o-pass   { --tone: var(--pass); }\n    .vld-dice .o-edge   { --tone: var(--edge); }\n    .vld-dice .o-fail   { --tone: var(--fail); }\n    .vld-dice .o-fumble { --tone: var(--fumble); }\n\n    .vld-dice .arena {\n      position: relative;\n      width: 86px;\n      height: 82px;\n      align-self: center;\n      overflow: visible;\n    }\n\n    .vld-dice .die-shadow {\n      position: absolute;\n      left: 13px;\n      bottom: 2px;\n      width: 60px;\n      height: 13px;\n      border-radius: 50%;\n      pointer-events: none;\n      background: radial-gradient(ellipse, rgba(0, 0, 0, .72), rgba(0, 0, 0, 0) 70%);\n      transform: scale(.82);\n      opacity: .48;\n      filter: blur(2px);\n      will-change: transform, opacity, filter;\n    }\n\n    /* Двадцатигранник остаётся узнаваемым силуэтом, но его положение, поворот,\n       сжатие при ударе и свет на гранях теперь рассчитывает JavaScript. */\n    .vld-dice .die {\n      position: absolute;\n      left: 6px;\n      bottom: 10px;\n      width: 74px;\n      height: 68px;\n      display: grid;\n      place-items: center;\n      margin: 0;\n      padding: 0;\n      border: 0;\n      appearance: none;\n      cursor: pointer;\n      color: inherit;\n      clip-path: polygon(50% 0, 100% 26%, 100% 74%, 50% 100%, 0 74%, 0 26%);\n      background: linear-gradient(160deg, rgba(var(--tone), .3), rgba(var(--tone), .1));\n      box-shadow: inset 0 0 0 1px rgba(var(--tone), .45);\n      transform-origin: 50% 54%;\n      will-change: transform, filter, background;\n    }\n\n    .vld-dice .die:focus-visible {\n      outline: 2px solid rgba(var(--tone), .85);\n      outline-offset: 3px;\n    }\n\n    /* Грани: три линии от вершин к центру превращают шестиугольник в объём. */\n    .vld-dice .facets {\n      position: absolute;\n      inset: 0;\n      background:\n        linear-gradient(150deg, transparent calc(50% - .5px), rgba(255, 255, 255, .12) calc(50% - .5px) calc(50% + .5px), transparent calc(50% + .5px)),\n        linear-gradient(210deg, transparent calc(50% - .5px), rgba(255, 255, 255, .12) calc(50% - .5px) calc(50% + .5px), transparent calc(50% + .5px)),\n        linear-gradient(180deg, transparent 50%, rgba(0, 0, 0, .22));\n      transform: rotate(var(--facet-turn, 0deg)) scale(1.06);\n      transition: opacity .08s linear;\n    }\n\n    .vld-dice .roll {\n      position: relative;\n      font: 600 27px/1 var(--mono);\n      font-variant-numeric: tabular-nums;\n      color: rgb(var(--tone));\n      text-shadow: 0 0 16px rgba(var(--tone), .5);\n    }\n\n    /* Двадцатка светится и держит на себе взгляд — это единственный бросок,\n       который стоит отпраздновать. Единица дрожит. */\n    .vld-dice .o-crit .die {\n      box-shadow: inset 0 0 0 1px rgba(var(--crit), .8), 0 0 26px rgba(var(--crit), .38);\n      animation: vld-dice-glow 2.2s ease-in-out .25s infinite;\n    }\n\n    @keyframes vld-dice-glow {\n      50% { box-shadow: inset 0 0 0 1px rgba(var(--crit), 1), 0 0 40px rgba(var(--crit), .6); }\n    }\n\n    .vld-dice .o-fumble .die {\n      animation: vld-dice-shake 3.3s steps(1, end) .25s infinite;\n    }\n\n    @keyframes vld-dice-shake {\n      0%, 90%   { transform: none; }\n      92%       { transform: translateX(-2px) rotate(-1.5deg); }\n      94%       { transform: translateX(2px) rotate(1.5deg); }\n      96%, 100% { transform: none; }\n    }\n\n    .vld-dice .read {\n      min-width: 0;\n      opacity: 1;\n      transform: none;\n      filter: none;\n      transition:\n        opacity .26s ease,\n        transform .34s cubic-bezier(.2, .85, .25, 1),\n        filter .3s ease;\n    }\n\n    .vld-dice .throw.is-rolling .read {\n      opacity: 0;\n      transform: translateY(5px);\n      filter: blur(5px);\n      pointer-events: none;\n    }\n\n    /* Пока куб летит, критический glow и редкая дрожь единицы ещё не имеют права\n       раскрывать исход. Они включаются только после settle. */\n    .vld-dice .throw.is-rolling .die {\n      animation: none;\n      box-shadow: inset 0 0 0 1px rgba(var(--tone), .45);\n    }\n\n    .vld-dice .act {\n      font: 400 12.5px/1.35 var(--mono);\n      color: var(--ink);\n    }\n\n    .vld-dice .verdict {\n      display: flex;\n      align-items: baseline;\n      gap: 9px;\n      margin-top: 7px;\n    }\n\n    .vld-dice .word {\n      font: 600 11px/1 var(--mono);\n      text-transform: uppercase;\n      letter-spacing: .13em;\n      color: rgb(var(--tone));\n    }\n\n    /* Пять слов лежат в разметке, показывается одно. Модель прислала не то —\n       не показывается ни одного, и виджет молчит вместо того, чтобы врать. */\n    .vld-dice .word span {\n      display: none;\n    }\n\n    .vld-dice .o-crit   .w-crit,\n    .vld-dice .o-pass   .w-pass,\n    .vld-dice .o-edge   .w-edge,\n    .vld-dice .o-fail   .w-fail,\n    .vld-dice .o-fumble .w-fumble {\n      display: inline;\n    }\n\n    .vld-dice .dc {\n      font: 400 10px/1 var(--mono);\n      letter-spacing: .06em;\n      color: var(--dim);\n    }\n\n    .vld-dice .dc b {\n      font-weight: 600;\n      color: rgba(236, 233, 227, .75);\n    }\n\n    .vld-dice .cost {\n      margin-top: 6px;\n      padding-top: 6px;\n      border-top: 1px solid var(--hair);\n      font: 400 11.5px/1.4 var(--mono);\n      color: var(--dim);\n    }\n\n    /* Порога нет — не показывать «нужно» без числа. */\n    .vld-dice .dc:has(b:empty),\n    .vld-dice .cost:empty {\n      display: none;\n    }\n\n    /* Без броска и без действия показывать нечего. */\n    .vld-dice .throw:has(.roll:empty),\n    .vld-dice .throw:has(.act:empty) {\n      display: none;\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      .vld-dice .die,\n      .vld-dice .o-crit .die,\n      .vld-dice .o-fumble .die {\n        animation: none;\n        transition: none;\n      }\n\n      .vld-dice .read {\n        transition: none;\n      }\n    }\n  </style>\n  <script>\n    (function () {\n      var root = (document.currentScript && document.currentScript.parentElement)\n        || document.querySelector('.vld-dice:not([data-vld-init])');\n      if (!root || root.dataset.vldInit === '1') return;\n      root.dataset.vldInit = '1';\n      var throwEl = root.querySelector('.throw');\n      var arena = root.querySelector('.arena');\n      var die = root.querySelector('.die');\n      var shadow = root.querySelector('.die-shadow');\n      var facets = root.querySelector('.facets');\n      var roll = root.querySelector('.roll');\n      var read = root.querySelector('.read');\n      var finalResult = parseInt(roll.dataset.final, 10);\n      var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n      var frameId = 0;\n      var runId = 0;\n\n      if (!isNaN(finalResult)) {\n        if (reduced) {\n          settle();\n        } else {\n          runThrow();\n          die.addEventListener('click', function (event) {\n            event.preventDefault();\n            runThrow();\n          });\n        }\n      }\n\n      /**\n       * Physics is transient presentation only. The model has already rolled and put\n       * the immutable result in data-final; every replay changes the path, never it.\n       */\n      function runThrow() {\n        if (frameId) cancelAnimationFrame(frameId);\n\n        runId += 1;\n        root.dataset.diceRun = String(runId);\n        arena.dataset.bounces = '0';\n        throwEl.classList.add('is-rolling');\n        throwEl.classList.remove('is-settled');\n        read.setAttribute('aria-hidden', 'true');\n\n        var x = 165 + Math.random() * 28;\n        var y = -58 - Math.random() * 18;\n        var vx = -278 - Math.random() * 34;\n        var vy = -58 - Math.random() * 42;\n        var angle = -130 + Math.random() * 260;\n        var spin = (Math.random() < .5 ? -1 : 1) * (760 + Math.random() * 310);\n        var gravity = 1120;\n        var bounces = 0;\n        var grounded = false;\n        var started = 0;\n        var previous = 0;\n        var lastFaceAt = 0;\n        var impactAt = -1000;\n\n        showFalseFace();\n        paint(x, y, angle, 0, impactAt);\n        frameId = requestAnimationFrame(step);\n\n        function step(now) {\n          if (!started) {\n            started = now;\n            previous = now;\n          }\n\n          var dt = Math.min(.032, Math.max(.001, (now - previous) / 1000));\n          var elapsed = (now - started) / 1000;\n          previous = now;\n\n          if (!grounded) {\n            vy += gravity * dt;\n            x += vx * dt;\n            y += vy * dt;\n            angle += spin * dt;\n\n            if (y >= 0 && vy > 0) {\n              y = 0;\n              bounces += 1;\n              arena.dataset.bounces = String(bounces);\n              impactAt = now;\n\n              if (bounces === 1) {\n                vy = -vy * .42;\n                vx *= .69;\n                spin *= .72;\n              } else {\n                vy = 0;\n                grounded = true;\n              }\n            }\n          } else {\n            var settleRate = Math.min(1, dt * 9);\n            x += (0 - x) * settleRate;\n            angle += spin * dt;\n            spin *= Math.exp(-8 * dt);\n          }\n\n          if (now - lastFaceAt > 58 && !grounded) {\n            showFalseFace();\n            lastFaceAt = now;\n          }\n\n          paint(x, y, angle, elapsed, impactAt);\n\n          if (grounded && elapsed > 1.02 && Math.abs(x) < 1.2 && Math.abs(spin) < 16) {\n            settle();\n            return;\n          }\n\n          // A throttled background tab must not leave the result hidden forever.\n          if (elapsed > 1.45) {\n            settle();\n            return;\n          }\n\n          frameId = requestAnimationFrame(step);\n        }\n      }\n\n      function paint(x, y, angle, elapsed, impactAt) {\n        var now = performance.now();\n        var impact = Math.max(0, 1 - (now - impactAt) / 105);\n        var sx = 1 + impact * .17;\n        var sy = 1 - impact * .14;\n        var altitude = Math.min(1, Math.abs(Math.min(0, y)) / 88);\n        var light = 1 + Math.sin(angle * Math.PI / 180) * .14;\n\n        die.style.transform =\n          'translate3d(' + x.toFixed(2) + 'px,' + y.toFixed(2) + 'px,0)' +\n          ' rotate(' + angle.toFixed(2) + 'deg)' +\n          ' scale(' + sx.toFixed(3) + ',' + sy.toFixed(3) + ')';\n        die.style.filter = 'brightness(' + light.toFixed(3) + ')';\n        facets.style.setProperty('--facet-turn', (-angle * .34).toFixed(2) + 'deg');\n        facets.style.opacity = String(.7 + Math.cos(angle * Math.PI / 90) * .22);\n\n        shadow.style.transform =\n          'translateX(' + x.toFixed(2) + 'px)' +\n          ' scale(' + (.96 - altitude * .47).toFixed(3) + ',' +\n          (.78 - altitude * .25).toFixed(3) + ')';\n        shadow.style.opacity = String(.17 + (1 - altitude) * .36);\n        shadow.style.filter = 'blur(' + (2 + altitude * 7).toFixed(2) + 'px)';\n      }\n\n      function showFalseFace() {\n        var current = parseInt(roll.textContent, 10);\n        var next;\n\n        do {\n          next = 1 + Math.floor(Math.random() * 20);\n        } while (next === finalResult || next === current);\n\n        roll.textContent = String(next);\n      }\n\n      function settle() {\n        if (frameId) cancelAnimationFrame(frameId);\n        frameId = 0;\n\n        roll.textContent = String(finalResult);\n        die.style.transform = '';\n        die.style.filter = '';\n        facets.style.removeProperty('--facet-turn');\n        facets.style.opacity = '';\n        shadow.style.transform = '';\n        shadow.style.opacity = '';\n        shadow.style.filter = '';\n\n        throwEl.classList.remove('is-rolling');\n        throwEl.classList.add('is-settled');\n        read.setAttribute('aria-hidden', 'false');\n      }\n    })();\n  </script>\n</div>",
