{
 "id": "383d1f7d-3ac1-53b0-aba7-9fedaa160252",
 "scriptName": "🎲 VLD DICE · ru",
 "findRegex": "/\\[\\[VLD_DICE(?![A-Z0-9_])(?=[^\\]]*\\|\\s*A\\s*=[ \\t]*([^|\\]<]*)|)(?=[^\\]]*\\|\\s*R\\s*=[ \\t]*([0-9]{0,3})|)(?=[^\\]]*\\|\\s*D\\s*=[ \\t]*([0-9]{0,3})|)(?=[^\\]]*\\|\\s*O\\s*=[ \\t]*(crit|pass|edge|fail|fumble)|)(?=[^\\]]*\\|\\s*C\\s*=[ \\t]*([^|\\]<]*)|)[^\\]]*\\]\\]/g",
 "replaceString": "<div class=\"vld-w vld-dice\">\n  <div class=\"throw o-$4\">\n    <div class=\"arena\" data-bounces=\"0\">\n      <span class=\"die-shadow\"></span>\n      <button class=\"die\" type=\"button\" aria-label=\"Бросить снова\">\n        <span class=\"facets\"></span>\n        <b class=\"roll\" data-final=\"$2\">$2</b>\n      </button>\n    </div>\n\n    <div class=\"read\" aria-hidden=\"false\">\n      <div class=\"act\">$1</div>\n\n      <div class=\"verdict\">\n        <span class=\"word\">\n          <span class=\"w-crit\">критический успех</span>\n          <span class=\"w-pass\">успех</span>\n          <span class=\"w-edge\">на волоске</span>\n          <span class=\"w-fail\">провал</span>\n          <span class=\"w-fumble\">катастрофа</span>\n        </span>\n        <span class=\"dc\">нужно <b>$3</b></span>\n      </div>\n\n      <div class=\"cost\">$5</div>\n    </div>\n  </div>\n  <style>\n    /* Единственный виджет в паке, который показывает не состояние, а мгновение:\n       бросок уже случился, и переигрывать его нельзя. Отсюда и подача — кубик\n       прилетает и останавливается, а не наливается плавно, как шкала.\n\n       Все пять исходов написаны в разметке, лишние прячет CSS по классу. Так\n       слово исхода переведено на язык пользователя, а не приезжает от модели\n       английским словом из списка. */\n\n    .vld-dice {\n      --ink: #ece9e3;\n      --dim: #8a8781;\n      --plate: #17181b;\n      --hair: rgba(236, 233, 227, .1);\n\n      --crit: 214, 176, 84;\n      --pass: 124, 176, 108;\n      --edge: 208, 162, 78;\n      --fail: 150, 152, 158;\n      --fumble: 202, 84, 88;\n\n      --mono: ui-monospace, \"Cascadia Mono\", \"Consolas\", \"DejaVu Sans Mono\", monospace;\n\n      width: min(100%, 356px);\n      margin: 14px auto;\n      color: var(--ink);\n      filter: drop-shadow(0 12px 24px rgba(0, 0, 0, .45));\n    }\n\n    .vld-dice * {\n      box-sizing: border-box;\n    }\n\n    .vld-dice .throw {\n      --tone: var(--fail);\n\n      display: grid;\n      grid-template-columns: 86px 1fr;\n      gap: 10px;\n      align-items: center;\n      min-height: 104px;\n      padding: 13px 14px;\n      overflow: hidden;\n      border-radius: 3px;\n      background: var(--plate);\n      box-shadow: inset 0 0 0 1px var(--hair);\n    }\n\n    .vld-dice .o-crit   { --tone: var(--crit); }\n    .vld-dice .o-pass   { --tone: var(--pass); }\n    .vld-dice .o-edge   { --tone: var(--edge); }\n    .vld-dice .o-fail   { --tone: var(--fail); }\n    .vld-dice .o-fumble { --tone: var(--fumble); }\n\n    .vld-dice .arena {\n      position: relative;\n      width: 86px;\n      height: 82px;\n      align-self: center;\n      overflow: visible;\n    }\n\n    .vld-dice .die-shadow {\n      position: absolute;\n      left: 13px;\n      bottom: 2px;\n      width: 60px;\n      height: 13px;\n      border-radius: 50%;\n      pointer-events: none;\n      background: radial-gradient(ellipse, rgba(0, 0, 0, .72), rgba(0, 0, 0, 0) 70%);\n      transform: scale(.82);\n      opacity: .48;\n      filter: blur(2px);\n      will-change: transform, opacity, filter;\n    }\n\n    /* Двадцатигранник остаётся узнаваемым силуэтом, но его положение, поворот,\n       сжатие при ударе и свет на гранях теперь рассчитывает JavaScript. */\n    .vld-dice .die {\n      position: absolute;\n      left: 6px;\n      bottom: 10px;\n      width: 74px;\n      height: 68px;\n      display: grid;\n      place-items: center;\n      margin: 0;\n      padding: 0;\n      border: 0;\n      appearance: none;\n      cursor: pointer;\n      color: inherit;\n      clip-path: polygon(50% 0, 100% 26%, 100% 74%, 50% 100%, 0 74%, 0 26%);\n      background: linear-gradient(160deg, rgba(var(--tone), .3), rgba(var(--tone), .1));\n      box-shadow: inset 0 0 0 1px rgba(var(--tone), .45);\n      transform-origin: 50% 54%;\n      will-change: transform, filter, background;\n    }\n\n    .vld-dice .die:focus-visible {\n      outline: 2px solid rgba(var(--tone), .85);\n      outline-offset: 3px;\n    }\n\n    /* Грани: три линии от вершин к центру превращают шестиугольник в объём. */\n    .vld-dice .facets {\n      position: absolute;\n      inset: 0;\n      background:\n        linear-gradient(150deg, transparent calc(50% - .5px), rgba(255, 255, 255, .12) calc(50% - .5px) calc(50% + .5px), transparent calc(50% + .5px)),\n        linear-gradient(210deg, transparent calc(50% - .5px), rgba(255, 255, 255, .12) calc(50% - .5px) calc(50% + .5px), transparent calc(50% + .5px)),\n        linear-gradient(180deg, transparent 50%, rgba(0, 0, 0, .22));\n      transform: rotate(var(--facet-turn, 0deg)) scale(1.06);\n      transition: opacity .08s linear;\n    }\n\n    .vld-dice .roll {\n      position: relative;\n      font: 600 27px/1 var(--mono);\n      font-variant-numeric: tabular-nums;\n      color: rgb(var(--tone));\n      text-shadow: 0 0 16px rgba(var(--tone), .5);\n    }\n\n    /* Двадцатка светится и держит на себе взгляд — это единственный бросок,\n       который стоит отпраздновать. Единица дрожит. */\n    .vld-dice .o-crit .die {\n      box-shadow: inset 0 0 0 1px rgba(var(--crit), .8), 0 0 26px rgba(var(--crit), .38);\n      animation: vld-dice-glow 2.2s ease-in-out .25s infinite;\n    }\n\n    @keyframes vld-dice-glow {\n      50% { box-shadow: inset 0 0 0 1px rgba(var(--crit), 1), 0 0 40px rgba(var(--crit), .6); }\n    }\n\n    .vld-dice .o-fumble .die {\n      animation: vld-dice-shake 3.3s steps(1, end) .25s infinite;\n    }\n\n    @keyframes vld-dice-shake {\n      0%, 90%   { transform: none; }\n      92%       { transform: translateX(-2px) rotate(-1.5deg); }\n      94%       { transform: translateX(2px) rotate(1.5deg); }\n      96%, 100% { transform: none; }\n    }\n\n    .vld-dice .read {\n      min-width: 0;\n      opacity: 1;\n      transform: none;\n      filter: none;\n    }\n\n    .vld-dice .verdict,\n    .vld-dice .cost {\n      transition:\n        opacity .26s ease,\n        transform .34s cubic-bezier(.2, .85, .25, 1),\n        filter .3s ease;\n    }\n\n    .vld-dice .throw.is-rolling:not(.is-revealing) .verdict,\n    .vld-dice .throw.is-rolling:not(.is-revealing) .cost {\n      opacity: 0;\n      transform: translateY(5px);\n      filter: blur(5px);\n      pointer-events: none;\n    }\n\n    /* Пока куб летит, критический glow и редкая дрожь единицы ещё не имеют права\n       раскрывать исход. Они включаются только после settle. */\n    .vld-dice .throw.is-rolling .die {\n      animation: none;\n      box-shadow: inset 0 0 0 1px rgba(var(--tone), .45);\n    }\n\n    .vld-dice .act {\n      font: 400 12.5px/1.35 var(--mono);\n      color: var(--ink);\n    }\n\n    .vld-dice .verdict {\n      display: flex;\n      align-items: baseline;\n      gap: 9px;\n      margin-top: 7px;\n    }\n\n    .vld-dice .word {\n      font: 600 11px/1 var(--mono);\n      text-transform: uppercase;\n      letter-spacing: .13em;\n      color: rgb(var(--tone));\n    }\n\n    /* Пять слов лежат в разметке, показывается одно. Модель прислала не то —\n       не показывается ни одного, и виджет молчит вместо того, чтобы врать. */\n    .vld-dice .word span {\n      display: none;\n    }\n\n    .vld-dice .o-crit   .w-crit,\n    .vld-dice .o-pass   .w-pass,\n    .vld-dice .o-edge   .w-edge,\n    .vld-dice .o-fail   .w-fail,\n    .vld-dice .o-fumble .w-fumble {\n      display: inline;\n    }\n\n    .vld-dice .dc {\n      font: 400 10px/1 var(--mono);\n      letter-spacing: .06em;\n      color: var(--dim);\n    }\n\n    .vld-dice .dc b {\n      font-weight: 600;\n      color: rgba(236, 233, 227, .75);\n    }\n\n    .vld-dice .cost {\n      margin-top: 6px;\n      padding-top: 6px;\n      border-top: 1px solid var(--hair);\n      font: 400 11.5px/1.4 var(--mono);\n      color: var(--dim);\n    }\n\n    /* Порога нет — не показывать «нужно» без числа. */\n    .vld-dice .dc:has(b:empty),\n    .vld-dice .cost:empty {\n      display: none;\n    }\n\n    /* Без броска и без действия показывать нечего. */\n    .vld-dice .throw:has(.roll:empty),\n    .vld-dice .throw:has(.act:empty) {\n      display: none;\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      .vld-dice .die,\n      .vld-dice .o-crit .die,\n      .vld-dice .o-fumble .die {\n        animation: none;\n        transition: none;\n      }\n\n      .vld-dice .verdict,\n      .vld-dice .cost {\n        transition: none;\n      }\n    }\n  </style>\n  <script>\n    (function () {\n      var root = (document.currentScript && document.currentScript.parentElement)\n        || document.querySelector('.vld-dice:not([data-vld-init])');\n      if (!root || root.dataset.vldInit === '1') return;\n      root.dataset.vldInit = '1';\n      var throwEl = root.querySelector('.throw');\n      var arena = root.querySelector('.arena');\n      var die = root.querySelector('.die');\n      var shadow = root.querySelector('.die-shadow');\n      var facets = root.querySelector('.facets');\n      var roll = root.querySelector('.roll');\n      var verdict = root.querySelector('.verdict');\n      var cost = root.querySelector('.cost');\n      var finalResult = parseInt(roll.dataset.final, 10);\n      var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n\n      var FIRST_IMPACT = 390;\n      var SECOND_IMPACT = 790;\n      var DURATION = 1080;\n      var frameId = 0;\n      var runId = 0;\n      var startedAt = 0;\n      var timeline = null;\n\n      if (!isNaN(finalResult)) {\n        if (reduced) {\n          settle();\n        } else {\n          runThrow();\n          die.addEventListener('click', function (event) {\n            event.preventDefault();\n            runThrow();\n          });\n        }\n      }\n\n      /**\n       * Recording uses the same clock as the live widget. In SillyTavern nobody calls\n       * this method; record.mjs uses it to seek the physics instead of hoping that a\n       * real-time requestAnimationFrame happens between two screenshots.\n       */\n      root.vldDiceSeek = function (ms) {\n        if (!timeline || reduced) return;\n        if (frameId) cancelAnimationFrame(frameId);\n        frameId = 0;\n        renderAt(Math.max(0, Number(ms) || 0));\n      };\n\n      root.vldDiceReplay = runThrow;\n\n      /**\n       * The result is immutable. A replay generates a new visual trajectory, while\n       * data-final — the model's roll — stays untouched.\n       */\n      function runThrow() {\n        if (reduced || isNaN(finalResult)) return;\n        if (frameId) cancelAnimationFrame(frameId);\n\n        runId += 1;\n        root.dataset.diceRun = String(runId);\n        timeline = makeTimeline();\n        startedAt = performance.now();\n        prepare();\n        renderAt(0);\n        frameId = requestAnimationFrame(step);\n      }\n\n      function step(now) {\n        if (!root.isConnected) {\n          frameId = 0;\n          return;\n        }\n\n        var elapsed = now - startedAt;\n        renderAt(elapsed);\n\n        if (elapsed < DURATION) {\n          frameId = requestAnimationFrame(step);\n        } else {\n          frameId = 0;\n        }\n      }\n\n      function makeTimeline() {\n        var direction = Math.random() < .5 ? -1 : 1;\n        var turns = 2 + Math.floor(Math.random() * 2);\n\n        return {\n          direction: direction,\n          startAngle: direction * (55 + Math.random() * 90),\n          endAngle: direction * turns * 360,\n          sway: 5 + Math.random() * 4,\n          seed: Math.floor(Math.random() * 997),\n        };\n      }\n\n      function prepare() {\n        arena.dataset.bounces = '0';\n        throwEl.classList.add('is-rolling');\n        throwEl.classList.remove('is-revealing', 'is-settled');\n        verdict.setAttribute('aria-hidden', 'true');\n        cost.setAttribute('aria-hidden', 'true');\n      }\n\n      function renderAt(ms) {\n        var t = Math.min(ms, DURATION);\n        var x;\n        var y;\n\n        if (t < FIRST_IMPACT) {\n          var fall = t / FIRST_IMPACT;\n          // The die is already inside its slot: it falls a short distance while\n          // tumbling, rather than crossing the entire card from off-screen.\n          x = Math.sin(fall * Math.PI * 2 + .5) * timeline.sway * (1 - fall * .35);\n          y = -24 * (1 - fall * fall);\n          arena.dataset.bounces = '0';\n        } else if (t < SECOND_IMPACT) {\n          var hop = (t - FIRST_IMPACT) / (SECOND_IMPACT - FIRST_IMPACT);\n          x = Math.sin(hop * Math.PI * 2) * timeline.sway * .48 * (1 - hop);\n          y = -Math.sin(hop * Math.PI) * 12;\n          arena.dataset.bounces = '1';\n        } else {\n          var rest = (t - SECOND_IMPACT) / (DURATION - SECOND_IMPACT);\n          x = Math.sin(rest * Math.PI * 4) * 2.4 * (1 - rest);\n          y = 0;\n          arena.dataset.bounces = '2';\n        }\n\n        var spinProgress = Math.min(1, t / SECOND_IMPACT);\n        var easedSpin = 1 - Math.pow(1 - spinProgress, 3);\n        var angle = timeline.startAngle +\n          (timeline.endAngle - timeline.startAngle) * easedSpin;\n\n        if (t >= SECOND_IMPACT) {\n          var settleProgress = (t - SECOND_IMPACT) / (DURATION - SECOND_IMPACT);\n          angle += Math.sin(settleProgress * Math.PI * 5) * 7 * (1 - settleProgress);\n        }\n\n        var impact = Math.max(\n          impactPulse(t, FIRST_IMPACT),\n          impactPulse(t, SECOND_IMPACT),\n        );\n\n        paint(x, y, angle, impact);\n\n        if (t < SECOND_IMPACT) {\n          showFalseFace(Math.floor(t / 58));\n        } else {\n          roll.textContent = String(finalResult);\n          throwEl.classList.add('is-revealing');\n          verdict.setAttribute('aria-hidden', 'false');\n          cost.setAttribute('aria-hidden', 'false');\n        }\n\n        if (t >= DURATION) settle();\n      }\n\n      function impactPulse(ms, at) {\n        if (ms < at || ms > at + 105) return 0;\n        return 1 - (ms - at) / 105;\n      }\n\n      function paint(x, y, angle, impact) {\n        var sx = 1 + impact * .17;\n        var sy = 1 - impact * .14;\n        var altitude = Math.min(1, Math.abs(Math.min(0, y)) / 26);\n        var light = 1 + Math.sin(angle * Math.PI / 180) * .14;\n\n        die.style.transform =\n          'translate3d(' + x.toFixed(2) + 'px,' + y.toFixed(2) + 'px,0)' +\n          ' rotate(' + angle.toFixed(2) + 'deg)' +\n          ' scale(' + sx.toFixed(3) + ',' + sy.toFixed(3) + ')';\n        die.style.filter = 'brightness(' + light.toFixed(3) + ')';\n        facets.style.setProperty('--facet-turn', (-angle * .34).toFixed(2) + 'deg');\n        facets.style.opacity = String(.7 + Math.cos(angle * Math.PI / 90) * .22);\n\n        shadow.style.transform =\n          'translateX(' + x.toFixed(2) + 'px)' +\n          ' scale(' + (.96 - altitude * .42).toFixed(3) + ',' +\n          (.78 - altitude * .22).toFixed(3) + ')';\n        shadow.style.opacity = String(.18 + (1 - altitude) * .35);\n        shadow.style.filter = 'blur(' + (2 + altitude * 5).toFixed(2) + 'px)';\n      }\n\n      function showFalseFace(index) {\n        var next = ((index * 7 + timeline.seed) % 20) + 1;\n        if (next === finalResult) next = (next % 20) + 1;\n        roll.textContent = String(next);\n      }\n\n      function settle() {\n        if (frameId) cancelAnimationFrame(frameId);\n        frameId = 0;\n\n        roll.textContent = String(finalResult);\n        die.style.transform = '';\n        die.style.filter = '';\n        facets.style.removeProperty('--facet-turn');\n        facets.style.opacity = '';\n        shadow.style.transform = '';\n        shadow.style.opacity = '';\n        shadow.style.filter = '';\n\n        throwEl.classList.remove('is-rolling', 'is-revealing');\n        throwEl.classList.add('is-settled');\n        arena.dataset.bounces = '2';\n        verdict.setAttribute('aria-hidden', 'false');\n        cost.setAttribute('aria-hidden', 'false');\n      }\n    })();\n  </script>\n</div>",
