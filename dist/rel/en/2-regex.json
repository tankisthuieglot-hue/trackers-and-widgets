 "replaceString": "<div class=\"vld-w vld-rel\">\n  <article class=\"card\">\n    <div class=\"aura\" aria-hidden=\"true\"><i></i><i></i></div>\n    <div class=\"frost\" aria-hidden=\"true\"><i></i><i></i><i></i></div>\n\n    <div class=\"comment\"><span>$2</span><i aria-hidden=\"true\"></i></div>\n\n    <header>\n      <span class=\"sigil\" aria-hidden=\"true\">\n        <i class=\"orbit o1\"></i>\n        <i class=\"orbit o2\"></i>\n        <i class=\"orbit o3\"></i>\n        <b class=\"monogram\"></b>\n      </span>\n      <div class=\"identity\">\n        <h3>$1</h3>\n        <p>$3</p>\n      </div>\n      <span class=\"heart\" aria-hidden=\"true\">♥</span>\n    </header>\n\n    <div class=\"signals\">\n      <div class=\"signal e-$5\" data-value=\"$6\">\n        <div class=\"signal-head\"><span class=\"label\"></span><b><span class=\"value\">0</span><small>%</small></b></div>\n        <div class=\"track\"><i></i><em></em></div>\n      </div>\n      <div class=\"signal e-$7\" data-value=\"$8\">\n        <div class=\"signal-head\"><span class=\"label\"></span><b><span class=\"value\">0</span><small>%</small></b></div>\n        <div class=\"track\"><i></i><em></em></div>\n      </div>\n      <div class=\"signal e-$9\" data-value=\"$10\">\n        <div class=\"signal-head\"><span class=\"label\"></span><b><span class=\"value\">0</span><small>%</small></b></div>\n        <div class=\"track\"><i></i><em></em></div>\n      </div>\n    </div>\n\n    <div class=\"clothes\">\n      <span>wearing</span>\n      <b class=\"value\">$4</b>\n    </div>\n\n    <div class=\"dictionary\" hidden>\n      <i data-kind=\"friendship\">friendship</i>\n      <i data-kind=\"love\">love</i>\n      <i data-kind=\"trust\">trust</i>\n      <i data-kind=\"respect\">respect</i>\n      <i data-kind=\"interest\">interest</i>\n      <i data-kind=\"fear\">fear</i>\n      <i data-kind=\"jealousy\">jealousy</i>\n      <i data-kind=\"hostility\">hostility</i>\n    </div>\n  </article>\n  <style>\n    .vld-rel {\n      --paper: #f2ebf0;\n      --muted: #a99ca7;\n      --plate: 25, 19, 28;\n      --dominant: 167, 157, 165;\n      --orbit-1: var(--dominant);\n      --orbit-2: var(--dominant);\n      --orbit-3: var(--dominant);\n      --serif: Georgia, \"Times New Roman\", serif;\n      --mono: ui-monospace, \"Cascadia Mono\", \"Consolas\", monospace;\n      width: min(100%, 360px);\n      margin: 14px auto;\n      color: var(--paper);\n      filter: drop-shadow(0 18px 32px rgba(0, 0, 0, .5));\n    }\n\n    .vld-rel * { box-sizing: border-box; }\n\n    .vld-rel.deck-member { display: none !important; }\n\n    .vld-rel .deck-tabs {\n      position: relative;\n      z-index: 4;\n      display: flex;\n      gap: 5px;\n      overflow-x: auto;\n      margin: 0 8px -1px;\n      padding: 0 4px;\n      scrollbar-width: none;\n    }\n\n    .vld-rel .deck-tabs::-webkit-scrollbar { display: none; }\n    .vld-rel .deck-tabs[hidden] { display: none; }\n\n    .vld-rel .deck-tab {\n      --tab-tone: 167, 157, 165;\n      flex: 0 0 auto;\n      max-width: 145px;\n      overflow: hidden;\n      padding: 7px 11px 6px;\n      border: 1px solid rgba(var(--tab-tone), .24);\n      border-bottom: 0;\n      border-radius: 10px 3px 0 0;\n      background: rgba(21, 16, 23, .78);\n      font: 600 9px/1 var(--mono);\n      color: rgba(var(--tab-tone), .62);\n      text-overflow: ellipsis;\n      white-space: nowrap;\n      cursor: pointer;\n    }\n\n    .vld-rel .deck-tab[aria-selected=\"true\"] {\n      background:\n        radial-gradient(circle at 50% 120%, rgba(var(--tab-tone), .2), transparent 62%),\n        rgb(29, 22, 31);\n      color: rgb(var(--tab-tone));\n      box-shadow: 0 -4px 14px rgba(var(--tab-tone), .12);\n    }\n\n    .vld-rel .deck-tab:focus-visible {\n      outline: 2px solid rgb(var(--tab-tone));\n      outline-offset: 1px;\n    }\n\n    .vld-rel .card {\n      position: relative;\n      overflow: hidden;\n      padding: 13px 15px 14px;\n      border: 1px solid rgba(var(