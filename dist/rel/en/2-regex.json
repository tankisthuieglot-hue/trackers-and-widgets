-height: 17px;\n      margin: 0 38px 10px 0;\n      font: italic 500 12px/1.35 var(--serif);\n      color: rgba(var(--dominant), .92);\n      text-shadow: 0 0 13px rgba(var(--dominant), .2);\n    }\n\n    .vld-rel .comment > i {\n      display: inline-block;\n      width: 1px;\n      height: .9em;\n      margin-left: 3px;\n      background: rgb(var(--dominant));\n      vertical-align: -.08em;\n      animation: vld-rel-caret .72s steps(1, end) infinite;\n    }\n\n    .vld-rel .card.is-settled .comment > i { display: none; }\n    @keyframes vld-rel-caret { 50% { opacity: 0; } }\n\n    .vld-rel header {\n      position: relative;\n      z-index: 2;\n      display: grid;\n      grid-template-columns: 50px minmax(0, 1fr);\n      gap: 11px;\n      align-items: center;\n      min-height: 50px;\n      padding-bottom: 12px;\n      border-bottom: 1px solid rgba(var(--dominant), .16);\n    }\n\n    .vld-rel .sigil {\n      position: relative;\n      display: grid;\n      width: 50px;\n      height: 50px;\n      place-items: center;\n    }\n\n    .vld-rel .orbit {\n      position: absolute;\n      border: 1px solid transparent;\n      border-radius: 50%;\n    }\n\n    .vld-rel .o1 {\n      inset: 0;\n      border-top-color: rgb(var(--orbit-1));\n      border-left-color: rgba(var(--orbit-1), .28);\n      animation: vld-rel-orbit 5.4s linear infinite;\n    }\n\n    .vld-rel .o2 {\n      inset: 4px;\n      border-right-color: rgb(var(--orbit-2));\n      border-bottom-color: rgba(var(--orbit-2), .28);\n      animation: vld-rel-orbit 4.2s linear reverse infinite;\n    }\n\n    .vld-rel .o3 {\n      inset: 8px;\n      border-top-color: rgba(var(--orbit-3), .8);\n      border-right-color: rgba(var(--orbit-3), .28);\n      animation: vld-rel-orbit 6.2s linear infinite;\n    }\n\n    @keyframes vld-rel-orbit { to { transform: rotate(1turn); } }\n\n    .vld-rel .monogram {\n      display: grid;\n      width: 31px;\n      height: 31px;\n      place-items: center;\n      border: 1px solid rgba(var(--dominant), .24);\n      border-radius: 50%;\n      background:\n        radial-gradient(circle at 35% 25%, rgba(255, 255, 255, .12), transparent 35%),\n        rgba(22, 17, 24, .88);\n      box-shadow: 0 0 18px rgba(var(--dominant), .13);\n      font: 600 15px/1 var(--serif);\n      color: rgb(var(--dominant));\n    }\n\n    .vld-rel .identity { min-width: 0; }\n\n    .vld-rel h3 {\n      overflow: hidden;\n      margin: 0;\n      font: 600 19px/1.05 var(--serif);\n      letter-spacing: .01em;\n      color: rgb(var(--dominant));\n      text-overflow: ellipsis;\n      text-shadow: 0 0 18px rgba(var(--dominant), .24);\n      white-space: nowrap;\n    }\n\n    .vld-rel .identity p {\n      overflow: hidden;\n      margin: 5px 0 0;\n      font: 500 9px/1.1 var(--mono);\n      text-transform: uppercase;\n      letter-spacing: .12em;\n      color: var(--muted);\n      text-overflow: ellipsis;\n      white-space: nowrap;\n    }\n\n    .vld-rel .heart {\n      position: absolute;\n      top: -38px;\n      right: 0;\n      display: none;\n      width: 36px;\n      height: 36px;\n      place-items: center;\n      font: 700 24px/1 var(--serif);\n      color: #e14c67;\n      text-shadow: 0 0 16px rgba(225, 76, 103, .75);\n      transform-origin: 50% 62%;\n    }\n\n    .vld-rel .heart.is-visible { display: grid; }\n    .vld-rel .heart.band-low {\n      opacity: .55;\n      color: transparent;\n      -webkit-text-stroke: 1px #bf6876;\n      text-shadow: none;\n    }\n    .vld-rel .heart.band-high,\n    .vld-rel .heart.band-peak { animation: vld-rel-heart 1.1s ease-in-out infinite; }\n    .vld-rel .heart.band-peak { filter: drop-shadow(0 0 7px rgba(244, 93, 120, .62)); }\n\n    @keyframes vld-rel-heart {\n      8%, 22% { transform: scale(1.17); }\n      15%, 30%, 100% { transform: scale(1); }\n    }\n\n    .vld-rel .signals {\n      position: relative;\n      z-index: 2;\n      display: grid;\n      gap: 9px;\n      padding: 12px 0 11px;\n    }\n\n    .vld-rel .signal {\n      --tone: 167, 157, 165;\n      --shown: 0%;\n      position: relative;\n    }\n\n    .vld-rel .signal-head {\n      display: flex;\n      align-items: baseline;\n      justify-content: space-between;\n      gap: 10px;\n      margin-bottom: 5px;\n    }\n\n    .vld-rel .label {\n      font: 600 9px/1 var(--mono);\n      text-transform: uppercase;\n      letter-spacing: .12em;\n      color: rgb(var(--tone));\n    }\n\n    .vld-rel .signal-head b {\n      font: 600 10px/1 var(--mono);\n      font-variant-numeric: tabular-nums;\n      color: rgb(var(--tone));\n    }\n\n    .vld-rel .signal-head small { margin-left: 1px; font: inherit; opacity: .62; }\n\n    .vld-rel .track {\n      position: relative;\n      overflow: hidden;\n      height: 6px;\n      border-radius: 6px;\n      background: rgba(242, 235, 240, .065);\n      box-shadow: inset 0 0 0 1px rgba(242, 235, 240, .06);\n    }\n\n    .vld-rel .track i {\n      position: absolute;\n      inset: 0 auto 0 0;\n      width: var(--shown);\n      border-radius: inherit;\n      background: linear-gradient(90deg, rgba(var(--tone), .35), rgb(var(--tone)));\n      box-shadow: 0 0 11px rgba(var(--tone), .38);\n    }\n\n    .vld-rel .track em {\n      position: absolute;\n      top: 50%;\n      left: var(--shown);\n      width: 9px;\n      height: 9px;\n      border: 2px solid rgb(var(--plate));\n      border-radius: 50%;\n      background: rgb(var(--tone));\n      box-shadow: 0 0 8px rgba(var(--tone), .78);\n      transform: translate(-50%, -50%);\n    }\n\n    .vld-rel .e-friendship { --tone: 86, 190, 133; }\n    .vld-rel .e-love { --tone: 225, 76, 103; }\n    .vld-rel .e-trust { --tone: 101, 178, 212; }\n    .vld-rel .e-respect { --tone: 210, 164, 90; }\n    .vld-rel .e-interest { --tone: 164, 118, 216; }\n    .vld-rel .e-fear { --tone: 157, 216, 231; }\n    .vld-rel .e-jealousy { --tone: 157, 195, 68; }\n    .vld-rel .e-hostility { --tone: 220, 93, 62; }\n\n    .vld-rel .e-friendship.band-low { animation: vld-rel-friend-breathe 2.7s ease-in-out infinite; }\n    @keyframes vld-rel-friend-breathe { 50% { opacity: .66; filter: saturate(.78); } }\n    .vld-rel .e-friendship.band-high { --tone: 55, 218, 130; }\n    .vld-rel .e-friendship.band-peak { --tone: 185, 218, 103; }\n\n    .vld-rel .e-love.is-dominant.band-high,\n    .vld-rel .e-love.is-dominant.band-peak { animation: vld-rel-love-beat 1.1s ease-in-out infinite; }\n    @keyframes vld-rel-love-beat {\n      8%, 22% { transform: translateX(1px); filter: brightness(1.24); }\n      15%, 30%, 100% { transform: none; filter: none; }\n    }\n\n    .vld-rel .e-respect.is-dominant .track i {\n      background: linear-gradient(105deg, rgba(var(--tone), .42) 0 35%, #f5df9b 48%, rgba(var(--tone), .5) 61%);\n      background-size: 210% 100%;\n      animation: vld-rel-respect 2.4s ease-in-out infinite;\n    }\n    @keyframes vld-rel-respect { 50% { background-position: 100% 0; } }\n    .vld-rel .e-interest.is-dominant .track em { animation: vld-rel-interest 1.8s ease-in-out infinite; }\n    @keyframes vld-rel-interest { 50% { transform: translate(-50%, -50%) scale(.55); opacity: .45; } }\n    .vld-rel .e-jealousy.is-dominant { animation: vld-rel-jealousy 1.55s steps(2, end) infinite; }\n    @keyframes vld-rel-jealousy {\n      48% { filter: hue-rotate(18deg) brightness(1.15); }\n      52% { filter: hue-rotate(-10deg); }\n    }\n    .vld-rel .e-hostility.is-dominant { animation: vld-rel-hostility 1.4s steps(1, end) infinite; }\n    @keyframes vld-rel-hostility {\n      46% { transform: translateX(0); }\n      48% { transform: translateX(2px); filter: contrast(1.35); }\n      50% { transform: translateX(-1px); }\n      52%, 100% { transform: none; filter: none; }\n    }\n\n    .vld-rel .e-fear .track i {\n      background: repeating-linear-gradient(112deg, rgba(var(--tone), .9) 0 8px, rgba(19, 26, 32, .82) 8px 10px, rgb(var(--tone)) 10px 15px);\n      box-shadow: 0 0 13px rgba(var(--tone), .56);\n    }\n    .vld-rel .e-fear.is-dominant.band-high,\n    .vld-rel .e-fear.is-dominant.band-peak { animation: vld-rel-fear-stutter 1.72s steps(1, end) infinite; }\n    .vld-rel .e-fear.is-dominant .label {\n      text-shadow: -2px 0 rgba(134, 191, 226, .52), 2px 0 rgba(233, 244, 255, .28);\n    }\n    @keyframes vld-rel-fear-stutter {\n      0%, 76%, 100% { transform: none; filter: none; }\n      78% { transform: translateX(-2px); filter: blur(.25px) brightness(1.25); }\n      80% { transform: translate(2px, 1px); }\n      82% { transform: translateX(-1px); }\n      84% { transform: none; }\n    }\n\n    .vld-rel .card.mood-fear {\n      animation: vld-rel-card-in .4s cubic-bezier(.2, .85, .28, 1) both, vld-rel-fear-card 2.25s steps(1, end) .45s infinite;\n    }\n    .vld-rel .mood-fear h3 {\n      text-shadow: -2px 0 rgba(105, 164, 198, .42), 2px 0 rgba(225, 246, 252, .25);\n    }\n    @keyframes vld-rel-fear-card {\n      0%, 67%, 74%, 100% { transform: none; }\n      68% { transform: translateX(-1px) rotate(-.12deg); }\n      69% { transform: translateX(2px) rotate(.1deg); }\n      70% { transform: translateX(-2px); }\n      71% { transform: translateX(1px); }\n    }\n\n    .vld-rel .frost {\n      position: absolute;\n      z-index: 1;\n      inset: 0;\n      display: none;\n      overflow: hidden;\n      pointer-events: none;\n    }\n    .vld-rel .mood-fear .frost {\n      display: block;\n      background: radial-gradient(circle at 0 50%, rgba(157, 216, 231, .1), transparent 30%), linear-gradient(121deg, transparent 69%, rgba(190, 231, 242, .12) 69.5%, transparent 70%);\n    }\n    .vld-rel .frost i {\n      position: absolute;\n      top: -18px;\n      right: 34px;\n      width: 1px;\n      height: 86px;\n      background: linear-gradient(transparent, rgba(202, 236, 245, .28), transparent);\n      transform: rotate(31deg);\n    }\n    .vld-rel .frost i:nth-child(2) { top: 5px; right: 18px; height: 48px; transform: rotate(-42deg); }\n    .vld-rel .frost i:nth-child(3) { top: 43px; right: 53px; height: 42px; transform: rotate(68deg); }\n\n    .vld-rel .clothes {\n      position: relative;\n      z-index: 2;\n      display: grid;\n      grid-template-columns: auto minmax(0, 1fr);\n      gap: 9px;\n      align-items: baseline;\n      padding-top: 9px;\n      border-top: 1px solid rgba(var(--dominant), .14);\n    }\n    .vld-rel .clothes > span {\n      font: 500 8px/1 var(--mono);\n      text-transform: uppercase;\n      letter-spacing: .14em;\n      color: var(--muted);\n    }\n    .vld-rel .clothes .value {\n      overflow: hidden;\n      font: 400 11px/1.35 var(--mono);\n      color: #cbc1c9;\n      text-overflow: ellipsis;\n      white-space: nowrap;\n    }\n\n    .vld-rel .signal.is-empty,\n    .vld-rel .dictionary { display: none !important; }\n    .vld-rel .card:has(h3:empty) { display: none; }\n    .vld-rel .card[hidden] { display: none !important; }\n\n    @media (prefers-reduced-motion: reduce) {\n      .vld-rel .card,\n      .vld-rel .aura > i,\n      .vld-rel .orbit,\n      .vld-rel .heart,\n      .vld-rel .comment > i,\n      .vld-rel .signal,\n      .vld-rel .track i,\n      .vld-rel .track em { animation: none !important; }\n    }\n  </style>\n  <script>\n    (function () {\n      var root = (document.currentScript && document.currentScript.parentElement)\n        || document.querySelector('.vld-rel:not([data-vld-init])');\n      if (!root || root.dataset.vldInit === '1') return;\n      root.dataset.vldInit = '1';\n      var card = root.querySelector('.card');\n      var name = card.querySelector('h3');\n      var comment = card.querySelector('.comment span');\n      var finalComment = comment.textContent.trim();\n      var monogram = card.querySelector('.monogram');\n      var heart = card.querySelector('.heart');\n      var signals = Array.from(card.querySelectorAll('.signal'));\n      var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n      card.dataset.vldRelReady = '1';\n      var dictionary = {};\n      var tones = {\n        friendship: '86, 190, 133',\n        love: '225, 76, 103',\n        trust: '101, 178, 212',\n        respect: '210, 164, 90',\n        interest: '164, 118, 216',\n        fear: '157, 216, 231',\n        jealousy: '157, 195, 68',\n        hostility: '220, 93, 62',\n      };\n      var validKinds = Object.keys(tones);\n\n      card.querySelectorAll('.dictionary [data-kind]').forEach(function (item) {\n        dictionary[item.dataset.kind] = item.textContent;\n      });\n\n      var readings = signals.map(function (signal, index) {\n        var kind = validKinds.find(function (candidate) {\n          return signal.classList.contains('e-' + candidate);\n        });\n        var raw = parseInt(signal.dataset.value, 10);\n        var value = isNaN(raw) ? 0 : Math.max(0, Math.min(100, raw));\n\n        if (!kind) {\n          signal.classList.add('is-empty');\n          return { signal: signal, kind: '', value: 0, index: index };\n        }\n\n        signal.querySelector('.label').textContent = dictionary[kind] || kind;\n        signal.classList.add(band(value));\n        card.style.setProperty('--orbit-' + (index + 1), tones[kind]);\n        return { signal: signal, kind: kind, value: value, index: index };\n      });\n\n      var active = readings.filter(function (reading) { return reading.kind; });\n      var dominant = active.reduce(function (best, reading) {\n        return !best || reading.value > best.value ? reading : best;\n      }, null);\n\n      if (dominant) {\n        dominant.signal.classList.add('is-dominant');\n        card.classList.add('mood-' + dominant.kind);\n        card.dataset.dominant = dominant.kind;\n        card.style.setProperty('--dominant', tones[dominant.kind]);\n      }\n\n      var love = active.find(function (reading) { return reading.kind === 'love'; });\n      if (love && love.value > 0) heart.classList.add('is-visible', band(love.value));\n      monogram.textContent = Array.from(name.textContent.trim())[0] || '';\n      comment.textContent = reduced ? finalComment : '';\n\n      var COMMENT_DELAY = 50;\n      var COMMENT_STEP = 14;\n      var COUNT_DELAY = 160;\n      var STAGGER = 80;\n      var COUNT_DURATION = 720;\n      var commentDuration = COMMENT_DELAY + finalComment.length * COMMENT_STEP;\n      var countDuration = COUNT_DELAY + STAGGER * Math.max(0, active.length - 1) + COUNT_DURATION;\n      var totalDuration = Math.max(commentDuration, countDuration);\n      var frameId = 0;\n      var startedAt = 0;\n      var autoTimer = 0;\n      var autoObserver = null;\n\n      if (reduced) paint(Infinity);\n      else queueAutomaticRun();\n\n      root.vldSeek = function (ms) {\n        cancelAutomaticStart();\n        if (frameId) cancelAnimationFrame(frameId);\n        frameId = 0;\n        paint(Number(ms) || 0);\n      };\n\n      groupDeck();\n\n      function queueAutomaticRun() {\n        var message = root.closest('.mes_text');\n        if (!message || typeof MutationObserver !== 'function') {\n          run();\n          return;\n        }\n\n        function armAfterQuiet() {\n          if (autoTimer) clearTimeout(autoTimer);\n          autoTimer = setTimeout(function () {\n            cancelAutomaticStart();\n            if (root.isConnected) run();\n          }, 180);\n        }\n\n        autoObserver = new MutationObserver(armAfterQuiet);\n        autoObserver.observe(message, { childList: true, subtree: true, characterData: true });\n        armAfterQuiet();\n      }\n\n      function cancelAutomaticStart() {\n        if (autoTimer) clearTimeout(autoTimer);\n        autoTimer = 0;\n        if (autoObserver) autoObserver.disconnect();\n        autoObserver = null;\n      }\n\n      function run() {\n        if (frameId) cancelAnimationFrame(frameId);\n        startedAt = performance.now();\n        paint(0);\n        frameId = requestAnimationFrame(step);\n      }\n\n      function step(now) {\n        if (!root.isConnected) {\n          frameId = 0;\n          return;\n   