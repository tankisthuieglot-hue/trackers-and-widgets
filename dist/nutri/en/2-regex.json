{
 "id": "22a25707-2bc9-529e-a947-8b3590a6f6da",
 "scriptName": "🥫 VLD NUTRITION FACTS · en",
 "findRegex": "/\\[\\[VLD_NUTRI(?![A-Z0-9_])(?=[^\\]]*\\|\\s*N\\s*=[ \\t]*([^|\\]<]*)|)(?=[^\\]]*\\|\\s*S\\s*=[ \\t]*([^|\\]<]*)|)(?=[^\\]]*\\|\\s*CAL\\s*=[ \\t]*([0-9]{0,3})|)(?=[^\\]]*\\|\\s*L1\\s*=[ \\t]*([^|\\]<]*)|)(?=[^\\]]*\\|\\s*P1\\s*=[ \\t]*([0-9]{0,3})|)(?=[^\\]]*\\|\\s*L2\\s*=[ \\t]*([^|\\]<]*)|)(?=[^\\]]*\\|\\s*P2\\s*=[ \\t]*([0-9]{0,3})|)(?=[^\\]]*\\|\\s*L3\\s*=[ \\t]*([^|\\]<]*)|)(?=[^\\]]*\\|\\s*P3\\s*=[ \\t]*([0-9]{0,3})|)(?=[^\\]]*\\|\\s*L4\\s*=[ \\t]*([^|\\]<]*)|)(?=[^\\]]*\\|\\s*P4\\s*=[ \\t]*([0-9]{0,3})|)(?=[^\\]]*\\|\\s*W\\s*=[ \\t]*([^|\\]<]*)|)[^\\]]*\\]\\]/g",
 "replaceString": "<div class=\"vld-w vld-nutri\">\n  <div class=\"label\">\n    <div class=\"who\">$1</div>\n    <div class=\"title\">Nutrition Facts</div>\n\n    <div class=\"serving\">\n      <span>Serving size</span>\n      <b>$2</b>\n    </div>\n\n    <div class=\"rule thick\"></div>\n\n    <div class=\"per\">Amount per serving</div>\n\n    <div class=\"cal\">\n      <span>Calories</span>\n      <b>$3</b>\n    </div>\n\n    <div class=\"rule mid\"></div>\n\n    <div class=\"dv\">% Daily Value</div>\n\n    <div class=\"row\"><span class=\"nm\">$4</span><span class=\"pc\">$5</span></div>\n    <div class=\"row\"><span class=\"nm\">$6</span><span class=\"pc\">$7</span></div>\n    <div class=\"row\"><span class=\"nm\">$8</span><span class=\"pc\">$9</span></div>\n    <div class=\"row\"><span class=\"nm\">$10</span><span class=\"pc\">$11</span></div>\n\n    <div class=\"rule thick\"></div>\n\n    <div class=\"warn\">$12</div>\n    <div class=\"fine\">Percent Daily Values are based on a 2000 calorie social diet. Your values may be higher or lower depending on your tolerance.</div>\n  </div>\n  <style>\n    /* Шутка держится на том, что вёрстка абсолютно серьёзная. Это настоящая\n       этикетка: Helvetica, чёрное на белом, линейки в 1, 5 и 8 пикселей, мелкий\n       шрифт внизу про суточную норму. Ни одного цвета, ни одной скруглённой\n       рамки, никакой анимации сверх появления.\n\n       Стоит добавить хоть что-то «весёлое» — розовую рамку, дрожащий текст — и\n       станет обычной картинкой с подписью. Смешное здесь целиком в контрасте\n       между формой и содержанием, поэтому форму трогать нельзя. */\n\n    .vld-nutri {\n      /* Гельветика и её клоны по порядку доступности. Ни один системный шрифт с\n         засечками сюда не годится: этикетка узнаётся именно гротеском. */\n      --face: \"Helvetica Neue\", Helvetica, Arial, \"Liberation Sans\", sans-serif;\n\n      width: min(100%, 300px);\n      margin: 14px auto;\n      color: #000;\n      filter: drop-shadow(0 8px 18px rgba(0, 0, 0, .3));\n    }\n\n    .vld-nutri * {\n      box-sizing: border-box;\n    }\n\n    .vld-nutri .label {\n      padding: 7px 9px 8px;\n      border: 1.5px solid #000;\n      background: #fff;\n      font-family: var(--face);\n      animation: vld-nutri-in .26s ease both;\n    }\n\n    @keyframes vld-nutri-in {\n      from { opacity: 0; }\n    }\n\n    .vld-nutri .who {\n      font: 400 10px/1.2 var(--face);\n      letter-spacing: .02em;\n      text-transform: uppercase;\n    }\n\n    .vld-nutri .title {\n      margin-top: 1px;\n      /* Сжатое начертание — на настоящей этикетке заголовок именно такой. */\n      font: 800 27px/.95 var(--face);\n      letter-spacing: -.035em;\n      transform: scaleX(.94);\n      transform-origin: left;\n    }\n\n    .vld-nutri .serving {\n      display: flex;\n      justify-content: space-between;\n      gap: 8px;\n      margin-top: 3px;\n      font: 400 11px/1.25 var(--face);\n    }\n\n    .vld-nutri .serving b {\n      font-weight: 700;\n      text-align: right;\n    }\n\n    /* Три толщины линеек — единственная иерархия на всей этикетке. */\n    .vld-nutri .rule {\n      background: #000;\n    }\n\n    .vld-nutri .thick {\n      height: 8px;\n      margin: 3px 0;\n    }\n\n    .vld-nutri .mid {\n      height: 4px;\n      margin: 2px 0;\n    }\n\n    .vld-nutri .per {\n      font: 700 9.5px/1.2 var(--face);\n    }\n\n    .vld-nutri .cal {\n      display: flex;\n      align-items: flex-end;\n      justify-content: space-between;\n      gap: 8px;\n      margin-top: -1px;\n    }\n\n    .vld-nutri .cal span {\n      font: 800 19px/1.1 var(--face);\n      letter-spacing: -.025em;\n    }\n\n    .vld-nutri .cal b {\n      font: 800 26px/1 var(--face);\n      letter-spacing: -.03em;\n    }\n\n    .vld-nutri .dv {\n      padding-bottom: 2px;\n      border-bottom: 1px solid #000;\n      text-align: right;\n      font: 700 9.5px/1.2 var(--face);\n    }\n\n    .vld-nutri .row {\n      display: flex;\n      justify-content: space-between;\n      gap: 10px;\n      padding: 3px 0;\n      border-bottom: 1px solid #000;\n      font: 400 11.5px/1.25 var(--face);\n    }\n\n    .vld-nutri .nm {\n      font-weight: 700;\n    }\n\n    .vld-nutri .pc {\n      flex: 0 0 auto;\n      font-weight: 700;\n      font-variant-numeric: tabular-nums;\n    }\n\n    /* Знак процента дорисован стилями, а не приклеен к значению: иначе строка\n       без числа показала бы одинокое «%». */\n    .vld-nutri .pc::after {\n      content: \"%\";\n    }\n\n    .vld-nutri .pc:empty {\n      display: none;\n    }\n\n    .vld-nutri .warn {\n      margin-top: 4px;\n      font: 700 9.5px/1.3 var(--face);\n    }\n\n    /* Тот самый шрифт, который никто не читает. Он и должен быть нечитаемым —\n       без него этикетка не этикетка. */\n    .vld-nutri .fine {\n      margin-top: 4px;\n      padding-top: 4px;\n      border-top: 1px solid #000;\n      font: 400 7.5px/1.25 var(--face);\n    }\n\n    /* Незаполненные строки состава исчезают вместе со своей линейкой. Пустой\n       процент — тоже: «%» без числа выдал бы механику наружу. */\n    .vld-nutri .row:has(.nm:empty),\n    .vld-nutri .serving:has(b:empty),\n    .vld-nutri .cal:has(b:empty),\n    .vld-nutri .warn:empty {\n      display: none;\n    }\n\n    .vld-nutri .label:has(.who:empty) {\n      display: none;\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      .vld-nutri .label {\n        animation: none;\n      }\n    }\n  </style>\n</div>",
