 "replaceString": "<div class=\"vld-w vld-critic\">\n  <div class=\"intrusion\"><i></i><span>unsolicited opinions detected</span><i></i></div>\n\n  <div class=\"critic-stack\">\n    <article class=\"critic-card kind-$2 lv-$4\" data-kind=\"$2\" data-score=\"$4\">\n      <div class=\"artifact\" aria-hidden=\"true\"><i></i><i></i><i></i></div>\n      <div class=\"portrait\"><span class=\"initial\"></span><i></i></div>\n      <div class=\"copy\">\n        <div class=\"origin\"></div>\n        <h3 class=\"critic-name\">$1</h3>\n        <div class=\"critic-title\">$3</div>\n        <blockquote class=\"comment\">$5</blockquote>\n      </div>\n      <div class=\"score\"><strong class=\"score-number\">0</strong><small>/10</small></div>\n    </article>\n\n    <article class=\"critic-card kind-$7 lv-$9\" data-kind=\"$7\" data-score=\"$9\">\n      <div class=\"artifact\" aria-hidden=\"true\"><i></i><i></i><i></i></div>\n      <div class=\"portrait\"><span class=\"initial\"></span><i></i></div>\n      <div class=\"copy\">\n        <div class=\"origin\"></div>\n        <h3 class=\"critic-name\">$6</h3>\n        <div class=\"critic-title\">$8</div>\n        <blockquote class=\"comment\">$10</blockquote>\n      </div>\n      <div class=\"score\"><strong class=\"score-number\">0</strong><small>/10</small></div>\n    </article>\n\n    <article class=\"critic-card kind-$12 lv-$14\" data-kind=\"$12\" data-score=\"$14\">\n      <div class=\"artifact\" aria-hidden=\"true\"><i></i><i></i><i></i></div>\n      <div class=\"portrait\"><span class=\"initial\"></span><i></i></div>\n      <div class=\"copy\">\n        <div class=\"origin\"></div>\n        <h3 class=\"critic-name\">$11</h3>\n        <div class=\"critic-title\">$13</div>\n        <blockquote class=\"comment\">$15</blockquote>\n      </div>\n      <div class=\"score\"><strong class=\"score-number\">0</strong><small>/10</small></div>\n    </article>\n  </div>\n\n  <div class=\"dictionary\" hidden>\n    <span data-kind=\"public\">public figure</span>\n    <span data-kind=\"anime\">anime</span>\n    <span data-kind=\"history\">history</span>\n  </div>\n  <style>\n    .vld-critic {\n      --paper: #0b0c10;\n      width: min(100%, 540px);\n      margin: 12px auto;\n      color: #f1f3f7;\n      font-family: \"Segoe UI\", Arial, sans-serif;\n      filter: drop-shadow(0 18px 24px rgba(0, 0, 0, .34));\n      cursor: pointer;\n      isolation: isolate;\n    }\n\n    .vld-critic *,\n    .vld-critic *::before,\n    .vld-critic *::after { box-sizing: border-box; }\n\n    .vld-critic .intrusion {\n      display: flex;\n      align-items: center;\n      gap: 10px;\n      margin: 0 12px 7px;\n      color: #8a929f;\n      font: 700 9px/1 \"Consolas\", monospace;\n      letter-spacing: .19em;\n      text-transform: uppercase;\n    }\n\n    .vld-critic .intrusion i {\n      height: 1px;\n      flex: 1;\n      background: linear-gradient(90deg, transparent, #546070);\n    }\n\n    .vld-critic .intrusion i:last-child {\n      background: linear-gradient(90deg, #546070, transparent);\n    }\n\n    .vld-critic.is-armed .intrusion span {\n      animation: vld-critic-carrier 820ms steps(2, end) both;\n    }\n\n    .vld-critic .critic-stack {\n      display: grid;\n      gap: 8px;\n    }\n\n    .vld-critic .critic-card {\n      --accent: #82dfff;\n      --accent-rgb: 130, 223, 255;\n      --d: 0ms;\n      position: relative;\n      min-height: 126px;\n      display: grid;\n      grid-template-columns: 68px minmax(0, 1fr) 70px;\n      align-items: center;\n      gap: 13px;\n      padding: 15px 15px 15px 13px;\n      overflow: hidden;\n      transform-origin: 50% 50%;\n    }\n\n    .vld-critic .critic-card:nth-child(1) { margin-right: 19px; }\n    .vld-critic .critic-card:nth-child(2) { margin-left: 23px; }\n    .vld-critic .critic-card:nth-child(3) { margin: 0 7px 0 9px; }\n    .vld-critic .critic-card.is-empty { display: none !important; }\n\n    .vld-critic .artifact {\n      position: absolute;\n      inset: 0;\n      pointer-events: none;\n    }\n\n    .vld-critic .portrait {\n      position: relative;\n      z-index: 2;\n      width: 58px;\n      height: 58px;\n      display: grid;\n      place-items: center;\n    }\n\n    .vld-critic .initial {\n      position: relative;\n      z-index: 2;\n      font-size: 24px;\n      font-weight: 900;\n    }\n\n    .vld-critic .copy {\n      position: relative;\n      z-index: 2;\n      min-width: 0;\n    }\n\n    .vld-critic .origin {\n      margin-bottom: 3px;\n      color: var(--accent);\n      font: 800 9px/1 \"Consolas\", monospace;\n      letter-spacing: .17em;\n      text-transform: uppercase;\n    }\n\n    .vld-critic .critic-name {\n      margin: 0;\n      color: #f4f6fb;\n      font-size: 20px;\n      line-height: 1.04;\n      overflow-wrap: anywhere;\n    }\n\n    .vld-critic .critic-title {\n      margin-top: 4px;\n      color: #9da4b1;\n      font: 600 10px/1.15 \"Consolas\", monospace;\n      letter-spacing: .08em;\n      text-transform: uppercase;\n    }\n\n    .vld-critic .comment {\n      min-height: 30px;\n      margin: 9px 0 0;\n      padding: 0;\n      border: 0;\n      color: #d7dae2;\n      font-size: 12px;\n      line-height: 1.28;\n      font-style: normal;\n    }\n\n    .vld-critic .comment::after {\n      content: \"\";\n      display: inline-block;\n      width: 5px;\n      height: 12px;\n      margin-left: 3px;\n      vertical-align: -2px;\n      background: var(--accent);\n      opacity: .8;\n    }\n\n    .vld-critic .is-settled .comment::after { display: none; }\n\n    .vld-critic .score {\n      position: relative;\n      z-index: 3;\n      width: 65px;\n      height: 65px;\n      display: grid;\n      place-content: center;\n      text-align: center;\n      color: var(--score, var(--accent));\n    }\n\n    .vld-critic .score-number {\n      font: 900 31px/.8 \"Arial Black\", Impact, sans-serif;\n      letter-spacing: -.06em;\n    }\n\n    .vld-critic .score small {\n      margin-top: 5px;\n      color: #9