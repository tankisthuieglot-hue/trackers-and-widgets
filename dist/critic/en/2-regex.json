n 1150ms calc(var(--d) + 300ms) ease-out both;\n    }\n\n    /* Anime: a cel-cut card that arrives like a panel slash. */\n    .vld-critic .kind-anime {\n      --accent: #ff5fcf;\n      --accent-rgb: 255, 95, 207;\n      border: 2px solid #ff5fcf;\n      clip-path: polygon(15px 0, 100% 0, calc(100% - 13px) 100%, 0 100%);\n      background:\n        radial-gradient(circle at 88% 12%, rgba(88, 230, 255, .17), transparent 29%),\n        linear-gradient(113deg, #201126 0 52%, #150d20 52%);\n      box-shadow: 6px 6px 0 #58e6ff;\n    }\n\n    .vld-critic .kind-anime .portrait {\n      transform: rotate(-7deg);\n      border: 3px solid #f4f4ff;\n      background: #ff5fcf;\n      box-shadow: 5px 4px 0 #58e6ff;\n    }\n\n    .vld-critic .kind-anime .initial {\n      color: #160d20;\n      font-family: \"Arial Black\", Impact, sans-serif;\n      transform: skewX(-8deg);\n    }\n\n    .vld-critic .kind-anime .critic-name {\n      font-family: \"Arial Black\", Impact, sans-serif;\n      letter-spacing: -.035em;\n      text-transform: uppercase;\n      text-shadow: 2px 2px 0 rgba(88, 230, 255, .34);\n    }\n\n    .vld-critic .kind-anime .comment { color: #f2ddf0; }\n\n    .vld-critic .kind-anime .score {\n      transform: rotate(4deg);\n      border: 3px solid #f6f3ff;\n      background: #211229;\n      box-shadow: 4px 4px 0 var(--accent);\n    }\n\n    .vld-critic .kind-anime .artifact {\n      background: repeating-linear-gradient(\n        118deg,\n        transparent 0 17px,\n        rgba(255, 255, 255, .045) 18px,\n        transparent 20px 31px\n      );\n    }\n\n    .vld-critic .kind-anime .artifact i:nth-child(2),\n    .vld-critic .kind-anime .artifact i:nth-child(3) {\n      position: absolute;\n      left: -10%;\n      width: 130%;\n      height: 2px;\n      background: #58e6ff;\n      transform: rotate(-4deg) scaleX(0);\n      transform-origin: left;\n    }\n\n    .vld-critic .kind-anime .artifact i:nth-child(2) { top: 28%; }\n    .vld-critic .kind-anime .artifact i:nth-child(3) {\n      bottom: 19%;\n      background: #ff5fcf;\n    }\n\n    .vld-critic.is-armed .kind-anime .artifact i:nth-child(2),\n    .vld-critic.is-armed .kind-anime .artifact i:nth-child(3) {\n      animation: vld-critic-slash 460ms calc(var(--d) + 180ms) cubic-bezier(.2,.8,.2,1) both;\n    }\n\n    /* History: blackened metal, engraved type and a struck coin seal. */\n    .vld-critic .kind-history {\n      --accent: #c7a76c;\n      --accent-rgb: 199, 167, 108;\n      border: 1px solid #8c7045;\n      outline: 1px solid rgba(199, 167, 108, .19);\n      outline-offset: -5px;\n      border-radius: 2px;\n      background:\n        radial-gradient(circle at 12% 40%, rgba(199,167,108,.08), transparent 30%),\n        repeating-linear-gradient(92deg, rgba(255,255,255,.018) 0 1px, transparent 1px 7px),\n        #171512;\n      box-shadow:\n        inset 0 0 34px rgba(0,0,0,.42),\n        0 4px 14px rgba(0,0,0,.28);\n    }\n\n    .vld-critic .kind-history .portrait {\n      border: 1px solid #c7a76c;\n      border-radius: 50%;\n      color: #d6bd8b;\n      background:\n        radial-gradient(circle, #30291d 0 46%, #171512 48%);\n      box-shadow: inset 0 0 0 4px #171512, inset 0 0 0 5px #6f5937;\n    }\n\n    .vld-critic .kind-history .initial,\n    .vld-critic .kind-history .critic-name {\n      font-family: Georgia, \"Times New Roman\", serif;\n    }\n\n    .vld-critic .kind-history .critic-name {\n      color: #e4d7bc;\n      letter-spacing: .015em;\n    }\n\n    .vld-critic .kind-history .comment {\n      color: #cfc6b5;\n      font-family: Georgia, \"Times New Roman\", serif;\n      font-style: italic;\n    }\n\n    .vld-critic .kind-history .score {\n      border: 3px double #8c7045;\n      border-radius: 50%;\n      background: radial-gradient(circle, #272117 0 55%, #15130f 57%);\n      box-shadow: inset 0 0 16px rgba(0,0,0,.55);\n    }\n\n    .vld-critic .kind-history .artifact::after {\n      content: \"\";\n      position: absolute;\n      inset: 8px;\n      border-top: 1px solid rgba(199,167,108,.18);\n      border-bottom: 1px solid rgba(199,167,108,.13);\n    }\n\n    .vld-critic.is-armed .kind-public {\n      animation: vld-critic-public-in 760ms var(--d) cubic-bezier(.16,.85,.18,1.08) both;\n    }\n\n    .vld-critic.is-armed .kind-anime {\n      animation: vld-critic-anime-in 690ms var(--d) cubic-bezier(.18,.9,.22,1.12) both;\n    }\n\n    .vld-critic.is-armed .kind-history {\n      animation: vld-critic-history-in 820ms var(--d) cubic-bezier(.12,.78,.22,1) both;\n    }\n\n    .vld-critic.is-armed .score {\n      animation: vld-critic-score 470ms calc(var(--d) + 530ms) cubic-bezier(.15,.9,.16,1.35) both;\n    }\n\n    @keyframes vld-critic-public-in {\n      0% { opacity: 0; transform: perspective(650px) translateX(-72px) rotateY(18deg); }\n      62% { opacity: 1; transform: perspective(650px) translateX(5px) rotateY(-2deg); }\n      100% { opacity: 1; transform: none; }\n    }\n\n    @keyframes vld-critic-anime-in {\n      0% { opacity: 0; transform: translate(64px, -22px) rotate(4deg) skewX(-9deg); }\n      55% { opacity: 1; transform: translate(-5px, 2px) rotate(-1deg) skewX(2deg); }\n      100% { opacity: 1; transform: none; }\n    }\n\n    @keyframes vld-critic-history-in {\n      0% { opacity: 0; transform: translateY(-42px) rotate(-2.5deg) scale(1.04); filter: blur(3px); }\n      58% { opacity: 1; transform: translateY(4px) rotate(.4deg) scale(.995); filter: blur(0); }\n      100% { opacity: 1; transform: none; filter: none; }\n    }\n\n    @keyframes vld-critic-score {\n      0% { opacity: 0; transform: scale(2.2) rotate(-13deg); filter: blur(3px); }\n      66% { opacity: 1; transform: scale(.88) rotate(2deg); filter: blur(0); }\n      100% { opacity: 1; transform: scale(1) rotate(0); }\n    }\n\n    @keyframes vld-critic-scan {\n      from { transform: skewX(-18deg) translateX(-160%); }\n      to { transform: skewX(-18deg) translateX(440%); }\n    }\n\n    @keyframes vld-critic-slash {\n      from { transform: rotate(-4deg) scaleX(0); opacity: 1; }\n      70% { transform: rotate(-4deg) scaleX(1); opacity: 1; }\n      to { transform: rotate(-4deg) scaleX(1); opacity: 0; }\n    }\n\n    @keyframes vld-critic-carrier {\n      0%, 19% { opacity: 0; transform: translateX(-3px); }\n      20%, 39% { opacity: .9; transform: translateX(2px); }\n      40%, 59% { opacity: .25; transform: translateX(-1px); }\n      60%, 100% { opacity: 1; transform: none; }\n    }\n\n    @media (max-width: 480px) {\n      .vld-critic .critic-card {\n        grid-template-columns: 51px minmax(0, 1fr) 53px;\n        gap: 9px;\n        min-height: 120px;\n        padding: 13px 11px;\n      }\n      .vld-critic .portrait { width: 45px; height: 45px; }\n      .vld-critic .critic-name { font-size: 17px; }\n      .vld-critic .score { width: 50px; height: 57px; }\n      .vld-critic .score-number { font-size: 26px; }\n      .vld-critic .critic-card:nth-child(n) { margin-left: 0; margin-right: 0; }\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      .vld-critic *,\n      .vld-critic *::before,\n      .vld-critic *::after {\n        animation: none !important;\n        transition: none !important;\n      }\n    }\n  </style>\n  <script>\n    (function () {\n      var root = (document.currentScript && document.currentScript.parentElement)\n        || document.querySelector('.vld-critic:not([data-vld-init])');\n      if (!root || root.dataset.vldInit === '1') return;\n      root.dataset.vldInit = '1';\n      var cards = Array.from(root.querySelectorAll('.critic-card'));\n      var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n      var dictionary = {};\n      var validKinds = ['public', 'anime', 'history'];\n      var active = [];\n      var frameId = 0;\n      var startedAt = 0;\n      var autoTimer = 0;\n      var autoObserver = null;\n\n      root.querySelectorAll('.dictionary [data-kind]').forEach(function (item) {\n        dictionary[item.dataset.kind] = item.textContent;\n      });\n\n      cards.forEach(function (card, index) {\n        var name = card.querySelector('.critic-name');\n        var kind = validKinds.indexOf(card.dataset.kind) >= 0 ? card.dataset.kind : '';\n        var rawScore = parseInt(card.dataset.score, 10);\n        var score = isNaN(rawScore) ? 0 : Math.max(0, Math.min(10, rawScore));\n        var comment = card.querySelector('.comment');\n        var finalComment = comment.textContent.trim();\n\n        if (!name.textContent.trim() || !kind) {\n          card.classList.add('is-empty');\n          return;\n        }\n\n        card.dataset.kind = kind;\n        card.style.setProperty('--d', String(index * 280) + 'ms');\n        card.querySelector('.origin').textContent = dictionary[kind] || kind;\n        card.querySelector('.initial').textContent =\n          Array.from(name.textContent.trim())[0] || '?';\n        card.querySelector('.score-number').textContent = reduced ? String(score) : '0';\n        comment.textContent = reduced ? finalComment : '';\n\n        active.push({\n          card: card,\n          score: score,\n          scoreNode: card.querySelector('.score-number'),\n          comment: comment,\n          finalComment: finalComment,\n          delay: index * 280,\n        });\n      });\n\n      if (reduced) {\n        root.classList.add('is-armed');\n        paint(Infinity);\n      } else {\n        queueAutomaticRun();\n      }\n\n      root.vldSeek = function (ms) {\n        cancelAutomaticStart();\n        if (frameId) cancelAnimationFrame(frameId);\n        frameId = 0;\n        root.classList.add('is-armed');\n        paint(Number(ms) || 0);\n      };\n\n      root.addEventListener('click', function () {\n        if (!reduced) run();\n      });\n\n      function queueAutomaticRun() {\n        var message = root.closest('.mes_text');\n        if (!message || typeof MutationObserver !== 'function') {\n          run();\n          return;\n        }\n\n        function armAfterQuiet() {\n          if (autoTimer) clearTimeout(autoTimer);\n          autoTimer = setTimeout(function () {\n            cancelAutomaticStart();\n            if (root.isConnected) run();\n          }, 180);\n        }\n\n        autoObserver = new MutationObserver(armAfterQuiet);\n        autoObserver.observe(message, { childList: true, subtree: true, characterData: true });\n        armAfterQuiet();\n      }\n\n      function cancelAutomaticStart() {\n        if (autoTimer) clearTimeout(autoTimer);\n        autoTimer = 0;\n        if (autoObserver) autoObserver.disconnect();\n        autoObserver = null;\n      }\n\n      function run() {\n        cancelAutomaticStart();\n        if (frameId) cancelAnimationFrame(frameId);\n        root.classList.remove('is-armed');\n        void root.offsetWidth;\n        root.classList.add('is-armed');\n        paint(0);\n        startedAt = performance.now();\n        frameId = requestAnimationFrame(step);\n      }\n\n      function step(now) {\n        if (!root.isConnected) {\n          frameId = 0;\n          return;\n        }\n\n        var elapsed = now - startedAt;\n        paint(elapsed);\n        if (elapsed < duration()) frameId = requestAnimationFrame(step);\n        else frameId = 0;\n      }\n\n      function duration() {\n        return active.reduce(function (latest, item) {\n          return Math.max(latest, item.delay + 520 + item.finalComment.length * 15);\n        }, 0);\n      }\n\n      function paint(ms) {\n        active.forEach(function (item) {\n          var scoreDelay = item.delay + 260;\n          var progress = ms === Infinity\n            ? 1\n            : Math.max(0, Math.min(1, (ms - scoreDelay) / 680));\n          var eased = 1 - Math.pow(1 - progress, 3);\n          item.scoreNode.textContent = String(Math.round(item.score * eased));\n\n          var commentDelay = item.delay + 420;\n          var letters = ms === Infinity\n            ? item.finalComment.length\n            : Math.max(0, Math.min(\n                item.finalComment.length,\n                Math.floor((ms - commentDelay) / 15),\n              ));\n          item.comment.textContent = item.finalComment.slice(0, letters);\n          item.card.classList.toggle(\n            'is-settled',\n            ms === Infinity || ms >= item.delay + 1100,\n          );\n        });\n      }\n    })();\n  </script>\n</div>",
