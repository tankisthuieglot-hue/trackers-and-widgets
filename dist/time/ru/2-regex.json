 "replaceString": "<div class=\"vld-w vld-time\">\n  <div class=\"chronometer\" data-hour=\"$1\" data-minute=\"$2\">\n    <button class=\"watch-trigger\" type=\"button\" aria-expanded=\"false\" aria-label=\"открыть момент\">\n      <span class=\"watch-body\">\n        <span class=\"crown\" aria-hidden=\"true\"><i></i><i></i><i></i><i></i><i></i></span>\n        <span class=\"bow\" aria-hidden=\"true\"><i></i></span>\n        <span class=\"case-ring\">\n          <span class=\"timepiece\">\n            <span class=\"dial-grain\" aria-hidden=\"true\"></span>\n            <span class=\"minute-track\" aria-hidden=\"true\"></span>\n            <span class=\"chapter chapter-12\">XII</span>\n            <span class=\"chapter chapter-3\">III</span>\n            <span class=\"chapter chapter-9\">IX</span>\n            <span class=\"phase-window\" aria-hidden=\"true\">\n              <span class=\"phase-disc\">\n                <i class=\"phase-sun\"></i>\n                <i class=\"phase-moon\"></i>\n                <b class=\"phase-stars\"></b>\n              </span>\n            </span>\n            <span class=\"maker\">MOMENT</span>\n            <span class=\"hand hour-hand\" aria-hidden=\"true\"><i></i></span>\n            <span class=\"hand minute-hand\" aria-hidden=\"true\"><i></i></span>\n            <span class=\"hand-pin\" aria-hidden=\"true\"></span>\n            <span class=\"balance-window\" aria-hidden=\"true\">\n              <span class=\"balance-bridge\"></span>\n              <span class=\"balance-wheel\"><i></i><i></i><i></i><i></i></span>\n              <span class=\"balance-jewel\"></span>\n            </span>\n            <span class=\"digital-time\" aria-label=\"00:00\">\n              <span class=\"digit-window\"><b>0</b></span>\n              <span class=\"digit-window\"><b>0</b></span>\n              <i>:</i>\n              <span class=\"digit-window\"><b>0</b></span>\n              <span class=\"digit-window\"><b>0</b></span>\n            </span>\n          </span>\n\n          <span class=\"watch-lid\" aria-hidden=\"true\">\n            <span class=\"lid-metal\"></span>\n            <span class=\"lid-glass\"></span>\n            <span class=\"lid-etch\"><i></i><b></b></span>\n            <span class=\"lid-glint\"></span>\n            <span class=\"lid-inscription\" aria-hidden=\"true\">\n              <span class=\"card-kicker\">зафиксированный момент</span>\n              <strong class=\"moment-date\">$3</strong>\n              <span class=\"moment-passage\">\n                <small>переход</small>\n                <b class=\"moment-elapsed\">$4</b>\n              </span>\n              <span class=\"moment-note\">$5</span>\n              <i class=\"lid-close\">закрыть момент</i>\n            </span>\n          </span>\n          <span class=\"hinge\" aria-hidden=\"true\"><i></i><i></i><i></i></span>\n        </span>\n      </span>\n      <span class=\"action-label\"><i class=\"label-open\">открыть момент</i><i class=\"label-close\">закрыть момент</i></span>\n    </button>\n  </div>\n  <style>\n    .vld-time {\n      --ink: #d8d6c8;\n      --muted: #8f938d;\n      --void: #090d0f;\n      --gunmetal: #1a2225;\n      --nickel: #a9afa8;\n      --brass: #a66f35;\n      --light: #d8c98f;\n      --phase: #637d9b;\n      --phase-soft: #263b4a;\n      --phase-turn: 180deg;\n      --open-shift: -87px;\n      --glass-x: 0px;\n      --glass-y: 0px;\n      --dial-x: 0px;\n      --dial-y: 0px;\n      --serif: \"Cormorant Garamond\", \"Baskerville\", Georgia, serif;\n      --mono: \"IBM Plex Mono\", \"Cascadia Mono\", Consolas, monospace;\n      width: min(100%, 370px);\n      margin: 18px auto;\n      color: var(--ink);\n      perspective: 900px;\n      filter: drop-shadow(0 20px 30px rgba(0, 0, 0, .46));\n    }\n\n    .vld-time.phase-dawn {\n      --phase: #d69772;\n      --phase-soft: #594039;\n      --light: #efcf9d;\n      --phase-turn: -48deg;\n    }\n\n    .vld-time.phase-day {\n      --phase: #b9cbc4;\n      --phase-soft: #445955;\n      --light: #e5d6a7;\n      --phase-turn: 0deg;\n    }\n\n    .vld-time.phase-dusk {\n      --phase: #c66e63;\n      --phase-soft: #513238;\n      --light: #e2a275;\n      --phase-turn: 48deg;\n    }\n\n    .vld-time.phase-night {\n      --phase: #7189a5;\n      --phase-soft: #26394b;\n      --light: #c8d1bd;\n      --phase-turn: 180deg;\n    }\n\n    .vld-time *,\n    .vld-time *::before,\n    .vld-time *::after {\n      box-sizing: border-box;\n    }\n\n    .vld-time .chronometer {\n      position: relative;\n      isolation: isolate;\n      min-height: 304px;\n      transform-style: preserve-3d;\n      animation: vld-time-arrive .72s cubic-bezier(.16, .86, .24, 1) both;\n    }\n\n    @keyframes vld-time-arrive {\n      0% { opacity: 0; transform: translateY(24px) rotateZ(-2.5deg) scale(.94); }\n      64% { opacity: 1; transform: translateY(-3px) rotateZ(.4deg) scale(1.008); }\n      100% { opacity: 1; transform: none; }\n    }\n\n    .vld-time .watch-trigger {\n      position: relative;\n      z-index: 3;\n      display: block;\n      width: 100%;\n      min-height: 304px;\n      padding: 0;\n      border: 0;\n      outline: 0;\n      background: none;\n      color: inherit;\n      font: inherit;\n      cursor: pointer;\n      touch-action: manipulation;\n      -webkit-tap-highlight-color: transparent;\n      transform-style: preserve-3d;\n    }\n\n    .vld-time .watch-trigger:focus-visible .case-ring {\n      outline: 2px solid color-mix(in srgb, var(--phase) 78%, white);\n      outline-offset: 7px;\n    }\n\n    .vld-time .watch-trigger:disabled {\n      cursor: default;\n    }\n\n    .vld-time .watch-body {\n      position: relative;\n      display: block;\n      width: 270px;\n      height: 270px;\n      margin: 25px auto 0;\n      transform-style: preserve-3d;\n      transition: transform .68s cubic-bezier(.18, .78, .22, 1);\n    }\n\n    .vld-time.is-open .watch-body {\n      transform: translate(var(--open-shift), -6px) scale(.9);\n    }\n\n    .vld-time .bow {\n      position: absolute;\n      z-index: 1;\n      top: -25px;\n      left: 50%;\n      display: block;\n      width: 54px;\n      height: 45px;\n      border: 8px solid #777d79;\n      border-bottom-color: #313a3b;\n      border-radius: 49% 51% 42% 43%;\n      background: transparent;\n      box-shadow:\n        inset 0 0 0 2px rgba(255, 255, 255, .11),\n        0 3px 7px rgba(0, 0, 0, .6);\n      transform: translateX(-50%);\n    }\n\n    .vld-time .bow::before,\n    .vld-time .bow::after {\n      content: \"\";\n      position: absolute;\n      bottom: -12px;\n      width: 13px;\n      height: 18px;\n      border-radius: 4px;\n      background: linear-gradient(90deg, #30383a, #a0a59f 47%, #333b3c);\n    }\n\n    .vld-time .bow::before { left: -6px; transform: rotate(13deg); }\n    .vld-time .bow::after { right: -6px; transform: rotate(-13deg); }\n\n    .vld-time .bow > i {\n      position: absolute;\n      inset: 5px;\n      display: block;\n      border: 1px solid rgba(0, 0, 0, .8);\n      border-radius: inherit;\n    }\n\n    .vld-time .crown {\n      position: absolute;\n      z-index: 7;\n      top: -3px;\n      left: calc(50% + 39px);\n      display: flex;\n      width: 35px;\n      height: 22px;\n      align-items: stretch;\n      justify-content: center;\n      overflow: hidden;\n      border: 1px solid #1e2627;\n      border-radius: 5px 9px 9px 5px;\n      background: linear-gradient(180deg, #a4aaa5, #4d5756 48%, #222a2c 52%, #79817d);\n      box-shadow: inset 0 1px rgba(255, 255, 255, .17), 2px 3px 5px rgba(0, 0, 0, .46);\n      transform: translateX(0);\n      will-change: transform;\n    }\n\n    .vld-time .crown > i {\n      width: 4px;\n      border-left: 1px solid rgba(0, 0, 0, .65);\n      border-right: 1px solid rgba(255, 255, 255, .08);\n      background: linear-gradient(180deg,\n        rgba(255,255,255,.03) 0 18%, rgba(255,255,255,.2) 28%,\n        rgba(0,0,0,.3) 48%, rgba(255,255,255,.08) 68%, rgba(0,0,0,.2) 100%);\n      background-size: 100% 200%;\n    }\n\n    .vld-time.is-running .crown {\n      animation: vld-time-crown-pull 2.3s cubic-bezier(.2, .72, .25, 1) both;\n    }\n\n    .vld-time.is-running .crown > i {\n      animation: vld-time-crown-knurl .16s linear 9;\n    }\n\n    .vld-time.is-running .crown > i:nth-child(2n) {\n      animation-direction: reverse;\n    }\n\n    @keyframes vld-time-crown-pull {\n      0%, 8% { transform: translateX(0); }\n      15%, 74% { transform: translateX(4px); }\n      82% { transform: translateX(-1px); }\n      88% { transform: translateX(1px); }\n      100% { transform: translateX(0); }\n    }\n\n    @keyframes vld-time-crown-knurl {\n      from { background-position: 0 0; }\n      to { background-position: 0 100%; }\n    }\n\n    .vld-time .case-ring {\n      position: absolute;\n      inset: 6px;\n      display: block;\n      border: 1px solid #151b1c;\n      border-radius: 50%;\n      background:\n        repeating-conic-gradient(from 7deg, rgba(255, 255, 255, .11) 0 .7deg, rgba(0, 0, 0, .12) .8deg 1.8deg),\n        radial-gradient(circle at 35% 24%, #c4c7bf 0 4%, #676f6c 16%, #252e30 43%, #8c928c 68%, #242c2d 82%);\n      box-shadow:\n        inset 0 0 0 4px #20292b,\n        inset 0 0 0 6px rgba(195, 202, 195, .4),\n        inset 0 0 0 11px #111719,\n        inset 0 0 26px 13px rgba(255, 255, 255, .09),\n        0 8px 17px rgba(0, 0, 0, .58),\n        0 0 0 1px rgba(255, 255, 255, .08);\n      transform-style: preserve-3d;\n    }\n\n    .vld-time .case-ring::before {\n      content: \"\";\n      position: absolute;\n      z-index: 0;\n      inset: 13px;\n      border-radius: 50%;\n      background: #080c0d;\n      box-shadow: inset 0 0 0 2px #5c6461, inset 0 0 13px #000;\n    }\n\n    .vld-time .timepiece {\n      --hour-angle: 0deg;\n      --minute-angle: 0deg;\n      position: absolute;\n      z-index: 2;\n      inset: 18px;\n      display: block;\n      overflow: hidden;\n      border: 1px solid #111718;\n      border-radius: 50%;\n      background:\n        radial-gradient(circle at 50% 47%, transparent 0 30%, rgba(0, 0, 0, .18) 67%, rgba(0, 0, 0, .72) 100%),\n        radial-gradient(circle at 31% 20%, color-mix(in srgb, var(--phase-soft) 76%, #ddd) 0, var(--phase-soft) 22%, #182022 61%, #0d1214 100%);\n      box-shadow:\n        inset 0 0 0 2px rgba(224, 221, 197, .12),\n        inset 0 0 18px rgba(0, 0, 0, .8),\n        0 0 0 1px #0b0f10;\n    }\n\n    .vld-time .dial-grain {\n      position: absolute;\n      inset: 9px;\n      display: block;\n      border-radius: 50%;\n      background:\n        repeating-radial-gradient(ellipse at 50% 54%, transparent 0 4px, rgba(220, 222, 209, .022) 4.5px 5px),\n        repeating-conic-gradient(from 23deg, rgba(255, 255, 255, .035) 0 .55deg, transparent .6deg 3deg);\n      opacity: .84;\n      mix-blend-mode: screen;\n      transform: translate(var(--dial-x), var(--dial-y)) scale(1.02);\n      transition: transform .18s ease-out;\n    }\n\n    .vld-time .timepiece::after {\n      content: \"\";\n      position: absolute;\n      z-index: 5;\n      inset: -28%;\n      border-radius: 50%;\n      background: linear-gradient(112deg,\n        transparent 25%, color-mix(in srgb, var(--phase) 32%, transparent) 43%,\n        rgba(255,255,255,.16) 49%, transparent 62%);\n      mix-blend-mode: screen;\n      opacity: 0;\n      pointer-events: none;\n      transform: translateX(-78%) rotate(8deg);\n    }\n\n    .vld-time.is-running .timepiece::after {\n      animation: vld-time-phase-sweep 1.45s .34s cubic-bezier(.2, .72, .22, 1) both;\n    }\n\n    @keyframes vld-time-phase-sweep {\n      0% { opacity: 0; transform: translateX(-78%) rotate(8deg); }\n      22% { opacity: .72; }\n      72% { opacity: .18; }\n      100% { opacity: 0; transform: translateX(78%) rotate(8deg); }\n    }\n\n    .vld-time .minute-track {\n      position: absolute;\n      inset: 9px;\n      display: block;\n      border-radius: 50%;\n      background: repeating-conic-gradient(from -1deg, rgba(226, 220, 190, .65) 0 .65deg, transparent .7deg 6deg);\n      mask: radial-gradient(circle, transparent 0 86%, #000 86.5% 100%);\n      opacity: .7;\n    }\n\n    .vld-time .minute-track::after {\n      content: \"\";\n      position: absolute;\n      inset: 8px;\n      border: 1px solid rgba(218, 209, 173, .17);\n      border-radius: 50%;\n    }\n\n    .vld-time .chapter {\n      position: absolute;\n      z-index: 3;\n      font: 600 14px/1 var(--serif);\n      color: color-mix(in srgb, var(--light) 82%, #fff);\n      letter-spacing: -.04em;\n      text-shadow: 0 1px #000, 0 0 10px rgba(0, 0, 0, .7);\n    }\n\n    .vld-time .chapter-12 { top: 17px; left: 50%; transform: translateX(-50%); }\n    .vld-time .chapter-3 { top: 50%; right: 17px; transform: translateY(-50%); }\n    .vld-time .chapter-9 { top: 50%; left: 17px; transform: translateY(-50%); }\n\n    .vld-time .maker {\n      position: absolute;\n      z-index: 3;\n      top: 58px;\n      left: 50%;\n      color: rgba(224, 217, 190, .55);\n      font: 600 7px/1 var(--mono);\n      letter-spacing: .28em;\n      text-indent: .28em;\n      text-shadow: 0 1px #000;\n      transform: translateX(-50%);\n    }\n\n    .vld-time .phase-window {\n      position: absolute;\n      z-index: 3;\n      top: 82px;\n      left: 27px;\n      display: block;\n      width: 39px;\n      height: 27px;\n      overflow: hidden;\n      border: 1px solid rgba(212, 203, 172, .33);\n      border-radius: 50%;\n      background: radial-gradient(circle at 50% 115%, var(--phase-soft) 0 24%, #0b171c 52%, #05090b 79%);\n      box-shadow: inset 0 4px 8px #000, 0 1px rgba(255, 255, 255, .08);\n      perspective: 100px;\n    }\n\n    .vld-time .phase-disc {\n      position: absolute;\n      top: -16px;\n      left: -7px;\n      display: block;\n      width: 52px;\n      height: 58px;\n      border-radius: 50%;\n      background:\n        radial-gradient(circle at 50% 22%, color-mix(in srgb, var(--phase) 38%, transparent), transparent 24%),\n        radial-gradient(circle at 50% 78%, rgba(113,137,165,.2), transparent 25%);\n      transform: rotate(var(--phase-turn));\n      transform-origin: 50% 50%;\n    }\n\n    .vld-time.is-running .phase-disc {\n      animation: vld-time-phase-lock 1.35s .16s cubic-bezier(.16, .82, .22, 1) both;\n    }\n\n    @keyframes vld-time-phase-lock {\n      0% { transform: rotate(calc(var(--phase-turn) - 74deg)) scale(.91); filter: brightness(.55); }\n      72% { transform: rotate(calc(var(--phase-turn) + 5deg)) scale(1.025); filter: brightness(1.15); }\n      100% { transform: rotate(var(--phase-turn)) scale(1); filter: brightness(1); }\n    }\n\n    .vld-time .phase-sun,\n    .vld-time .phase-moon {\n      position: absolute;\n      left: 50%;\n      display: block;\n      width: 14px;\n      height: 14px;\n      border-radius: 50%;\n      opacity: 1;\n      transform: translateX(-50%);\n    }\n\n    .vld-time .phase-sun {\n      top: 13px;\n      background: var(--light);\n      box-shadow: 0 0 12px color-mix(in srgb, var(--light) 60%, transparent);\n    }\n\n    .vld-time .phase-moon {\n      bottom: 13px;\n      background: #d8d9c7;\n      box-shadow: inset 4px -1px #82919a, 0 0 10px rgba(202, 216, 224, .42);\n      opacity: 0;\n    }\n\n    .vld-time .phase-stars {\n      position: absolute;\n      right: 8px;\n      bottom: 18px;\n      width: 2px;\n      height: 2px;\n      border-radius: 50%;\n      background: #fff;\n      box-shadow: -24px -2px #fff, -8px -9px #fff, 4px -7px rgba(255,255,255,.72);\n      opacity: 0;\n    }\n\n    .vld-time.phase-night .phase-sun { opacity: 0; }\n    .vld-time.phase-night .phase-moon { opacity: 1; }\n    .vld-time.phase-night .phase-stars { opacity: .78; }\n\n    .vld-time .hand {\n      position: absolute;\n      z-index: 6;\n      top: 50%;\n      left: 50%;\n      display: block;\n      width: 7px;\n      transform-origin: 50% 100%;\n      filter: drop-shadow(1px 2px 1px rgba(0, 0, 0, .8));\n    }\n\n    .vld-time .hand > i {\n      position: absolute;\n      inset: 0;\n      display: block;\n      clip-path: polygon(50% 0, 91% 67%, 63% 100%, 37% 100%, 9% 67%);\n      background: linear-gradient(90deg, #765025, #dfc991 45%, #775027 56%, #c69c5b);\n      box-shadow: inset 1px 0 rgba(255, 255, 255, .23);\n    }\n\n    .vld-time .hour-hand {\n      height: 55px;\n      transform: translate(-50%, -100%) rotate(var(--hour-angle));\n    }\n\n    .vld-time .minute-hand {\n      width: 5px;\n      height: 78px;\n      transform: translate(-50%, -100%) rotate(var(--minute-angle));\n    }\n\n    .vld-time .minute-hand > i {\n      clip-path: polygon(50% 0, 88% 77%, 63% 100%, 37% 100%, 12% 77%);\n      background: linear-gradient(90deg, #b9bbb0, #f0ead0 46%, #6f7775 56%, #d0d0c2);\n    }\n\n    .vld-time .hand-pin {\n      position: absolute;\n      z-index: 7;\n      top: 50%;\n      left: 50%;\n      display: block;\n      width: 15px;\n      height: 15px;\n      border: 2px solid #6d4925;\n      border-radius: 50%;\n      background: radial-gradient(circle at 35% 28%, #f2d99d, #8a5a29 45%, #25170d 72%);\n      box-shadow: 0 2px 3px #000, 0 0 9px rgba(205, 156, 83, .28);\n      transform: translate(-50%, -50%) scale(calc(1 + var(--pin-kick, 0) * .08));\n    }\n\n    .vld-time .digital-time {\n      position: absolute;\n      z-index: 5;\n      top: 38px;\n      left: 50%;\n      display: flex;\n      min-width: 62px;\n      height: 18px;\n      gap: 1px;\n      align-items: center;\n      justify-content: center;\n      border: 1px solid rgba(191, 181, 148, .25);\n      border-radius: 2px;\n      background: rgba(4, 8, 9, .58);\n      box-shadow: inset 0 2px 5px #000, 0 1px rgba(255, 255, 255, .06);\n      color: color-mix(in srgb, var(--light) 80%, white);\n      font: 600 10px/1 var(--mono);\n      letter-spacing: .08em;\n      transform: translateX(-50%);\n    }\n\n    .vld-time .digital-time > i {\n      margin: 0 1px;\n      color: var(--phase);\n      font-style: normal;\n    }\n\n 