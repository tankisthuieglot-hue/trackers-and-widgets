{
 "id": "293939e5-b31e-5976-8ac0-1dfb7211e419",
 "scriptName": "🏆 VLD ACHIEVEMENT · ru",
 "findRegex": "/\\[\\[VLD_ACH(?![A-Z0-9_])(?=[^\\]]*\\|\\s*T\\s*=[ \\t]*([^|\\]<]*)|)(?=[^\\]]*\\|\\s*D\\s*=[ \\t]*([^|\\]<]*)|)(?=[^\\]]*\\|\\s*P\\s*=[ \\t]*([0-9]{0,3})|)(?=[^\\]]*\\|\\s*G\\s*=[ \\t]*(skull|heart|fire|coin|mask|boot|book|knife|bottle|clown)|)[^\\]]*\\]\\]/g",
 "replaceString": "<div class=\"vld-w vld-ach\">\n  <div class=\"toast g-$4 rare-$3\">\n    <div class=\"medal\" aria-hidden=\"true\">\n      <span class=\"ribbons\"></span>\n      <div class=\"badge\"><span class=\"glyph\"></span></div>\n    </div>\n\n    <div class=\"body\">\n      <div class=\"eyebrow\">достижение получено</div>\n      <div class=\"name\">$1</div>\n      <div class=\"how\">$2</div>\n      <div class=\"rate\"><b data-final=\"$3\">$3%</b> <span>игроков получили</span></div>\n    </div>\n  </div>\n  <style>\n    /* Плашка достижения — единственный виджет в паке, который ничего не\n       отслеживает. Он просто громко объявляет, и весь юмор держится на том,\n       что оформление совершенно серьёзное: так же выглядит настоящее уведомление\n       в игре, и именно поэтому «Несущая стена — 1% игроков» смешно.\n\n       Значит и делать надо всерьёз: подскок, блик по корпусу, звёздочки на\n       редком. Стоит пошутить оформлением — шутка исчезнет. */\n\n    .vld-ach {\n      --ink: #eceae5;\n      --dim: #8a8781;\n      --plate: #191a1e;\n      --edge: 168, 146, 88;\n      --rate-color: 154, 150, 142;\n      --hair: rgba(236, 234, 229, .1);\n\n      --sans: ui-sans-serif, system-ui, \"Segoe UI\", Roboto, sans-serif;\n      --mono: ui-monospace, \"Cascadia Mono\", \"Consolas\", \"DejaVu Sans Mono\", monospace;\n\n      width: min(100%, 336px);\n      margin: 14px auto;\n      color: var(--ink);\n      filter: drop-shadow(0 14px 26px rgba(0, 0, 0, .5));\n    }\n\n    .vld-ach * {\n      box-sizing: border-box;\n    }\n\n    .vld-ach .toast {\n      position: relative;\n      overflow: hidden;\n      display: grid;\n      grid-template-columns: 60px minmax(0, 1fr);\n      gap: 9px;\n      min-height: 82px;\n      padding: 9px 11px 9px 9px;\n      border-radius: 3px;\n      background: linear-gradient(100deg, rgba(var(--edge), .14), transparent 42%), var(--plate);\n      box-shadow: inset 0 0 0 1px rgba(var(--edge), .3);\n      /* Прилетает снизу с перелётом и садится — как всплывающее уведомление,\n         а не как абзац текста. */\n      animation: vld-ach-pop .52s cubic-bezier(.18, 1.3, .4, 1) both;\n    }\n\n    @keyframes vld-ach-pop {\n      from { opacity: 0; transform: translateY(16px) scale(.97); }\n    }\n\n    /* Один проход блика по корпусу. Ровно один: повторяющийся превратил бы\n       объявление в рекламу. */\n    .vld-ach .toast::after {\n      content: \"\";\n      position: absolute;\n      inset: 0;\n      pointer-events: none;\n      background: linear-gradient(104deg, transparent 42%, rgba(255, 240, 210, .13) 50%, transparent 58%);\n      animation: vld-ach-sweep 1.1s ease-out .28s both;\n    }\n\n    @keyframes vld-ach-sweep {\n      from { transform: translateX(-120%); }\n      to   { transform: translateX(120%); }\n    }\n\n    .vld-ach .medal {\n      position: relative;\n      width: 60px;\n      height: 64px;\n      align-self: center;\n      perspective: 240px;\n      animation: vld-ach-medal .72s cubic-bezier(.17, .88, .32, 1.28) .04s both;\n    }\n\n    @keyframes vld-ach-medal {\n      from {\n        opacity: 0;\n        transform: translateY(-10px) rotateY(-62deg) scale(.72);\n      }\n      62% {\n        transform: translateY(2px) rotateY(13deg) scale(1.055);\n      }\n    }\n\n    .vld-ach .ribbons {\n      position: absolute;\n      inset: 37px 0 0;\n      z-index: 0;\n    }\n\n    .vld-ach .ribbons::before,\n    .vld-ach .ribbons::after {\n      content: \"\";\n      position: absolute;\n      top: 0;\n      width: 17px;\n      height: 25px;\n      background:\n        linear-gradient(90deg, rgba(255, 255, 255, .12), transparent 45%),\n        linear-gradient(180deg, rgba(var(--edge), .8), rgba(var(--edge), .27));\n      clip-path: polygon(0 0, 100% 0, 100% 100%, 52% 76%, 0 100%);\n      box-shadow: inset 0 0 0 1px rgba(var(--edge), .25);\n    }\n\n    .vld-ach .ribbons::before {\n      left: 12px;\n      transform: rotate(9deg);\n    }\n\n    .vld-ach .ribbons::after {\n      right: 12px;\n      transform: rotate(-9deg);\n    }\n\n    .vld-ach .badge {\n      position: absolute;\n      top: 0;\n      left: 3px;\n      z-index: 1;\n      display: grid;\n      place-items: center;\n      width: 54px;\n      height: 54px;\n      overflow: hidden;\n      isolation: isolate;\n      border-radius: 50%;\n      background:\n        conic-gradient(\n          from 18deg,\n          rgba(var(--edge), .32),\n          rgba(255, 242, 199, .26),\n          rgba(var(--edge), .1),\n          rgba(var(--edge), .42),\n          rgba(var(--edge), .16),\n          rgba(255, 242, 199, .2),\n          rgba(var(--edge), .32)\n        ),\n        #24231f;\n      box-shadow:\n        inset 0 0 0 1px rgba(var(--edge), .72),\n        inset 0 0 0 4px rgba(11, 11, 12, .34),\n        inset 0 -7px 13px rgba(0, 0, 0, .28),\n        0 5px 11px rgba(0, 0, 0, .38);\n    }\n\n    .vld-ach .badge::before {\n      content: \"\";\n      position: absolute;\n      inset: 7px;\n      z-index: -1;\n      border-radius: 50%;\n      background:\n        radial-gradient(circle at 36% 28%, rgba(255, 248, 219, .2), transparent 34%),\n        linear-gradient(145deg, rgba(var(--edge), .3), rgba(var(--edge), .07));\n      box-shadow:\n        inset 0 0 0 1px rgba(var(--edge), .5),\n        0 0 0 1px rgba(0, 0, 0, .24);\n    }\n\n    .vld-ach .badge::after {\n      content: \"\";\n      position: absolute;\n      inset: -20%;\n      z-index: 3;\n      pointer-events: none;\n      background: linear-gradient(112deg, transparent 38%, rgba(255, 248, 219, .38) 49%, transparent 60%);\n      transform: translateX(-130%) rotate(-8deg);\n      animation: vld-ach-medal-glint .72s ease-out .46s both;\n    }\n\n    @keyframes vld-ach-medal-glint {\n      to { transform: translateX(130%) rotate(-8deg); }\n    }\n\n    .vld-ach .glyph {\n      position: relative;\n      z-index: 2;\n      font-size: 25px;\n      line-height: 1;\n      filter: saturate(.72) contrast(1.05) drop-shadow(0 1px 1px rgba(0, 0, 0, .45));\n    }\n\n    /* Иконка приезжает словом из закрытого списка, так что подставить сюда\n       произвольную строку модель не может. Не совпало — рамка остаётся пустой,\n       и это выглядит как «иконка не подгрузилась», а не как поломка. */\n    .vld-ach .g-skull  .glyph::before { content: \"💀\"; }\n    .vld-ach .g-heart  .glyph::before { content: \"🫀\"; }\n    .vld-ach .g-fire   .glyph::before { content: \"🔥\"; }\n    .vld-ach .g-coin   .glyph::before { content: \"🪙\"; }\n    .vld-ach .g-mask   .glyph::before { content: \"🎭\"; }\n    .vld-ach .g-boot   .glyph::before { content: \"🥾\"; }\n    .vld-ach .g-book   .glyph::before { content: \"📕\"; }\n    .vld-ach .g-knife  .glyph::before { content: \"🔪\"; }\n    .vld-ach .g-bottle .glyph::before { content: \"🍾\"; }\n    .vld-ach .g-clown  .glyph::before { content: \"🤡\"; }\n\n    .vld-ach .body {\n      min-width: 0;\n      align-self: center;\n    }\n\n    .vld-ach .eyebrow {\n      font: 650 7.5px/1 var(--mono);\n      text-transform: uppercase;\n      letter-spacing: .21em;\n      color: rgb(var(--edge));\n    }\n\n    .vld-ach .name {\n      margin-top: 4px;\n      font: 740 15.75px/1.12 var(--sans);\n      letter-spacing: -.018em;\n    }\n\n    .vld-ach .how {\n      margin-top: 3px;\n      font: 400 11.25px/1.3 var(--sans);\n      color: var(--dim);\n    }\n\n    .vld-ach .rate {\n      margin-top: 5px;\n      font: 400 9.5px/1 var(--mono);\n      letter-spacing: .05em;\n      color: var(--dim);\n    }\n\n    .vld-ach .rate b {\n      font-weight: 700;\n      color: rgb(var(--rate-color));\n      text-shadow: 0 0 12px rgba(var(--rate-color), .22);\n    }\n\n    /* Меньше шести процентов — редкость, и рамка это признаёт. Порог перечислен\n       поимённо, потому что сравнивать числа CSS не умеет, а из закрытого набора\n       значений это дешевле любого скрипта. */\n    .vld-ach .rare-0,\n    .vld-ach .rare-1,\n    .vld-ach .rare-2,\n    .vld-ach .rare-3,\n    .vld-ach .rare-4,\n    .vld-ach .rare-5 {\n      --edge: 212, 172, 78;\n    }\n\n    .vld-ach .rare-0 .badge,\n    .vld-ach .rare-1 .badge,\n    .vld-ach .rare-2 .badge,\n    .vld-ach .rare-3 .badge,\n    .vld-ach .rare-4 .badge,\n    .vld-ach .rare-5 .badge {\n      box-shadow: inset 0 0 0 1px rgba(var(--edge), .75), 0 0 20px rgba(var(--edge), .3);\n      animation: vld-ach-pulse 2.6s ease-in-out 1s infinite;\n    }\n\n    @keyframes vld-ach-pulse {\n      50% { box-shadow: inset 0 0 0 1px rgba(212, 172, 78, 1), 0 0 30px rgba(212, 172, 78, .5); }\n    }\n\n    /* Процент не пришёл — строку не показывать, а не писать «%». */\n    .vld-ach .rate:has(b:empty) {\n      display: none;\n    }\n\n    .vld-ach .toast:has(.name:empty) {\n      display: none;\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      .vld-ach .toast,\n      .vld-ach .medal,\n      .vld-ach .badge,\n      .vld-ach .rare-0 .badge,\n      .vld-ach .rare-1 .badge,\n      .vld-ach .rare-2 .badge,\n      .vld-ach .rare-3 .badge,\n      .vld-ach .rare-4 .badge,\n      .vld-ach .rare-5 .badge {\n        animation: none;\n      }\n\n      .vld-ach .toast::after,\n      .vld-ach .badge::after {\n        display: none;\n      }\n    }\n  </style>\n  <script>\n    (function () {\n      var root = (document.currentScript && document.currentScript.parentElement)\n        || document.querySelector('.vld-ach:not([data-vld-init])');\n      if (!root || root.dataset.vldInit === '1') return;\n      root.dataset.vldInit = '1';\n      var rate = root.querySelector('.rate b');\n      var finalRate = parseInt(rate && rate.dataset.final, 10);\n      var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n      var COUNT_DELAY = 220;\n      var COUNT_DURATION = 900;\n      var countTimer = 0;\n      var countFrame = 0;\n      var countStartedAt = 0;\n\n      if (!isNaN(finalRate)) {\n        setRateColor(finalRate);\n\n        if (reduced) {\n          paintCount(Infinity);\n        } else {\n          startCount();\n        }\n      }\n\n      // The recorder owns a deterministic clock. In SillyTavern this is never\n      // called; the same paint function runs from requestAnimationFrame instead.\n      root.vldSeek = function (ms) {\n        stopCount();\n        paintCount(Number(ms) || 0);\n      };\n\n      function startCount() {\n        rate.textContent = '0%';\n        countTimer = setTimeout(function () {\n          countTimer = 0;\n          countStartedAt = performance.now();\n          countFrame = requestAnimationFrame(stepCount);\n        }, COUNT_DELAY);\n      }\n\n      function stepCount(now) {\n        if (!root.isConnected) {\n          countFrame = 0;\n          return;\n        }\n\n        var elapsed = COUNT_DELAY + now - countStartedAt;\n        paintCount(elapsed);\n\n        if (elapsed < COUNT_DELAY + COUNT_DURATION) {\n          countFrame = requestAnimationFrame(stepCount);\n        } else {\n          countFrame = 0;\n        }\n      }\n\n      function paintCount(ms) {\n        var progress = Math.max(0, Math.min(1, (ms - COUNT_DELAY) / COUNT_DURATION));\n        var eased = 1 - Math.pow(1 - progress, 2);\n        var shown = ms === Infinity ? finalRate : Math.round(finalRate * eased);\n        rate.textContent = String(shown) + '%';\n      }\n\n      function setRateColor(value) {\n        var color = value <= 5\n          ? '239, 195, 92'\n          : value <= 15\n            ? '213, 159, 98'\n            : value <= 35\n              ? '137, 169, 188'\n              : '154, 150, 142';\n\n        root.style.setProperty('--rate-color', color);\n      }\n\n      function stopCount() {\n        if (countTimer) clearTimeout(countTimer);\n        if (countFrame) cancelAnimationFrame(countFrame);\n        countTimer = 0;\n        countFrame = 0;\n      }\n    })();\n  </script>\n</div>",
