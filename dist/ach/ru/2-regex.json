{
 "id": "293939e5-b31e-5976-8ac0-1dfb7211e419",
 "scriptName": "🏆 VLD ACHIEVEMENT · ru",
 "findRegex": "/\\[\\[VLD_ACH(?![A-Z0-9_])(?=[^\\]]*\\|\\s*T\\s*=[ \\t]*([^|\\]<]*)|)(?=[^\\]]*\\|\\s*D\\s*=[ \\t]*([^|\\]<]*)|)(?=[^\\]]*\\|\\s*P\\s*=[ \\t]*([0-9]{0,3})|)(?=[^\\]]*\\|\\s*G\\s*=[ \\t]*(skull|heart|fire|coin|mask|boot|book|knife|bottle|clown)|)[^\\]]*\\]\\]/g",
 "replaceString": "<div class=\"vld-w vld-ach\">\n  <div class=\"toast g-$4 rare-$3\">\n    <div class=\"badge\"><span class=\"glyph\"></span></div>\n\n    <div class=\"body\">\n      <div class=\"eyebrow\">достижение получено</div>\n      <div class=\"name\">$1</div>\n      <div class=\"how\">$2</div>\n      <div class=\"rate\"><b>$3%</b> <span>игроков получили</span></div>\n    </div>\n  </div>\n  <style>\n    /* Плашка достижения — единственный виджет в паке, который ничего не\n       отслеживает. Он просто громко объявляет, и весь юмор держится на том,\n       что оформление совершенно серьёзное: так же выглядит настоящее уведомление\n       в игре, и именно поэтому «Несущая стена — 1% игроков» смешно.\n\n       Значит и делать надо всерьёз: подскок, блик по корпусу, звёздочки на\n       редком. Стоит пошутить оформлением — шутка исчезнет. */\n\n    .vld-ach {\n      --ink: #eceae5;\n      --dim: #8a8781;\n      --plate: #191a1e;\n      --edge: 168, 146, 88;\n      --hair: rgba(236, 234, 229, .1);\n\n      --sans: ui-sans-serif, system-ui, \"Segoe UI\", Roboto, sans-serif;\n      --mono: ui-monospace, \"Cascadia Mono\", \"Consolas\", \"DejaVu Sans Mono\", monospace;\n\n      width: min(100%, 356px);\n      margin: 14px auto;\n      color: var(--ink);\n      filter: drop-shadow(0 14px 26px rgba(0, 0, 0, .5));\n    }\n\n    .vld-ach * {\n      box-sizing: border-box;\n    }\n\n    .vld-ach .toast {\n      position: relative;\n      overflow: hidden;\n      display: grid;\n      grid-template-columns: 54px 1fr;\n      gap: 12px;\n      padding: 11px 13px 11px 11px;\n      border-radius: 3px;\n      background: linear-gradient(100deg, rgba(var(--edge), .14), transparent 42%), var(--plate);\n      box-shadow: inset 0 0 0 1px rgba(var(--edge), .3);\n      /* Прилетает снизу с перелётом и садится — как всплывающее уведомление,\n         а не как абзац текста. */\n      animation: vld-ach-pop .52s cubic-bezier(.18, 1.3, .4, 1) both;\n    }\n\n    @keyframes vld-ach-pop {\n      from { opacity: 0; transform: translateY(16px) scale(.97); }\n    }\n\n    /* Один проход блика по корпусу. Ровно один: повторяющийся превратил бы\n       объявление в рекламу. */\n    .vld-ach .toast::after {\n      content: \"\";\n      position: absolute;\n      inset: 0;\n      pointer-events: none;\n      background: linear-gradient(104deg, transparent 42%, rgba(255, 240, 210, .13) 50%, transparent 58%);\n      animation: vld-ach-sweep 1.1s ease-out .28s both;\n    }\n\n    @keyframes vld-ach-sweep {\n      from { transform: translateX(-120%); }\n      to   { transform: translateX(120%); }\n    }\n\n    .vld-ach .badge {\n      display: grid;\n      place-items: center;\n      width: 54px;\n      height: 54px;\n      border-radius: 3px;\n      background: linear-gradient(155deg, rgba(var(--edge), .26), rgba(var(--edge), .07));\n      box-shadow: inset 0 0 0 1px rgba(var(--edge), .45);\n    }\n\n    .vld-ach .glyph {\n      font-size: 25px;\n      line-height: 1;\n      filter: saturate(.85);\n    }\n\n    /* Иконка приезжает словом из закрытого списка, так что подставить сюда\n       произвольную строку модель не может. Не совпало — рамка остаётся пустой,\n       и это выглядит как «иконка не подгрузилась», а не как поломка. */\n    .vld-ach .g-skull  .glyph::before { content: \"💀\"; }\n    .vld-ach .g-heart  .glyph::before { content: \"🫀\"; }\n    .vld-ach .g-fire   .glyph::before { content: \"🔥\"; }\n    .vld-ach .g-coin   .glyph::before { content: \"🪙\"; }\n    .vld-ach .g-mask   .glyph::before { content: \"🎭\"; }\n    .vld-ach .g-boot   .glyph::before { content: \"🥾\"; }\n    .vld-ach .g-book   .glyph::before { content: \"📕\"; }\n    .vld-ach .g-knife  .glyph::before { content: \"🔪\"; }\n    .vld-ach .g-bottle .glyph::before { content: \"🍾\"; }\n    .vld-ach .g-clown  .glyph::before { content: \"🤡\"; }\n\n    .vld-ach .body {\n      min-width: 0;\n      align-self: center;\n    }\n\n    .vld-ach .eyebrow {\n      font: 600 8px/1 var(--mono);\n      text-transform: uppercase;\n      letter-spacing: .21em;\n      color: rgb(var(--edge));\n    }\n\n    .vld-ach .name {\n      margin-top: 5px;\n      font: 700 14.5px/1.2 var(--sans);\n      letter-spacing: -.01em;\n    }\n\n    .vld-ach .how {\n      margin-top: 3px;\n      font: 400 11.5px/1.35 var(--sans);\n      color: var(--dim);\n    }\n\n    .vld-ach .rate {\n      margin-top: 6px;\n      font: 400 9.5px/1 var(--mono);\n      letter-spacing: .05em;\n      color: var(--dim);\n    }\n\n    .vld-ach .rate b {\n      font-weight: 600;\n      color: rgba(236, 234, 229, .78);\n    }\n\n    /* Меньше шести процентов — редкость, и рамка это признаёт. Порог перечислен\n       поимённо, потому что сравнивать числа CSS не умеет, а из закрытого набора\n       значений это дешевле любого скрипта. */\n    .vld-ach .rare-0,\n    .vld-ach .rare-1,\n    .vld-ach .rare-2,\n    .vld-ach .rare-3,\n    .vld-ach .rare-4,\n    .vld-ach .rare-5 {\n      --edge: 212, 172, 78;\n    }\n\n    .vld-ach .rare-0 .badge,\n    .vld-ach .rare-1 .badge,\n    .vld-ach .rare-2 .badge,\n    .vld-ach .rare-3 .badge,\n    .vld-ach .rare-4 .badge,\n    .vld-ach .rare-5 .badge {\n      box-shadow: inset 0 0 0 1px rgba(var(--edge), .75), 0 0 20px rgba(var(--edge), .3);\n      animation: vld-ach-pulse 2.6s ease-in-out 1s infinite;\n    }\n\n    @keyframes vld-ach-pulse {\n      50% { box-shadow: inset 0 0 0 1px rgba(212, 172, 78, 1), 0 0 30px rgba(212, 172, 78, .5); }\n    }\n\n    /* Процент не пришёл — строку не показывать, а не писать «%». */\n    .vld-ach .rate:has(b:empty) {\n      display: none;\n    }\n\n    .vld-ach .toast:has(.name:empty) {\n      display: none;\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      .vld-ach .toast,\n      .vld-ach .badge,\n      .vld-ach .rare-0 .badge,\n      .vld-ach .rare-1 .badge,\n      .vld-ach .rare-2 .badge,\n      .vld-ach .rare-3 .badge,\n      .vld-ach .rare-4 .badge,\n      .vld-ach .rare-5 .badge {\n        animation: none;\n      }\n\n      .vld-ach .toast::after {\n        display: none;\n      }\n    }\n  </style>\n</div>",
