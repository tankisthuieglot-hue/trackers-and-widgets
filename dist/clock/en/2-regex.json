{
 "id": "e96042d6-9c6d-5213-9f52-4fc65200ddf0",
 "scriptName": "🕛 VLD CLOCK · en",
 "findRegex": "/\\[\\[VLD_CLOCK(?![A-Z0-9_])(?=[^\\]]*\\|\\s*T\\s*=[ \\t]*([^|\\]<]*)|)(?=[^\\]]*\\|\\s*F\\s*=[ \\t]*([0-9]{0,3})|)(?=[^\\]]*\\|\\s*S\\s*=[ \\t]*([0-9]{0,3})|)(?=[^\\]]*\\|\\s*W\\s*=[ \\t]*([^|\\]<]*)|)(?=[^\\]]*\\|\\s*L\\s*=[ \\t]*([^|\\]<]*)|)[^\\]]*\\]\\]/g",
 "replaceString": "<div class=\"vld-w vld-clock\">\n  <div class=\"unit s-$3 f-$2\">\n    <div class=\"dial\">\n      <span class=\"fill\"></span>\n      <span class=\"spokes\"></span>\n      <span class=\"impact\"></span>\n      <span class=\"hand\"></span>\n      <span class=\"hub\"><b>$2</b><em>/$3</em></span>\n    </div>\n\n    <div class=\"text\">\n      <div class=\"threat\">$1</div>\n\n      <div class=\"then\">\n        <span class=\"k\">then</span>\n        <span class=\"v\">$4</span>\n      </div>\n\n      <div class=\"last\">$5</div>\n      <div class=\"siren\">out of time</div>\n    </div>\n  </div>\n  <style>\n    /* Часы из настольных ролевых: угроза, которая не решается одной сценой, а\n       набирается делениями. Круг выбран не для красоты — заполненный сектор\n       виден целиком, и сразу понятно не «сколько прошло», а «сколько осталось».\n       Полоска этого не даёт: у неё нет конца в поле зрения.\n\n       Доля закрашенного зависит сразу от двух чисел, поэтому угол поворота задан\n       парами классов s-N f-M. Явно, зато браузер считает сам и модель не может\n       прислать угол, которого не бывает. */\n\n    .vld-clock {\n      --ink: #e9e7e2;\n      --dim: #86847f;\n      --plate: #17181b;\n      --hair: rgba(233, 231, 226, .1);\n\n      --cool: 112, 148, 176;\n      --hot: 206, 148, 72;\n      --crit: 206, 78, 78;\n\n      --mono: ui-monospace, \"Cascadia Mono\", \"Consolas\", \"DejaVu Sans Mono\", monospace;\n      --sans: ui-sans-serif, system-ui, \"Segoe UI\", Roboto, sans-serif;\n\n      width: min(100%, 350px);\n      margin: 14px auto;\n      color: var(--ink);\n      filter: drop-shadow(0 12px 26px rgba(0, 0, 0, .45));\n    }\n\n    .vld-clock * {\n      box-sizing: border-box;\n    }\n\n    .vld-clock .unit {\n      --turn: 0deg;\n      --seg: 60deg;\n      --tone: var(--cool);\n      --live-turn: var(--turn);\n      --hand-turn: var(--turn);\n      --impact: 0;\n      --kick-y: 0px;\n      --kick-r: 0deg;\n\n      display: grid;\n      grid-template-columns: 78px 1fr;\n      gap: 14px;\n      align-items: center;\n      padding: 14px;\n      border-radius: 3px;\n      background: var(--plate);\n      box-shadow: inset 0 0 0 1px var(--hair);\n      animation: vld-clock-in .32s ease both;\n    }\n\n    @keyframes vld-clock-in {\n      from { opacity: 0; }\n    }\n\n    .vld-clock .dial {\n      position: relative;\n      width: 78px;\n      height: 78px;\n      border-radius: 50%;\n      background: rgba(233, 231, 226, .045);\n      box-shadow: inset 0 0 0 1px rgba(233, 231, 226, .16);\n      transform: translateY(var(--kick-y)) rotate(var(--kick-r));\n      transform-origin: 50% 56%;\n      will-change: transform;\n    }\n\n    .vld-clock .fill {\n      position: absolute;\n      inset: 3px;\n      border-radius: 50%;\n      z-index: 0;\n      background:\n        radial-gradient(circle at 48% 28%, rgba(255, 255, 255, .13), transparent 38%),\n        conic-gradient(rgba(var(--tone), .86) var(--live-turn), transparent 0);\n    }\n\n    /* Спицы режут круг на деления. Шаг приезжает переменной, поэтому правило\n       одно на все три размера циферблата. */\n    .vld-clock .spokes {\n      position: absolute;\n      inset: 0;\n      z-index: 1;\n      border-radius: 50%;\n      background: repeating-conic-gradient(\n        from 0deg,\n        var(--plate) 0 1.6deg,\n        transparent 1.6deg var(--seg));\n    }\n\n    .vld-clock .impact {\n      position: absolute;\n      inset: -3px;\n      z-index: 2;\n      border: 1px solid rgba(var(--tone), .9);\n      border-radius: 50%;\n      opacity: var(--impact);\n      transform: scale(calc(1 + var(--impact) * .13));\n      box-shadow: 0 0 18px rgba(var(--tone), calc(var(--impact) * .45));\n      pointer-events: none;\n    }\n\n    /* A full-size rotating carrier keeps the needle's pivot exactly in the centre.\n       Only its upper half is painted, so it reads as a scanner rather than a hand\n       on an ordinary wall clock. */\n    .vld-clock .hand {\n      position: absolute;\n      inset: 7px;\n      z-index: 3;\n      border-radius: 50%;\n      transform: rotate(var(--hand-turn));\n      transform-origin: 50% 50%;\n      pointer-events: none;\n      will-change: transform;\n    }\n\n    .vld-clock .hand::before {\n      content: \"\";\n      position: absolute;\n      top: 0;\n      bottom: 50%;\n      left: 50%;\n      width: 2px;\n      border-radius: 2px 2px 0 0;\n      background: linear-gradient(\n        90deg,\n        rgba(255, 255, 255, .76),\n        rgb(var(--tone)) 58%,\n        rgba(var(--tone), .28)\n      );\n      box-shadow: 0 0 7px rgba(var(--tone), .72);\n      transform: translateX(-50%);\n    }\n\n    .vld-clock .hand::after {\n      content: \"\";\n      position: absolute;\n      top: -1px;\n      left: 50%;\n      width: 5px;\n      height: 5px;\n      border-radius: 50%;\n      background: rgb(var(--tone));\n      box-shadow: 0 0 8px rgba(var(--tone), .85);\n      transform: translateX(-50%);\n    }\n\n    .vld-clock .hub {\n      position: absolute;\n      inset: 21px;\n      z-index: 4;\n      display: grid;\n      place-content: center;\n      border-radius: 50%;\n      background: var(--plate);\n      box-shadow: 0 0 0 1px rgba(233, 231, 226, .1);\n      font: 500 13px/1 var(--mono);\n      font-variant-numeric: tabular-nums;\n      text-align: center;\n    }\n\n    .vld-clock .hub em {\n      font: 400 9px/1 var(--mono);\n      font-style: normal;\n      color: var(--dim);\n    }\n\n    /* Шаг деления — по числу сегментов. */\n    .vld-clock .s-4 { --seg: 90deg; }\n    .vld-clock .s-6 { --seg: 60deg; }\n    .vld-clock .s-8 { --seg: 45deg; }\n\n    /* Угол и тревожность разом. Тон повышается на двух третях и краснеет на\n       полном круге: цвет должен опережать чтение цифры. */\n    .vld-clock .s-4.f-0 { --turn: 0deg; }\n    .vld-clock .s-4.f-1 { --turn: 90deg; }\n    .vld-clock .s-4.f-2 { --turn: 180deg; }\n    .vld-clock .s-4.f-3 { --turn: 270deg; --tone: var(--hot); }\n    .vld-clock .s-4.f-4 { --turn: 360deg; --tone: var(--crit); }\n\n    .vld-clock .s-6.f-0 { --turn: 0deg; }\n    .vld-clock .s-6.f-1 { --turn: 60deg; }\n    .vld-clock .s-6.f-2 { --turn: 120deg; }\n    .vld-clock .s-6.f-3 { --turn: 180deg; }\n    .vld-clock .s-6.f-4 { --turn: 240deg; --tone: var(--hot); }\n    .vld-clock .s-6.f-5 { --turn: 300deg; --tone: var(--hot); }\n    .vld-clock .s-6.f-6 { --turn: 360deg; --tone: var(--crit); }\n\n    .vld-clock .s-8.f-0 { --turn: 0deg; }\n    .vld-clock .s-8.f-1 { --turn: 45deg; }\n    .vld-clock .s-8.f-2 { --turn: 90deg; }\n    .vld-clock .s-8.f-3 { --turn: 135deg; }\n    .vld-clock .s-8.f-4 { --turn: 180deg; }\n    .vld-clock .s-8.f-5 { --turn: 225deg; --tone: var(--hot); }\n    .vld-clock .s-8.f-6 { --turn: 270deg; --tone: var(--hot); }\n    .vld-clock .s-8.f-7 { --turn: 315deg; --tone: var(--hot); }\n    .vld-clock .s-8.f-8 { --turn: 360deg; --tone: var(--crit); }\n\n    /* Круг замкнулся — циферблат дышит красным, и это единственное место в\n       виджете, где движение не декоративное. */\n    .vld-clock .s-4.f-4.is-settled .dial,\n    .vld-clock .s-6.f-6.is-settled .dial,\n    .vld-clock .s-8.f-8.is-settled .dial {\n      animation: vld-clock-alarm 1.4s ease-in-out infinite;\n    }\n\n    @keyframes vld-clock-alarm {\n      50% { box-shadow: inset 0 0 0 1px rgba(206, 78, 78, .9), 0 0 22px rgba(206, 78, 78, .45); }\n    }\n\n    .vld-clock .text {\n      min-width: 0;\n    }\n\n    .vld-clock .threat {\n      font: 600 13.5px/1.3 var(--sans);\n    }\n\n    .vld-clock .then {\n      display: grid;\n      grid-template-columns: auto 1fr;\n      gap: 7px;\n      align-items: baseline;\n      margin-top: 8px;\n      padding-top: 8px;\n      border-top: 1px solid var(--hair);\n    }\n\n    .vld-clock .k {\n      font: 400 8.5px/1.5 var(--mono);\n      text-transform: uppercase;\n      letter-spacing: .13em;\n      color: var(--dim);\n    }\n\n    .vld-clock .v {\n      font: 400 12px/1.35 var(--sans);\n      color: rgb(var(--tone));\n    }\n\n    .vld-clock .last {\n      margin-top: 7px;\n      padding-left: 9px;\n      border-left: 2px solid rgba(233, 231, 226, .14);\n      font: 400 11px/1.35 var(--mono);\n      color: var(--dim);\n    }\n\n    /* Надпись про вышедшее время появляется ровно на полном круге. */\n    .vld-clock .siren {\n      display: none;\n      margin-top: 8px;\n      font: 600 9px/1 var(--mono);\n      text-transform: uppercase;\n      letter-spacing: .2em;\n      color: rgb(var(--crit));\n    }\n\n    .vld-clock .s-4.f-4.is-settled .siren,\n    .vld-clock .s-6.f-6.is-settled .siren,\n    .vld-clock .s-8.f-8.is-settled .siren {\n      display: block;\n      animation: vld-clock-blink 1.4s steps(1, end) infinite;\n    }\n\n    @keyframes vld-clock-blink {\n      50% { opacity: .25; }\n    }\n\n    .vld-clock .last:empty,\n    .vld-clock .then:has(.v:empty) {\n      display: none;\n    }\n\n    /* Без угрозы и без счёта показывать нечего. */\n    .vld-clock .unit:has(.threat:empty),\n    .vld-clock .unit:has(.hub b:empty) {\n      display: none;\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      .vld-clock .unit,\n      .vld-clock .fill,\n      .vld-clock .dial,\n      .vld-clock .siren {\n        animation: none;\n      }\n    }\n  </style>\n  <script>\n    (function () {\n      var root = (document.currentScript && document.currentScript.parentElement)\n        || document.querySelector('.vld-clock:not([data-vld-init])');\n      if (!root || root.dataset.vldInit === '1') return;\n      root.dataset.vldInit = '1';\n      var unit = root.querySelector('.unit');\n      var counter = unit.querySelector('.hub b');\n      var finalFilled = parseInt(counter.textContent, 10);\n      var totalSegments = parseInt(unit.className.match(/\\bs-(\\d+)\\b/)?.[1], 10);\n      var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n\n      var LEAD = 110;\n      var STEP = 125;\n      var IMPACT = 72;\n      var SETTLE = 110;\n      var duration = LEAD + finalFilled * STEP + SETTLE;\n      var frameId = 0;\n      var startedAt = 0;\n      var runId = 0;\n      var autoTimer = 0;\n      var autoObserver = null;\n\n      var valid = [4, 6, 8].includes(totalSegments)\n        && !isNaN(finalFilled)\n        && finalFilled >= 0\n        && finalFilled <= totalSegments;\n\n      if (valid) {\n        if (reduced || finalFilled === 0) {\n          settle();\n        } else {\n          queueAutomaticRun();\n        }\n      }\n\n      /*\n       * The GIF recorder seeks this same timeline frame by frame. SillyTavern never\n       * calls it; the live widget advances through requestAnimationFrame below.\n       */\n      root.vldSeek = function (ms) {\n        cancelAutomaticStart();\n        if (frameId) cancelAnimationFrame(frameId);\n        frameId = 0;\n        prepare();\n        paintAt(Number(ms) || 0);\n      };\n\n      /*\n       * JS-support can revive the script while the streamed message is still being\n       * morphed. Wait for a short quiet window so the one-shot locks happen after the\n       * final marker has become a stable widget.\n       */\n      function queueAutomaticRun() {\n        var message = root.closest('.mes_text');\n        if (!message || typeof MutationObserver !== 'function') {\n          run();\n          return;\n        }\n\n        function armAfterQuiet() {\n          if (autoTimer) clearTimeout(autoTimer);\n          root.dataset.clockAwaitingSettle = '1';\n          autoTimer = setTimeout(function () {\n            cancelAutomaticStart();\n            if (root.isConnected) run();\n          }, 180);\n        }\n\n        autoObserver = new MutationObserver(armAfterQuiet);\n        autoObserver.observe(message, {\n          childList: true,\n          subtree: true,\n          characterData: true,\n        });\n        armAfterQuiet();\n      }\n\n      function cancelAutomaticStart() {\n        if (autoTimer) clearTimeout(autoTimer);\n        autoTimer = 0;\n        if (autoObserver) autoObserver.disconnect();\n        autoObserver = null;\n        delete root.dataset.clockAwaitingSettle;\n      }\n\n      function run() {\n        if (!valid || reduced || finalFilled === 0) return;\n        if (frameId) cancelAnimationFrame(frameId);\n\n        runId += 1;\n        root.dataset.clockRun = String(runId);\n        startedAt = performance.now();\n        prepare();\n        paintAt(0);\n        frameId = requestAnimationFrame(step);\n      }\n\n      function step(now) {\n        if (!root.isConnected) {\n          frameId = 0;\n          return;\n        }\n\n        var elapsed = now - startedAt;\n        paintAt(elapsed);\n\n        if (elapsed < duration) {\n          frameId = requestAnimationFrame(step);\n        } else {\n          frameId = 0;\n        }\n      }\n\n      function prepare() {\n        unit.classList.add('is-running');\n        unit.classList.remove('is-settled');\n      }\n\n      function paintAt(ms) {\n        var time = Math.max(0, Math.min(ms, duration));\n        var elapsed = Math.max(0, time - LEAD);\n        var locked = Math.min(finalFilled, Math.floor(elapsed / STEP));\n        var phase = locked < finalFilled\n          ? Math.max(0, Math.min(1, (elapsed - locked * STEP) / STEP))\n          : 0;\n        var eased = 1 - Math.pow(1 - phase, 3);\n        var segmentAngle = 360 / totalSegments;\n        var fillAngle = locked * segmentAngle;\n        var handAngle = locked < finalFilled\n          ? (locked + eased) * segmentAngle\n          : fillAngle;\n\n        var sinceImpact = elapsed - locked * STEP;\n        var impact = locked > 0 && sinceImpact >= 0 && sinceImpact < IMPACT\n          ? 1 - sinceImpact / IMPACT\n          : 0;\n\n        unit.dataset.locked = String(locked);\n        unit.style.setProperty('--live-turn', angle(fillAngle));\n        unit.style.setProperty('--hand-turn', angle(handAngle));\n        unit.style.setProperty('--impact', impact.toFixed(3));\n        unit.style.setProperty('--kick-y', (impact * 1.8).toFixed(2) + 'px');\n        unit.style.setProperty('--kick-r', (impact * -.85).toFixed(2) + 'deg');\n        counter.textContent = String(locked);\n\n        if (time >= duration) settle();\n      }\n\n      function settle() {\n        if (!valid) return;\n        if (frameId) cancelAnimationFrame(frameId);\n        frameId = 0;\n\n        var finalAngle = 360 * finalFilled / totalSegments;\n        unit.dataset.locked = String(finalFilled);\n        unit.style.setProperty('--live-turn', angle(finalAngle));\n        unit.style.setProperty('--hand-turn', angle(finalAngle));\n        unit.style.setProperty('--impact', '0');\n        unit.style.setProperty('--kick-y', '0px');\n        unit.style.setProperty('--kick-r', '0deg');\n        counter.textContent = String(finalFilled);\n        unit.classList.remove('is-running');\n        unit.classList.add('is-settled');\n      }\n\n      function angle(value) {\n        return String(Math.round(value * 1000) / 1000) + 'deg';\n      }\n    })();\n  </script>\n</div>",
