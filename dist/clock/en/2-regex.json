{
 "id": "e96042d6-9c6d-5213-9f52-4fc65200ddf0",
 "scriptName": "🕛 VLD CLOCK · en",
 "findRegex": "/\\[\\[VLD_CLOCK(?![A-Z0-9_])(?=[^\\]]*\\|\\s*T\\s*=[ \\t]*([^|\\]<]*)|)(?=[^\\]]*\\|\\s*F\\s*=[ \\t]*([0-9]{0,3})|)(?=[^\\]]*\\|\\s*S\\s*=[ \\t]*([0-9]{0,3})|)(?=[^\\]]*\\|\\s*W\\s*=[ \\t]*([^|\\]<]*)|)(?=[^\\]]*\\|\\s*L\\s*=[ \\t]*([^|\\]<]*)|)[^\\]]*\\]\\]/g",
 "replaceString": "<div class=\"vld-w vld-clock\">\n  <div class=\"unit s-$3 f-$2\">\n    <div class=\"dial\">\n      <span class=\"fill\"></span>\n      <span class=\"spokes\"></span>\n      <span class=\"hub\"><b>$2</b><em>/$3</em></span>\n    </div>\n\n    <div class=\"text\">\n      <div class=\"threat\">$1</div>\n\n      <div class=\"then\">\n        <span class=\"k\">then</span>\n        <span class=\"v\">$4</span>\n      </div>\n\n      <div class=\"last\">$5</div>\n      <div class=\"siren\">out of time</div>\n    </div>\n  </div>\n  <style>\n    /* Часы из настольных ролевых: угроза, которая не решается одной сценой, а\n       набирается делениями. Круг выбран не для красоты — заполненный сектор\n       виден целиком, и сразу понятно не «сколько прошло», а «сколько осталось».\n       Полоска этого не даёт: у неё нет конца в поле зрения.\n\n       Доля закрашенного зависит сразу от двух чисел, поэтому угол поворота задан\n       парами классов s-N f-M. Явно, зато браузер считает сам и модель не может\n       прислать угол, которого не бывает. */\n\n    .vld-clock {\n      --ink: #e9e7e2;\n      --dim: #86847f;\n      --plate: #17181b;\n      --hair: rgba(233, 231, 226, .1);\n\n      --cool: 112, 148, 176;\n      --hot: 206, 148, 72;\n      --crit: 206, 78, 78;\n\n      --mono: ui-monospace, \"Cascadia Mono\", \"Consolas\", \"DejaVu Sans Mono\", monospace;\n      --sans: ui-sans-serif, system-ui, \"Segoe UI\", Roboto, sans-serif;\n\n      width: min(100%, 350px);\n      margin: 14px auto;\n      color: var(--ink);\n      filter: drop-shadow(0 12px 26px rgba(0, 0, 0, .45));\n    }\n\n    .vld-clock * {\n      box-sizing: border-box;\n    }\n\n    .vld-clock .unit {\n      --turn: 0deg;\n      --seg: 60deg;\n      --tone: var(--cool);\n\n      display: grid;\n      grid-template-columns: 78px 1fr;\n      gap: 14px;\n      align-items: center;\n      padding: 14px;\n      border-radius: 3px;\n      background: var(--plate);\n      box-shadow: inset 0 0 0 1px var(--hair);\n      animation: vld-clock-in .32s ease both;\n    }\n\n    @keyframes vld-clock-in {\n      from { opacity: 0; }\n    }\n\n    .vld-clock .dial {\n      position: relative;\n      width: 78px;\n      height: 78px;\n      border-radius: 50%;\n      background: rgba(233, 231, 226, .045);\n      box-shadow: inset 0 0 0 1px rgba(233, 231, 226, .16);\n    }\n\n    .vld-clock .fill {\n      position: absolute;\n      inset: 3px;\n      border-radius: 50%;\n      background: conic-gradient(rgba(var(--tone), .82) var(--turn), transparent 0);\n      animation: vld-clock-sweep .8s cubic-bezier(.3, .8, .3, 1) both;\n    }\n\n    /* Сектор набирается от нуля до своего угла — видно, что часы именно\n       заполнились, а не были такими всегда. */\n    @keyframes vld-clock-sweep {\n      from { background: conic-gradient(rgba(var(--tone), .82) 0deg, transparent 0); }\n    }\n\n    /* Спицы режут круг на деления. Шаг приезжает переменной, поэтому правило\n       одно на все три размера циферблата. */\n    .vld-clock .spokes {\n      position: absolute;\n      inset: 0;\n      border-radius: 50%;\n      background: repeating-conic-gradient(\n        from 0deg,\n        var(--plate) 0 1.6deg,\n        transparent 1.6deg var(--seg));\n    }\n\n    .vld-clock .hub {\n      position: absolute;\n      inset: 21px;\n      display: grid;\n      place-content: center;\n      border-radius: 50%;\n      background: var(--plate);\n      box-shadow: 0 0 0 1px rgba(233, 231, 226, .1);\n      font: 500 13px/1 var(--mono);\n      font-variant-numeric: tabular-nums;\n      text-align: center;\n    }\n\n    .vld-clock .hub em {\n      font: 400 9px/1 var(--mono);\n      font-style: normal;\n      color: var(--dim);\n    }\n\n    /* Шаг деления — по числу сегментов. */\n    .vld-clock .s-4 { --seg: 90deg; }\n    .vld-clock .s-6 { --seg: 60deg; }\n    .vld-clock .s-8 { --seg: 45deg; }\n\n    /* Угол и тревожность разом. Тон повышается на двух третях и краснеет на\n       полном круге: цвет должен опережать чтение цифры. */\n    .vld-clock .s-4.f-0 { --turn: 0deg; }\n    .vld-clock .s-4.f-1 { --turn: 90deg; }\n    .vld-clock .s-4.f-2 { --turn: 180deg; }\n    .vld-clock .s-4.f-3 { --turn: 270deg; --tone: var(--hot); }\n    .vld-clock .s-4.f-4 { --turn: 360deg; --tone: var(--crit); }\n\n    .vld-clock .s-6.f-0 { --turn: 0deg; }\n    .vld-clock .s-6.f-1 { --turn: 60deg; }\n    .vld-clock .s-6.f-2 { --turn: 120deg; }\n    .vld-clock .s-6.f-3 { --turn: 180deg; }\n    .vld-clock .s-6.f-4 { --turn: 240deg; --tone: var(--hot); }\n    .vld-clock .s-6.f-5 { --turn: 300deg; --tone: var(--hot); }\n    .vld-clock .s-6.f-6 { --turn: 360deg; --tone: var(--crit); }\n\n    .vld-clock .s-8.f-0 { --turn: 0deg; }\n    .vld-clock .s-8.f-1 { --turn: 45deg; }\n    .vld-clock .s-8.f-2 { --turn: 90deg; }\n    .vld-clock .s-8.f-3 { --turn: 135deg; }\n    .vld-clock .s-8.f-4 { --turn: 180deg; }\n    .vld-clock .s-8.f-5 { --turn: 225deg; --tone: var(--hot); }\n    .vld-clock .s-8.f-6 { --turn: 270deg; --tone: var(--hot); }\n    .vld-clock .s-8.f-7 { --turn: 315deg; --tone: var(--hot); }\n    .vld-clock .s-8.f-8 { --turn: 360deg; --tone: var(--crit); }\n\n    /* Круг замкнулся — циферблат дышит красным, и это единственное место в\n       виджете, где движение не декоративное. */\n    .vld-clock .s-4.f-4 .dial,\n    .vld-clock .s-6.f-6 .dial,\n    .vld-clock .s-8.f-8 .dial {\n      animation: vld-clock-alarm 1.4s ease-in-out infinite;\n    }\n\n    @keyframes vld-clock-alarm {\n      50% { box-shadow: inset 0 0 0 1px rgba(206, 78, 78, .9), 0 0 22px rgba(206, 78, 78, .45); }\n    }\n\n    .vld-clock .text {\n      min-width: 0;\n    }\n\n    .vld-clock .threat {\n      font: 600 13.5px/1.3 var(--sans);\n    }\n\n    .vld-clock .then {\n      display: grid;\n      grid-template-columns: auto 1fr;\n      gap: 7px;\n      align-items: baseline;\n      margin-top: 8px;\n      padding-top: 8px;\n      border-top: 1px solid var(--hair);\n    }\n\n    .vld-clock .k {\n      font: 400 8.5px/1.5 var(--mono);\n      text-transform: uppercase;\n      letter-spacing: .13em;\n      color: var(--dim);\n    }\n\n    .vld-clock .v {\n      font: 400 12px/1.35 var(--sans);\n      color: rgb(var(--tone));\n    }\n\n    .vld-clock .last {\n      margin-top: 7px;\n      padding-left: 9px;\n      border-left: 2px solid rgba(233, 231, 226, .14);\n      font: 400 11px/1.35 var(--mono);\n      color: var(--dim);\n    }\n\n    /* Надпись про вышедшее время появляется ровно на полном круге. */\n    .vld-clock .siren {\n      display: none;\n      margin-top: 8px;\n      font: 600 9px/1 var(--mono);\n      text-transform: uppercase;\n      letter-spacing: .2em;\n      color: rgb(var(--crit));\n    }\n\n    .vld-clock .s-4.f-4 .siren,\n    .vld-clock .s-6.f-6 .siren,\n    .vld-clock .s-8.f-8 .siren {\n      display: block;\n      animation: vld-clock-blink 1.4s steps(1, end) infinite;\n    }\n\n    @keyframes vld-clock-blink {\n      50% { opacity: .25; }\n    }\n\n    .vld-clock .last:empty,\n    .vld-clock .then:has(.v:empty) {\n      display: none;\n    }\n\n    /* Без угрозы и без счёта показывать нечего. */\n    .vld-clock .unit:has(.threat:empty),\n    .vld-clock .unit:has(.hub b:empty) {\n      display: none;\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      .vld-clock .unit,\n      .vld-clock .fill,\n      .vld-clock .dial,\n      .vld-clock .siren {\n        animation: none;\n      }\n    }\n  </style>\n</div>",
 "trimStrings": [],
