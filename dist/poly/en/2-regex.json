{
 "id": "4b19bb5c-af39-5639-9424-6f8f19e6593d",
 "scriptName": "📉 VLD POLYGRAPH · en",
 "findRegex": "/\\[\\[VLD_POLY(?![A-Z0-9_])(?=[^\\]]*\\|\\s*W\\s*=[ \\t]*([^|\\]<]*)|)(?=[^\\]]*\\|\\s*Q\\s*=[ \\t]*([^|\\]<]*)|)(?=[^\\]]*\\|\\s*V\\s*=[ \\t]*(truth|shade|dodge|lie)|)(?=[^\\]]*\\|\\s*C\\s*=[ \\t]*([0-9]{0,3})|)(?=[^\\]]*\\|\\s*N\\s*=[ \\t]*([^|\\]<]*)|)[^\\]]*\\]\\]/g",
 "replaceString": "<div class=\"vld-w vld-poly\">\n  <div class=\"tape v-$3\">\n    <div class=\"head\">\n      <span class=\"k\">subject</span>\n      <span class=\"who\">$1</span>\n    </div>\n\n    <blockquote class=\"said\">$2</blockquote>\n\n    <div class=\"chart\">\n      <svg class=\"trace\" viewBox=\"0 0 300 44\" preserveAspectRatio=\"none\" aria-hidden=\"true\">\n        <path class=\"tr tr-truth\" d=\"M0 22 20 20 40 24 60 21 80 23 100 20 120 23 140 21 160 24 180 21 200 23 220 20 240 23 260 21 280 23 300 22\"/>\n        <path class=\"tr tr-shade\" d=\"M0 22 25 21 50 23 75 20 100 24 120 13 134 31 150 20 175 23 200 21 225 23 250 20 275 23 300 22\"/>\n        <path class=\"tr tr-dodge\" d=\"M0 22 18 17 34 27 52 15 70 29 88 17 104 27 124 14 142 30 160 18 178 28 196 16 214 28 232 20 250 26 270 18 288 26 300 22\"/>\n        <path class=\"tr tr-lie\" d=\"M0 22 20 21 40 23 60 20 80 24 100 7 112 39 126 5 140 41 154 9 168 35 182 13 200 27 220 20 240 24 260 21 280 23 300 22\"/>\n      </svg>\n      <span class=\"needle\"></span>\n    </div>\n\n    <div class=\"verdict\">\n      <span class=\"stamp\">\n        <span class=\"s-truth\">truthful</span>\n        <span class=\"s-shade\">partial</span>\n        <span class=\"s-dodge\">evasive</span>\n        <span class=\"s-lie\">deceptive</span>\n      </span>\n      <span class=\"conf\">confidence <b>$4</b>%</span>\n    </div>\n\n    <div class=\"tell\">\n      <span class=\"k\">indicator</span>\n      <span class=\"v\">$5</span>\n    </div>\n  </div>\n  <style>\n    /* Единственный светлый виджет в паке, и это намеренно: полиграф — прибор из\n       другого мира, чем панель снаряжения, и в ленте сообщений он должен читаться\n       как вещдок, а не как ещё одна панель.\n\n       Линия самописца нарисована четырьмя путями сразу, показывается один. Так\n       форма кривой приезжает не от модели, а из закрытого списка: подсунуть сюда\n       произвольную геометрию невозможно, а перевод вердикта берётся из подписей\n       виджета и потому на языке читателя. */\n\n    .vld-poly {\n      --paper: #efece3;\n      --ink: #23211c;\n      --dim: #6f6b60;\n      --rule: rgba(35, 33, 28, .16);\n\n      --truth: 74, 124, 82;\n      --shade: 176, 132, 46;\n      --dodge: 168, 106, 42;\n      --lie: 176, 48, 48;\n\n      --mono: ui-monospace, \"Cascadia Mono\", \"Consolas\", \"DejaVu Sans Mono\", monospace;\n      --serif: \"Georgia\", \"Times New Roman\", serif;\n\n      width: min(100%, 348px);\n      margin: 14px auto;\n      color: var(--ink);\n      filter: drop-shadow(0 10px 22px rgba(0, 0, 0, .35));\n    }\n\n    .vld-poly * {\n      box-sizing: border-box;\n    }\n\n    .vld-poly .tape {\n      --tone: var(--dodge);\n\n      position: relative;\n      padding: 13px 15px 12px;\n      background:\n        /* волокно бумаги, чтобы белое не выглядело как пустой div */\n        repeating-linear-gradient(91deg, rgba(35, 33, 28, .014) 0 1px, transparent 1px 4px),\n        var(--paper);\n      animation: vld-poly-in .3s ease both;\n    }\n\n    @keyframes vld-poly-in {\n      from { opacity: 0; }\n    }\n\n    /* Перфорация по краям: лента, а не карточка. */\n    .vld-poly .tape::before,\n    .vld-poly .tape::after {\n      content: \"\";\n      position: absolute;\n      top: 0;\n      bottom: 0;\n      width: 9px;\n      background: radial-gradient(circle 2px at 50% 6px, rgba(0, 0, 0, .3) 98%, transparent) 0 0 / 9px 16px repeat-y;\n      opacity: .32;\n    }\n\n    .vld-poly .tape::before { left: 0; }\n    .vld-poly .tape::after  { right: 0; }\n\n    .vld-poly .v-truth { --tone: var(--truth); }\n    .vld-poly .v-shade { --tone: var(--shade); }\n    .vld-poly .v-dodge { --tone: var(--dodge); }\n    .vld-poly .v-lie   { --tone: var(--lie); }\n\n    .vld-poly .head {\n      display: flex;\n      align-items: baseline;\n      gap: 8px;\n      padding: 0 4px 7px;\n      border-bottom: 1px solid var(--rule);\n    }\n\n    .vld-poly .k {\n      flex: 0 0 auto;\n      font: 400 8px/1.4 var(--mono);\n      text-transform: uppercase;\n      letter-spacing: .16em;\n      color: var(--dim);\n    }\n\n    .vld-poly .who {\n      font: 600 11.5px/1 var(--mono);\n    }\n\n    .vld-poly .said {\n      margin: 9px 4px 0;\n      font: 400 14px/1.4 var(--serif);\n      font-style: italic;\n    }\n\n    .vld-poly .said::before { content: \"«\"; }\n    .vld-poly .said::after  { content: \"»\"; }\n\n    .vld-poly .chart {\n      position: relative;\n      margin: 10px 4px 0;\n      height: 44px;\n      /* Миллиметровка под пером. */\n      background:\n        repeating-linear-gradient(90deg, rgba(35, 33, 28, .07) 0 1px, transparent 1px 15px),\n        repeating-linear-gradient(0deg, rgba(35, 33, 28, .07) 0 1px, transparent 1px 11px),\n        rgba(255, 255, 255, .5);\n      box-shadow: inset 0 0 0 1px var(--rule);\n    }\n\n    .vld-poly .trace {\n      display: block;\n      width: 100%;\n      height: 44px;\n    }\n\n    .vld-poly .tr {\n      display: none;\n      fill: none;\n      stroke: rgb(var(--tone));\n      stroke-width: 1.6;\n      stroke-linejoin: round;\n      vector-effect: non-scaling-stroke;\n    }\n\n    .vld-poly .v-truth .tr-truth,\n    .vld-poly .v-shade .tr-shade,\n    .vld-poly .v-dodge .tr-dodge,\n    .vld-poly .v-lie   .tr-lie {\n      display: block;\n      /* Перо проходит ленту слева направо: длина обводки заведомо больше любой\n         из четырёх кривых, поэтому одно правило годится для всех. */\n      stroke-dasharray: 700;\n      animation: vld-poly-draw 1.5s cubic-bezier(.4, .1, .5, 1) both;\n    }\n\n    @keyframes vld-poly-draw {\n      from { stroke-dashoffset: 700; }\n      to   { stroke-dashoffset: 0; }\n    }\n\n    /* Перо едет вместе с линией и останавливается у правого края. */\n    .vld-poly .needle {\n      position: absolute;\n      top: -3px;\n      bottom: -3px;\n      left: 0;\n      width: 1px;\n      background: rgba(35, 33, 28, .55);\n      animation: vld-poly-pen 1.5s cubic-bezier(.4, .1, .5, 1) both;\n    }\n\n    .vld-poly .needle::after {\n      content: \"\";\n      position: absolute;\n      top: -2px;\n      left: -2.5px;\n      width: 6px;\n      height: 6px;\n      border-radius: 50%;\n      background: rgb(var(--tone));\n    }\n\n    @keyframes vld-poly-pen {\n      to { left: 100%; }\n    }\n\n    .vld-poly .verdict {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 10px;\n      margin: 11px 4px 0;\n    }\n\n    /* Штамп: рамка под углом, как будто приложили. */\n    .vld-poly .stamp {\n      padding: 3px 9px;\n      border: 2px solid rgba(var(--tone), .75);\n      border-radius: 2px;\n      transform: rotate(-2.5deg);\n      font: 700 12px/1 var(--mono);\n      text-transform: uppercase;\n      letter-spacing: .12em;\n      color: rgb(var(--tone));\n      animation: vld-poly-stamp .22s cubic-bezier(.2, 1.5, .4, 1) 1.45s both;\n    }\n\n    @keyframes vld-poly-stamp {\n      from { opacity: 0; transform: rotate(-2.5deg) scale(1.5); }\n    }\n\n    .vld-poly .stamp span {\n      display: none;\n    }\n\n    .vld-poly .v-truth .s-truth,\n    .vld-poly .v-shade .s-shade,\n    .vld-poly .v-dodge .s-dodge,\n    .vld-poly .v-lie   .s-lie {\n      display: inline;\n    }\n\n    /* Показание не совпало со списком — штампа нет вовсе. Прибор скорее промолчит,\n       чем поставит печать наугад. */\n    .vld-poly .tape:not(.v-truth):not(.v-shade):not(.v-dodge):not(.v-lie) .stamp {\n      display: none;\n    }\n\n    .vld-poly .conf {\n      font: 400 9px/1 var(--mono);\n      text-transform: uppercase;\n      letter-spacing: .1em;\n      color: var(--dim);\n    }\n\n    .vld-poly .conf b {\n      font: 600 12px/1 var(--mono);\n      font-variant-numeric: tabular-nums;\n      color: var(--ink);\n    }\n\n    .vld-poly .tell {\n      display: grid;\n      grid-template-columns: auto 1fr;\n      gap: 8px;\n      align-items: baseline;\n      margin: 9px 4px 0;\n      padding-top: 8px;\n      border-top: 1px solid var(--rule);\n    }\n\n    .vld-poly .tell .v {\n      font: 400 11.5px/1.35 var(--mono);\n    }\n\n    .vld-poly .conf:has(b:empty),\n    .vld-poly .tell:has(.v:empty),\n    .vld-poly .head:has(.who:empty) {\n      display: none;\n    }\n\n    .vld-poly .tape:has(.said:empty) {\n      display: none;\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      .vld-poly .tape,\n      .vld-poly .tr,\n      .vld-poly .stamp {\n        animation: none;\n      }\n\n      /* Перо без хода линии выглядит забытым посреди ленты. */\n      .vld-poly .needle {\n        animation: none;\n        left: 100%;\n      }\n\n      .vld-poly .v-truth .tr-truth,\n      .vld-poly .v-shade .tr-shade,\n      .vld-poly .v-dodge .tr-dodge,\n      .vld-poly .v-lie   .tr-lie {\n        stroke-dasharray: none;\n      }\n    }\n  </style>\n</div>",
 "trimStrings": [],
