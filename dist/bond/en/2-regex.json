{
 "id": "296e9bee-a7eb-5fe5-8fbc-7033eb278ab0",
 "scriptName": "🎯 VLD BOND · en",
 "findRegex": "/\\[\\[VLD_BOND(?![A-Z0-9_])(?=[^\\]]*\\|\\s*N1\\s*=[ \\t]*([^|\\]<]*)|)(?=[^\\]]*\\|\\s*W1\\s*=[ \\t]*(10|[0-9])|)(?=[^\\]]*\\|\\s*T1\\s*=[ \\t]*(10|[0-9])|)(?=[^\\]]*\\|\\s*D1\\s*=[ \\t]*([^|\\]<]*)|)(?=[^\\]]*\\|\\s*N2\\s*=[ \\t]*([^|\\]<]*)|)(?=[^\\]]*\\|\\s*W2\\s*=[ \\t]*(10|[0-9])|)(?=[^\\]]*\\|\\s*T2\\s*=[ \\t]*(10|[0-9])|)(?=[^\\]]*\\|\\s*D2\\s*=[ \\t]*([^|\\]<]*)|)(?=[^\\]]*\\|\\s*N3\\s*=[ \\t]*([^|\\]<]*)|)(?=[^\\]]*\\|\\s*W3\\s*=[ \\t]*(10|[0-9])|)(?=[^\\]]*\\|\\s*T3\\s*=[ \\t]*(10|[0-9])|)(?=[^\\]]*\\|\\s*D3\\s*=[ \\t]*([^|\\]<]*)|)[^\\]]*\\]\\]/g",
 "replaceString": "<div class=\"vld-w vld-bond\">\n  <div class=\"board\">\n    <div class=\"cap\">read of the room</div>\n\n    <div class=\"field\">\n      <span class=\"ax ay\">trust</span>\n      <span class=\"ax ax-h\">cold → warm</span>\n\n      <span class=\"pin s1 wx-$2 ty-$3\"><i></i><b>$1</b></span>\n      <span class=\"pin s2 wx-$6 ty-$7\"><i></i><b>$5</b></span>\n      <span class=\"pin s3 wx-$10 ty-$11\"><i></i><b>$9</b></span>\n    </div>\n\n    <ul class=\"tells\">\n      <li class=\"s1\"><em>$1</em><span>$4</span></li>\n      <li class=\"s2\"><em>$5</em><span>$8</span></li>\n      <li class=\"s3\"><em>$9</em><span>$12</span></li>\n    </ul>\n  </div>\n  <style>\n    /* Отношение — не одна величина, поэтому и не шкала. Тепло и доверие ходят\n       врозь: старый друг бывает тёплым и при этом не доверяет ни на грош, а\n       наёмник — холодным и абсолютно надёжным. Шкала такое склеивает в одно\n       число, плоскость — нет.\n\n       Отсюда вид: сетка прицела, три метки, подписи по краям. Читается как\n       радар, а не как анкета. */\n\n    .vld-bond {\n      --ink: #dfe3e8;\n      --dim: #79808c;\n      --plate: #14161a;\n      --hair: rgba(223, 227, 232, .1);\n\n      /* Три метки — три голоса. Цвет ничего не оценивает, он только различает,\n         кто где: оценку целиком несёт положение точки. */\n      --s1: 108, 178, 214;\n      --s2: 206, 158, 92;\n      --s3: 178, 124, 196;\n\n      --mono: ui-monospace, \"Cascadia Mono\", \"Consolas\", \"DejaVu Sans Mono\", monospace;\n\n      width: min(100%, 340px);\n      margin: 14px auto;\n      color: var(--ink);\n      filter: drop-shadow(0 12px 26px rgba(0, 0, 0, .45));\n    }\n\n    .vld-bond * {\n      box-sizing: border-box;\n    }\n\n    .vld-bond .board {\n      padding: 12px 13px 11px;\n      border-radius: 3px;\n      background: var(--plate);\n      box-shadow: inset 0 0 0 1px var(--hair);\n      animation: vld-bond-in .3s ease both;\n    }\n\n    @keyframes vld-bond-in {\n      from { opacity: 0; }\n    }\n\n    .vld-bond .cap {\n      margin-bottom: 10px;\n      font: 400 9px/1 var(--mono);\n      text-transform: uppercase;\n      letter-spacing: .18em;\n      color: var(--dim);\n    }\n\n    /* Поле квадратное: у осей одинаковый вес, и перекос в пропорциях читался бы\n       как перекос в смысле. */\n    .vld-bond .field {\n      position: relative;\n      aspect-ratio: 1;\n      border-radius: 2px;\n      background:\n        /* перекрестье в центре — точка отсчёта, «человек как человек» */\n        linear-gradient(90deg, transparent calc(50% - .5px), rgba(223, 227, 232, .17) calc(50% - .5px) calc(50% + .5px), transparent calc(50% + .5px)),\n        linear-gradient(0deg, transparent calc(50% - .5px), rgba(223, 227, 232, .17) calc(50% - .5px) calc(50% + .5px), transparent calc(50% + .5px)),\n        /* сетка по десятым */\n        repeating-linear-gradient(90deg, rgba(223, 227, 232, .05) 0 1px, transparent 1px 10%),\n        repeating-linear-gradient(0deg, rgba(223, 227, 232, .05) 0 1px, transparent 1px 10%),\n        radial-gradient(circle at 50% 50%, rgba(108, 178, 214, .06), transparent 70%);\n      box-shadow: inset 0 0 0 1px var(--hair);\n    }\n\n    .vld-bond .ax {\n      position: absolute;\n      font: 400 8px/1 var(--mono);\n      text-transform: uppercase;\n      letter-spacing: .13em;\n      color: var(--dim);\n      pointer-events: none;\n    }\n\n    .vld-bond .ax-h {\n      bottom: 5px;\n      left: 0;\n      right: 0;\n      text-align: center;\n    }\n\n    .vld-bond .ay {\n      top: 50%;\n      left: 5px;\n      transform: rotate(-90deg) translateX(50%);\n      transform-origin: left center;\n    }\n\n    .vld-bond .pin {\n      position: absolute;\n      left: 50%;\n      bottom: 50%;\n      display: flex;\n      align-items: center;\n      gap: 5px;\n      transform: translate(-50%, 50%);\n      animation: vld-bond-drop .42s cubic-bezier(.2, .9, .25, 1) both;\n    }\n\n    /* Метки приземляются по очереди — глазу есть за чем проследить, и сразу\n       видно, что их несколько. */\n    .vld-bond .s2 { animation-delay: .09s; }\n    .vld-bond .s3 { animation-delay: .18s; }\n\n    @keyframes vld-bond-drop {\n      from { opacity: 0; transform: translate(-50%, 50%) scale(2.4); }\n    }\n\n    .vld-bond .pin i {\n      width: 9px;\n      height: 9px;\n      flex: 0 0 auto;\n      border-radius: 50%;\n      background: rgb(var(--tone));\n      box-shadow: 0 0 0 3px rgba(var(--tone), .18), 0 0 12px rgba(var(--tone), .5);\n    }\n\n    .vld-bond .pin b {\n      font: 500 10.5px/1 var(--mono);\n      white-space: nowrap;\n      color: rgb(var(--tone));\n      text-shadow: 0 1px 3px rgba(0, 0, 0, .9);\n    }\n\n    /* Ближе к правому краю подпись уезжала бы за поле — там она ставится слева\n       от точки. Порядок в строке меняется через order, обёртка не нужна. */\n    .vld-bond .wx-7  b, .vld-bond .wx-8  b,\n    .vld-bond .wx-9  b, .vld-bond .wx-10 b { order: -1; }\n\n    .vld-bond .s1 { --tone: var(--s1); }\n    .vld-bond .s2 { --tone: var(--s2); }\n    .vld-bond .s3 { --tone: var(--s3); }\n\n    /* Значение приезжает классом, поэтому точка стоит на месте без единой строчки\n       JS. Не совпало ничего — метка остаётся в центре, то есть «непонятно», и это\n       честнее пустого места. */\n    .vld-bond .wx-0  { left: 5%; }\n    .vld-bond .wx-1  { left: 14%; }\n    .vld-bond .wx-2  { left: 23%; }\n    .vld-bond .wx-3  { left: 32%; }\n    .vld-bond .wx-4  { left: 41%; }\n    .vld-bond .wx-5  { left: 50%; }\n    .vld-bond .wx-6  { left: 59%; }\n    .vld-bond .wx-7  { left: 68%; }\n    .vld-bond .wx-8  { left: 77%; }\n    .vld-bond .wx-9  { left: 86%; }\n    .vld-bond .wx-10 { left: 95%; }\n\n    .vld-bond .ty-0  { bottom: 5%; }\n    .vld-bond .ty-1  { bottom: 14%; }\n    .vld-bond .ty-2  { bottom: 23%; }\n    .vld-bond .ty-3  { bottom: 32%; }\n    .vld-bond .ty-4  { bottom: 41%; }\n    .vld-bond .ty-5  { bottom: 50%; }\n    .vld-bond .ty-6  { bottom: 59%; }\n    .vld-bond .ty-7  { bottom: 68%; }\n    .vld-bond .ty-8  { bottom: 77%; }\n    .vld-bond .ty-9  { bottom: 86%; }\n    .vld-bond .ty-10 { bottom: 95%; }\n\n    .vld-bond .tells {\n      margin: 11px 0 0;\n      padding: 0;\n      list-style: none;\n      display: grid;\n      gap: 6px;\n    }\n\n    .vld-bond .tells li {\n      display: grid;\n      grid-template-columns: auto 1fr;\n      gap: 8px;\n      align-items: baseline;\n      padding-left: 8px;\n      border-left: 2px solid rgb(var(--tone));\n    }\n\n    .vld-bond .tells em {\n      font: 500 10.5px/1.3 var(--mono);\n      font-style: normal;\n      color: rgb(var(--tone));\n    }\n\n    .vld-bond .tells span {\n      font: 400 11.5px/1.35 var(--mono);\n      color: var(--ink);\n    }\n\n    /* Модель назвала не всех — пустые слоты исчезают целиком. */\n    .vld-bond .pin:has(b:empty),\n    .vld-bond .tells li:has(em:empty) {\n      display: none;\n    }\n\n    /* Ни одного имени — не показывать пустое поле с сеткой. Именно «ни одного»:\n       если назван хоть кто-то, расклад имеет смысл и с одной точкой. */\n    .vld-bond .board:not(:has(.pin b:not(:empty))) {\n      display: none;\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      .vld-bond .board,\n      .vld-bond .pin {\n        animation: none;\n      }\n    }\n  </style>\n</div>",
