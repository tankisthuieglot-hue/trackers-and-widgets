{
 "id": "668c3024-5e3d-5aae-ae09-c2e070bd79dc",
 "scriptName": "🧾 VLD BILL · en",
 "findRegex": "/\\[\\[VLD_BILL(?![A-Z0-9_])(?=[^\\]]*\\|\\s*V\\s*=[ \\t]*([^|\\]<]*)|)(?=[^\\]]*\\|\\s*D\\s*=[ \\t]*([^|\\]<]*)|)(?=[^\\]]*\\|\\s*I1\\s*=[ \\t]*([^|\\]<]*)|)(?=[^\\]]*\\|\\s*C1\\s*=[ \\t]*([^|\\]<]*)|)(?=[^\\]]*\\|\\s*I2\\s*=[ \\t]*([^|\\]<]*)|)(?=[^\\]]*\\|\\s*C2\\s*=[ \\t]*([^|\\]<]*)|)(?=[^\\]]*\\|\\s*I3\\s*=[ \\t]*([^|\\]<]*)|)(?=[^\\]]*\\|\\s*C3\\s*=[ \\t]*([^|\\]<]*)|)(?=[^\\]]*\\|\\s*I4\\s*=[ \\t]*([^|\\]<]*)|)(?=[^\\]]*\\|\\s*C4\\s*=[ \\t]*([^|\\]<]*)|)(?=[^\\]]*\\|\\s*T\\s*=[ \\t]*([^|\\]<]*)|)(?=[^\\]]*\\|\\s*P\\s*=[ \\t]*([^|\\]<]*)|)(?=[^\\]]*\\|\\s*N\\s*=[ \\t]*([^|\\]<]*)|)[^\\]]*\\]\\]/g",
 "replaceString": "<div class=\"vld-w vld-bill\">\n  <div class=\"slip\">\n    <div class=\"paper\">\n      <div class=\"vend\">$1</div>\n      <div class=\"when\">$2</div>\n\n      <div class=\"sep\"></div>\n\n      <div class=\"row\"><span class=\"it\">$3</span><span class=\"dots\"></span><span class=\"pr\">$4</span></div>\n      <div class=\"row\"><span class=\"it\">$5</span><span class=\"dots\"></span><span class=\"pr\">$6</span></div>\n      <div class=\"row\"><span class=\"it\">$7</span><span class=\"dots\"></span><span class=\"pr\">$8</span></div>\n      <div class=\"row\"><span class=\"it\">$9</span><span class=\"dots\"></span><span class=\"pr\">$10</span></div>\n\n      <div class=\"sep\"></div>\n\n      <div class=\"row sum\"><span class=\"it\">TOTAL</span><span class=\"dots\"></span><span class=\"pr\">$11</span></div>\n      <div class=\"row way\"><span class=\"it\">PAID</span><span class=\"dots\"></span><span class=\"pr\">$12</span></div>\n\n      <div class=\"note\">$13</div>\n      <div class=\"code\"></div>\n    </div>\n  </div>\n  <style>\n    /* Термочек: узкая полоска, моноширинный шрифт, рваный край сверху и снизу,\n       штрихкод, лёгкий поворот. Вещь, которую сунули в карман, а не карточка в\n       интерфейсе — поэтому и лежит на странице чуть криво.\n\n       Рваный край сделан маской из повторяющихся конусов. Резать сам фон нельзя:\n       тогда обрежется и тень, и полоска перестанет отрываться от подложки. */\n\n    .vld-bill {\n      --paper: #f4f1e9;\n      --ink: #2a2722;\n      --fade: #6d675d;\n      --mono: ui-monospace, \"Cascadia Mono\", \"Consolas\", \"DejaVu Sans Mono\", monospace;\n\n      width: min(100%, 268px);\n      margin: 16px auto;\n      color: var(--ink);\n    }\n\n    .vld-bill * {\n      box-sizing: border-box;\n    }\n\n    /* Поворот живёт на обёртке: маска на бумаге считается в её собственных осях,\n       и если крутить сам лист, зубцы поедут вместе с ним и перестанут быть\n       горизонтальным отрывом. */\n    .vld-bill .slip {\n      transform: rotate(-.8deg);\n      filter: drop-shadow(0 8px 16px rgba(0, 0, 0, .32));\n      animation: vld-bill-in .34s cubic-bezier(.2, .85, .3, 1) both;\n    }\n\n    @keyframes vld-bill-in {\n      from { opacity: 0; transform: rotate(-.8deg) translateY(-8px); }\n    }\n\n    .vld-bill .paper {\n      padding: 15px 15px 13px;\n      background:\n        /* неровный прокат термобумаги */\n        repeating-linear-gradient(90deg, rgba(42, 39, 34, .022) 0 1px, transparent 1px 3px),\n        var(--paper);\n      /* Зубцы сверху и снизу — по 7px, остальное сплошное. */\n      mask:\n        conic-gradient(from -45deg at 50% 0, #0000 0 90deg, #000 0) 0 0 / 9px 7px repeat-x,\n        conic-gradient(from 135deg at 50% 100%, #0000 0 90deg, #000 0) 0 100% / 9px 7px repeat-x,\n        linear-gradient(#000 0 0) 0 7px / 100% calc(100% - 14px) no-repeat;\n    }\n\n    .vld-bill .vend {\n      text-align: center;\n      font: 700 13px/1.2 var(--mono);\n      text-transform: uppercase;\n      letter-spacing: .04em;\n    }\n\n    .vld-bill .when {\n      margin-top: 2px;\n      text-align: center;\n      font: 400 9.5px/1.2 var(--mono);\n      color: var(--fade);\n    }\n\n    .vld-bill .sep {\n      height: 1px;\n      margin: 9px 0;\n      /* Пунктир нарисован градиентом, а не border-dashed: так шаг одинаковый\n         в любом браузере. */\n      background: repeating-linear-gradient(90deg, rgba(42, 39, 34, .45) 0 4px, transparent 4px 8px);\n    }\n\n    .vld-bill .row {\n      display: flex;\n      align-items: baseline;\n      gap: 6px;\n      padding: 2.5px 0;\n      font: 400 11px/1.35 var(--mono);\n    }\n\n    .vld-bill .it {\n      flex: 0 1 auto;\n      min-width: 0;\n    }\n\n    /* Отточие между позицией и ценой — отдельная растяжка, а не ::after у\n       позиции. Псевдоэлемент шириной в 100% переносился на следующую строку и\n       утаскивал точки под текст: inline-block внутри flex-элемента меряет ширину\n       от него, а не от свободного места. */\n    .vld-bill .dots {\n      flex: 1 1 auto;\n      min-width: 10px;\n      margin-bottom: 3px;\n      border-bottom: 1px dotted rgba(42, 39, 34, .34);\n    }\n\n    .vld-bill .pr {\n      flex: 0 0 auto;\n      font-variant-numeric: tabular-nums;\n    }\n\n    .vld-bill .sum {\n      font: 700 13px/1.3 var(--mono);\n    }\n\n    .vld-bill .way {\n      font: 400 9.5px/1.3 var(--mono);\n      text-transform: uppercase;\n      letter-spacing: .06em;\n      color: var(--fade);\n    }\n\n    .vld-bill .sum .dots,\n    .vld-bill .way .dots {\n      border-bottom: none;\n    }\n\n    .vld-bill .note {\n      margin-top: 10px;\n      padding-top: 9px;\n      border-top: 1px solid rgba(42, 39, 34, .2);\n      text-align: center;\n      font: 400 9px/1.35 var(--mono);\n      color: var(--fade);\n    }\n\n    /* Штрихкод — просто полосы разной ширины. Читать его нечем, и не надо:\n       он тут ради того, чтобы бумажка была бумажкой. */\n    .vld-bill .code {\n      height: 26px;\n      margin-top: 11px;\n      background: repeating-linear-gradient(90deg,\n        var(--ink) 0 1px, transparent 1px 3px,\n        var(--ink) 3px 5px, transparent 5px 6px,\n        var(--ink) 6px 7px, transparent 7px 10px,\n        var(--ink) 10px 13px, transparent 13px 14px);\n      opacity: .78;\n    }\n\n    .vld-bill .row:has(.it:empty),\n    .vld-bill .row:has(.pr:empty),\n    .vld-bill .note:empty {\n      display: none;\n    }\n\n    /* Без продавца и без итога это не чек. */\n    .vld-bill .paper:has(.vend:empty) {\n      display: none;\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      .vld-bill .slip {\n        animation: none;\n      }\n    }\n  </style>\n</div>",
