{
 "id": "c90a9e90-bf59-5aa5-a103-120a5c219110",
 "scriptName": "📱 VLD PHONE · ru",
 "findRegex": "/\\[\\[VLD_PHONE(?![A-Z0-9_])(?=[^\\]]*\\|\\s*F\\s*=[ \\t]*([^|\\]<]*)|)(?=[^\\]]*\\|\\s*M1\\s*=[ \\t]*([^|\\]<]*)|)(?=[^\\]]*\\|\\s*S1\\s*=[ \\t]*(them|me)|)(?=[^\\]]*\\|\\s*M2\\s*=[ \\t]*([^|\\]<]*)|)(?=[^\\]]*\\|\\s*S2\\s*=[ \\t]*(them|me)|)(?=[^\\]]*\\|\\s*M3\\s*=[ \\t]*([^|\\]<]*)|)(?=[^\\]]*\\|\\s*S3\\s*=[ \\t]*(them|me)|)(?=[^\\]]*\\|\\s*M4\\s*=[ \\t]*([^|\\]<]*)|)(?=[^\\]]*\\|\\s*S4\\s*=[ \\t]*(them|me)|)(?=[^\\]]*\\|\\s*TY\\s*=[ \\t]*(yes)|)[^\\]]*\\]\\]/g",
 "replaceString": "<div class=\"vld-w vld-phone\">\n  <div class=\"fone\">\n    <div class=\"bar\">\n      <span class=\"chev\"></span>\n      <span class=\"who\">$1</span>\n      <span class=\"sig\"><i></i><i></i><i></i><i></i></span>\n    </div>\n\n    <div class=\"thread\">\n      <div class=\"msg s-$3\"><span class=\"b\">$2</span></div>\n      <div class=\"msg s-$5\"><span class=\"b\">$4</span></div>\n      <div class=\"msg s-$7\"><span class=\"b\">$6</span></div>\n      <div class=\"msg s-$9\"><span class=\"b\">$8</span></div>\n\n      <div class=\"msg s-them typing ty-$10\">\n        <span class=\"b\"><i></i><i></i><i></i></span>\n      </div>\n    </div>\n  </div>\n  <style>\n    /* Переписка узнаётся мгновенно, поэтому объяснять тут нечего — надо только\n       не испортить. Пузыри, хвостик у последнего в серии, «печатает» точками.\n\n       Единственное решение, которое стоило подумать: пузыри появляются по\n       очереди с задержкой, как будто сообщения приходят при читателе. Это\n       бесплатно (одна анимация с четырьмя задержками) и превращает список строк\n       в сцену. */\n\n    .vld-phone {\n      --ink: #ecedef;\n      --dim: #8b8f96;\n      --plate: #131417;\n      --them: #26282e;\n      --me: #2f6ad0;\n      --hair: rgba(236, 237, 239, .09);\n      --sans: ui-sans-serif, system-ui, \"Segoe UI\", Roboto, sans-serif;\n\n      width: min(100%, 320px);\n      margin: 14px auto;\n      color: var(--ink);\n      filter: drop-shadow(0 14px 28px rgba(0, 0, 0, .5));\n    }\n\n    .vld-phone * {\n      box-sizing: border-box;\n    }\n\n    .vld-phone .fone {\n      overflow: hidden;\n      border-radius: 13px;\n      background: var(--plate);\n      box-shadow: inset 0 0 0 1px var(--hair);\n      animation: vld-phone-in .3s ease both;\n    }\n\n    @keyframes vld-phone-in {\n      from { opacity: 0; transform: translateY(6px); }\n    }\n\n    .vld-phone .bar {\n      display: flex;\n      align-items: center;\n      gap: 9px;\n      padding: 9px 12px;\n      border-bottom: 1px solid var(--hair);\n      background: rgba(255, 255, 255, .035);\n    }\n\n    .vld-phone .chev {\n      flex: 0 0 auto;\n      width: 0;\n      height: 0;\n      border-right: 5px solid var(--me);\n      border-top: 4px solid transparent;\n      border-bottom: 4px solid transparent;\n    }\n\n    .vld-phone .who {\n      flex: 1;\n      min-width: 0;\n      overflow: hidden;\n      white-space: nowrap;\n      text-overflow: ellipsis;\n      font: 600 13px/1.2 var(--sans);\n    }\n\n    /* Лесенка антенны. Четвёртое деление приглушено — связь есть, но не полная,\n       что для ночного разговора в подворотне вернее полной шкалы. */\n    .vld-phone .sig {\n      flex: 0 0 auto;\n      display: flex;\n      align-items: flex-end;\n      gap: 1.5px;\n      height: 10px;\n    }\n\n    .vld-phone .sig i {\n      width: 2.5px;\n      border-radius: .5px;\n      background: rgba(236, 237, 239, .7);\n    }\n\n    .vld-phone .sig i:nth-child(1) { height: 3px; }\n    .vld-phone .sig i:nth-child(2) { height: 5px; }\n    .vld-phone .sig i:nth-child(3) { height: 7.5px; }\n    .vld-phone .sig i:nth-child(4) { height: 10px; opacity: .22; }\n\n    .vld-phone .thread {\n      display: grid;\n      gap: 4px;\n      padding: 12px 11px;\n    }\n\n    .vld-phone .msg {\n      display: flex;\n      animation: vld-phone-pop .26s cubic-bezier(.2, .9, .3, 1) both;\n    }\n\n    /* Приходят по одному. Задержки короткие: это ритм, а не ожидание. */\n    .vld-phone .thread .msg:nth-child(2) { animation-delay: .12s; }\n    .vld-phone .thread .msg:nth-child(3) { animation-delay: .24s; }\n    .vld-phone .thread .msg:nth-child(4) { animation-delay: .36s; }\n    .vld-phone .thread .msg:nth-child(5) { animation-delay: .52s; }\n\n    @keyframes vld-phone-pop {\n      from { opacity: 0; transform: translateY(6px) scale(.96); }\n    }\n\n    .vld-phone .b {\n      max-width: 78%;\n      padding: 7px 11px;\n      border-radius: 15px;\n      background: var(--them);\n      font: 400 13px/1.35 var(--sans);\n      overflow-wrap: anywhere;\n    }\n\n    /* Своё — справа и синим. Сторона приезжает словом из закрытого списка, так\n       что в класс не попадёт ничего, кроме them или me. */\n    .vld-phone .s-me {\n      justify-content: flex-end;\n    }\n\n    .vld-phone .s-me .b {\n      background: var(--me);\n      color: #fff;\n    }\n\n    /* Галочки на своих сообщениях. Первая мысль была написать «доставлено» под\n       перепиской и показывать его, только когда последним писал {{user}} — но\n       «последний» в CSS считается через цепочку :has(~ …), которую ломает любой\n       пустой слот, оставшийся в разметке. Галочка на самом пузыре не требует\n       знать ничего о соседях и при этом честнее: так и выглядит мессенджер. */\n    .vld-phone .s-me .b::after {\n      content: \"✓✓\";\n      margin-left: 6px;\n      font-size: 9px;\n      letter-spacing: -1px;\n      vertical-align: baseline;\n      opacity: .6;\n    }\n\n    /* Точки «печатает». Три одинаковых кружка с разъехавшейся фазой. */\n    .vld-phone .typing {\n      display: none;\n    }\n\n    .vld-phone .ty-yes {\n      display: flex;\n    }\n\n    .vld-phone .typing .b {\n      display: flex;\n      align-items: center;\n      gap: 4px;\n      padding: 10px 12px;\n    }\n\n    .vld-phone .typing i {\n      width: 5px;\n      height: 5px;\n      border-radius: 50%;\n      background: rgba(236, 237, 239, .55);\n      animation: vld-phone-dots 1.25s ease-in-out infinite;\n    }\n\n    .vld-phone .typing i:nth-child(2) { animation-delay: .18s; }\n    .vld-phone .typing i:nth-child(3) { animation-delay: .36s; }\n\n    @keyframes vld-phone-dots {\n      0%, 60%, 100% { opacity: .3; transform: translateY(0); }\n      30%           { opacity: 1; transform: translateY(-3px); }\n    }\n\n    /* Пустые слоты не оставляют пустых пузырей. */\n    .vld-phone .msg:has(.b:empty) {\n      display: none;\n    }\n\n    .vld-phone .fone:has(.who:empty) {\n      display: none;\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      .vld-phone .fone,\n      .vld-phone .msg,\n      .vld-phone .typing i {\n        animation: none;\n      }\n    }\n  </style>\n</div>",
