{
 "id": "d325b9ff-1a73-5cba-ab5c-6aaf26a57e70",
 "scriptName": "🎚️ VLD RPG HUD · ru",
 "findRegex": "/\\[\\[VLD_HUD(?![A-Z0-9_])(?=[^\\]]*\\|\\s*N\\s*=[ \\t]*([^|\\]]*)|)(?=[^\\]]*\\|\\s*A\\s*=[ \\t]*([^|\\]]*)|)(?=[^\\]]*\\|\\s*H\\s*=[ \\t]*([^|\\]]*)|)(?=[^\\]]*\\|\\s*B1\\s*=[ \\t]*([^|\\]]*)|)(?=[^\\]]*\\|\\s*V1\\s*=[ \\t]*(10|[0-9])|)(?=[^\\]]*\\|\\s*B2\\s*=[ \\t]*([^|\\]]*)|)(?=[^\\]]*\\|\\s*V2\\s*=[ \\t]*(10|[0-9])|)(?=[^\\]]*\\|\\s*B3\\s*=[ \\t]*([^|\\]]*)|)(?=[^\\]]*\\|\\s*V3\\s*=[ \\t]*(10|[0-9])|)(?=[^\\]]*\\|\\s*B4\\s*=[ \\t]*([^|\\]]*)|)(?=[^\\]]*\\|\\s*V4\\s*=[ \\t]*(10|[0-9])|)(?=[^\\]]*\\|\\s*B5\\s*=[ \\t]*([^|\\]]*)|)(?=[^\\]]*\\|\\s*V5\\s*=[ \\t]*(10|[0-9])|)(?=[^\\]]*\\|\\s*C\\s*=[ \\t]*([^|\\]]*)|)(?=[^\\]]*\\|\\s*I\\s*=[ \\t]*([^|\\]]*)|)(?=[^\\]]*\\|\\s*S\\s*=[ \\t]*([^|\\]]*)|)[^\\]]*\\]\\]/g",
 "replaceString": "<div class=\"vld-w vld-hud\">\n  <div class=\"panel\">\n    <div class=\"ident\">\n      <b class=\"name\">$1</b>\n      <span class=\"metrics\">$2 · $3</span>\n    </div>\n\n    <div class=\"bars\">\n      <div class=\"bar lv-$5\"><span class=\"fill\"></span><span class=\"row\"><span class=\"lbl\">$4</span><span class=\"num\">$5</span></span></div>\n      <div class=\"bar lv-$7\"><span class=\"fill\"></span><span class=\"row\"><span class=\"lbl\">$6</span><span class=\"num\">$7</span></span></div>\n      <div class=\"bar lv-$9\"><span class=\"fill\"></span><span class=\"row\"><span class=\"lbl\">$8</span><span class=\"num\">$9</span></span></div>\n      <div class=\"bar lv-$11\"><span class=\"fill\"></span><span class=\"row\"><span class=\"lbl\">$10</span><span class=\"num\">$11</span></span></div>\n      <div class=\"bar lv-$13\"><span class=\"fill\"></span><span class=\"row\"><span class=\"lbl\">$12</span><span class=\"num\">$13</span></span></div>\n    </div>\n\n    <details class=\"pack\">\n      <summary><span class=\"chev\"></span><span class=\"k\">При себе</span></summary>\n      <div class=\"v\">$15</div>\n    </details>\n\n    <div class=\"entry\">\n      <span class=\"k\">Одет</span>\n      <span class=\"v\">$14</span>\n    </div>\n\n    <div class=\"entry\">\n      <span class=\"k\">Вид</span>\n      <span class=\"v\">$16</span>\n    </div>\n  </div>\n  <style>\n    /* Панель обязана работать и в фэнтези, и на космической станции, поэтому цвет\n       тут не называет саму шкалу: красное здоровье и синяя мана выбрали бы сеттинг\n       за пользователя. Цвет называет только состояние — красный на исходе, зелёный\n       в порядке. Это читается в любом мире.\n\n       Корпус держится на материале: тёмный анодированный металл, штриховка, блик\n       сверху, тонкая светящаяся кромка на срезе заливки. */\n\n    .vld-hud {\n      --panel: #17181c;\n      --track: rgba(230, 227, 220, .05);\n      --ink: #e6e3dc;\n      --dim: #83858d;\n      --hair: rgba(230, 227, 220, .12);\n\n      /* Ступени состояния. Шкала красит себя сама — читается боковым зрением,\n         цифру можно не искать. */\n      --crit: 204, 90, 100;\n      --low: 214, 128, 64;\n      --mid: 214, 180, 74;\n      --good: 127, 174, 99;\n\n      --serif: \"Georgia\", \"Times New Roman\", serif;\n      --mono: ui-monospace, \"Cascadia Mono\", \"Consolas\", \"DejaVu Sans Mono\", monospace;\n\n      width: min(100%, 384px);\n      margin: 14px auto;\n      color: var(--ink);\n    }\n\n    .vld-hud * {\n      box-sizing: border-box;\n    }\n\n    .vld-hud .panel {\n      position: relative;\n      overflow: hidden;\n      padding: 14px 15px 13px;\n      border: 1px solid var(--hair);\n      border-radius: 5px;\n      color: var(--ink);\n      background:\n        linear-gradient(180deg, rgba(255, 255, 255, .05), transparent 38%),\n        repeating-linear-gradient(90deg, rgba(255, 255, 255, .014) 0 1px, transparent 1px 3px),\n        var(--panel);\n      box-shadow: 0 16px 38px rgba(0, 0, 0, .5), inset 0 1px 0 rgba(255, 255, 255, .06);\n      animation: vld-rise .34s cubic-bezier(.2, .8, .2, 1) both;\n    }\n\n    @keyframes vld-rise {\n      from { opacity: 0; transform: translateY(7px); }\n    }\n\n    .vld-hud .ident {\n      display: flex;\n      align-items: baseline;\n      justify-content: space-between;\n      gap: 12px;\n      padding-bottom: 12px;\n      border-bottom: 1px solid var(--hair);\n    }\n\n    .vld-hud .name {\n      font: 400 19px/1.1 var(--serif);\n      letter-spacing: -.015em;\n    }\n\n    .vld-hud .metrics {\n      flex: 0 0 auto;\n      font: 400 11px/1 var(--mono);\n      letter-spacing: .04em;\n      color: var(--dim);\n    }\n\n    .vld-hud .bars {\n      display: grid;\n      gap: 4px;\n      padding: 12px 0;\n    }\n\n    .vld-hud .bar {\n      position: relative;\n      overflow: hidden;\n      height: 26px;\n      border-radius: 3px;\n      background: var(--track);\n    }\n\n    .vld-hud .fill {\n      position: absolute;\n      inset: 0 auto 0 0;\n      width: 0;\n      background: linear-gradient(90deg, rgba(var(--tone), .10), rgba(var(--tone), .30));\n      transform-origin: left center;\n      animation: vld-grow .58s cubic-bezier(.2, .85, .25, 1) both;\n    }\n\n    /* Световая кромка на срезе: заливка не обрывается, а имеет край. */\n    .vld-hud .fill::after {\n      content: \"\";\n      position: absolute;\n      inset: 0 0 0 auto;\n      width: 1.5px;\n      background: rgb(var(--tone));\n      box-shadow: 0 0 10px rgba(var(--tone), .65);\n    }\n\n    @keyframes vld-grow {\n      from { transform: scaleX(0); }\n    }\n\n    .vld-hud .bars .bar:nth-child(2) .fill { animation-delay: .07s; }\n    .vld-hud .bars .bar:nth-child(3) .fill { animation-delay: .14s; }\n    .vld-hud .bars .bar:nth-child(4) .fill { animation-delay: .21s; }\n    .vld-hud .bars .bar:nth-child(5) .fill { animation-delay: .28s; }\n\n    /* Значение приезжает классом lv-N, поэтому шкала заполнена и без скриптов.\n       Мусор вместо числа не совпадёт ни с чем — шкала пустая, вёрстка целая. */\n    .vld-hud .lv-1  .fill { width: 10%; }\n    .vld-hud .lv-2  .fill { width: 20%; }\n    .vld-hud .lv-3  .fill { width: 30%; }\n    .vld-hud .lv-4  .fill { width: 40%; }\n    .vld-hud .lv-5  .fill { width: 50%; }\n    .vld-hud .lv-6  .fill { width: 60%; }\n    .vld-hud .lv-7  .fill { width: 70%; }\n    .vld-hud .lv-8  .fill { width: 80%; }\n    .vld-hud .lv-9  .fill { width: 90%; }\n    .vld-hud .lv-10 .fill { width: 100%; }\n\n    .vld-hud .bar          { --tone: var(--crit); }\n    .vld-hud .lv-3,\n    .vld-hud .lv-4         { --tone: var(--low); }\n    .vld-hud .lv-5,\n    .vld-hud .lv-6,\n    .vld-hud .lv-7         { --tone: var(--mid); }\n    .vld-hud .lv-8,\n    .vld-hud .lv-9,\n    .vld-hud .lv-10        { --tone: var(--good); }\n\n    /* На исходе — видно, даже если не читать. */\n    .vld-hud .lv-1,\n    .vld-hud .lv-2 {\n      animation: vld-alert 2.6s ease-in-out infinite;\n    }\n\n    @keyframes vld-alert {\n      0%, 100% { box-shadow: inset 0 0 0 1px rgba(var(--crit), 0); }\n      50%      { box-shadow: inset 0 0 0 1px rgba(var(--crit), .5); }\n    }\n\n    /* Имя ловит не настроение игрока, а обстановку: пока что-то на исходе, оно\n       пульсирует. Считается из самих шкал через :has(), без единой строчки JS. */\n    .vld-hud .panel:has(.lv-1, .lv-2) .name {\n      animation: vld-adrenaline .5s ease-in-out infinite alternate;\n    }\n\n    .vld-hud .panel:has(.lv-3, .lv-4):not(:has(.lv-1, .lv-2)) .name {\n      animation: vld-unease 1.5s ease-in-out infinite alternate;\n    }\n\n    @keyframes vld-adrenaline {\n      to { color: rgb(255, 122, 130); text-shadow: 0 0 14px rgba(var(--crit), .55); }\n    }\n\n    @keyframes vld-unease {\n      to { color: rgb(226, 158, 96); text-shadow: 0 0 12px rgba(var(--low), .4); }\n    }\n\n    .vld-hud .row {\n      position: relative;\n      display: flex;\n      align-items: center;\n      gap: 8px;\n      height: 100%;\n      padding: 0 11px;\n    }\n\n    .vld-hud .lbl {\n      flex: 1;\n      min-width: 0;\n      overflow: hidden;\n      white-space: nowrap;\n      text-overflow: ellipsis;\n      font: 500 12px/1 var(--mono);\n    }\n\n    .vld-hud .num {\n      flex: 0 0 auto;\n      font: 500 12px/1 var(--mono);\n      font-variant-numeric: tabular-nums;\n    }\n\n    .vld-hud .num::after {\n      content: \"/10\";\n      opacity: .42;\n    }\n\n    .vld-hud .pack {\n      border-top: 1px solid var(--hair);\n      padding-top: 10px;\n    }\n\n    .vld-hud summary {\n      display: flex;\n      align-items: center;\n      gap: 7px;\n      list-style: none;\n      cursor: pointer;\n    }\n\n    .vld-hud summary::-webkit-details-marker {\n      display: none;\n    }\n\n    .vld-hud .chev {\n      width: 0;\n      height: 0;\n      border-left: 4px solid var(--dim);\n      border-top: 3.5px solid transparent;\n      border-bottom: 3.5px solid transparent;\n      transition: transform .18s ease;\n    }\n\n    .vld-hud .pack[open] .chev {\n      transform: rotate(90deg);\n    }\n\n    .vld-hud summary:hover .k {\n      color: var(--ink);\n    }\n\n    .vld-hud .pack .v {\n      padding-top: 6px;\n    }\n\n    /* Плавное раскрытие там, где браузер это умеет; где нет — просто мгновенно. */\n    @supports (interpolate-size: allow-keywords) {\n      .vld-hud {\n        interpolate-size: allow-keywords;\n      }\n\n      .vld-hud .pack::details-content {\n        block-size: 0;\n        overflow: hidden;\n        transition: block-size .28s ease, content-visibility .28s allow-discrete;\n      }\n\n      .vld-hud .pack[open]::details-content {\n        block-size: auto;\n      }\n    }\n\n    .vld-hud .entry {\n      display: grid;\n      gap: 3px;\n      padding-top: 10px;\n    }\n\n    .vld-hud .k {\n      font: 400 9px/1.2 var(--mono);\n      text-transform: uppercase;\n      letter-spacing: .15em;\n      color: var(--dim);\n      transition: color .18s ease;\n    }\n\n    .vld-hud .v {\n      font: 400 12.5px/1.45 var(--mono);\n      color: var(--ink);\n    }\n\n    /* Модель не заполнила слот — он исчезает целиком, а не висит пустой строкой.\n       Шкала без названия бессмысленна, шкала без значения — тоже. */\n    .vld-hud .bar:has(.lbl:empty),\n    .vld-hud .bar:has(.num:empty),\n    .vld-hud .entry:has(.v:empty),\n    .vld-hud .pack:has(.v:empty) {\n      display: none;\n    }\n\n    /* Без имени сводка ни о ком. Пустой маркер не оставляет пустую панель. */\n    .vld-hud .panel:has(.name:empty) {\n      display: none;\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      .vld-hud .panel,\n      .vld-hud .fill,\n      .vld-hud .lv-1,\n      .vld-hud .lv-2,\n      .vld-hud .name {\n        animation: none;\n      }\n\n      .vld-hud .chev,\n      .vld-hud .pack::details-content {\n        transition: none;\n      }\n    }\n  </style>\n  <script>\n    (function () {\n      var root = (document.currentScript && document.currentScript.parentElement)\n        || document.querySelector('.vld-hud:not([data-vld-init])');\n      if (!root || root.dataset.vldInit === '1') return;\n      root.dataset.vldInit = '1';\n      // Виджет одноразовый. Он не знает, что было в прошлом сообщении, и знать не\n      // может: маркеры вырезаются из контекста на глубине 3, так что и сама модель\n      // не помнит прошлых значений. Всё, что здесь происходит, выводится из одного\n      // снимка.\n      //\n      // CSS наливает шкалы от нуля. Задача скрипта — чтобы цифра ехала вместе с\n      // заливкой, а не стояла готовой над растущей полоской.\n\n      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {\n        root.querySelectorAll('.bar').forEach(function (bar, index) {\n          var num = bar.querySelector('.num');\n          var target = parseInt(num.textContent, 10);\n          if (isNaN(target)) return;\n\n          num.textContent = '0';\n          countUp(num, target, index * 70);\n        });\n      }\n\n      /** Те же 70 мс лесенкой и та же длительность, что у vld-grow в стилях. */\n      function countUp(el, target, delay) {\n        setTimeout(function () {\n          var started = null;\n\n          requestAnimationFrame(function step(now) {\n            if (started === null) started = now;\n            var t = Math.min(1, (now - started) / 580);\n\n            el.textContent = Math.round(target * (1 - Math.pow(1 - t, 3)));\n            if (t < 1) requestAnimationFrame(step);\n          });\n        }, delay);\n      }\n    })();\n  </script>\n</div>",
