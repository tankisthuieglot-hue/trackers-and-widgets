{
 "id": "7326d5ed-bb68-5b01-9913-14ca81dfcc74",
 "scriptName": "🧪 VLD DEMO",
 "findRegex": "/\\[\\[VLD_DEMO(?![A-Z0-9_])(?=[^\\]]*\\|\\s*T\\s*=[ \\t]*([^|\\]]*)|)(?=[^\\]]*\\|\\s*S\\s*=[ \\t]*([^|\\]]*)|)(?=[^\\]]*\\|\\s*V\\s*=[ \\t]*([^|\\]]*)|)(?=[^\\]]*\\|\\s*I1\\s*=[ \\t]*([^|\\]]*)|)(?=[^\\]]*\\|\\s*I2\\s*=[ \\t]*([^|\\]]*)|)(?=[^\\]]*\\|\\s*I3\\s*=[ \\t]*([^|\\]]*)|)(?=[^\\]]*\\|\\s*F\\s*=[ \\t]*([^|\\]]*)|)[^\\]]*\\]\\]/g",
 "replaceString": "<div class=\"vld-w vld-demo\">\n  <div class=\"card\">\n    <div class=\"head\">\n      <b class=\"title\">$1</b>\n      <span class=\"badge\">$2</span>\n    </div>\n\n    <div class=\"value\">$3</div>\n\n    <ul class=\"list\">\n      <li class=\"item\"><i></i><span>$4</span></li>\n      <li class=\"item\"><i></i><span>$5</span></li>\n      <li class=\"item\"><i></i><span>$6</span></li>\n    </ul>\n\n    <div class=\"foot\">$7</div>\n  </div>\n  <style>\n    /* Every selector contains .vld-demo — inner elements are reached as\n       descendants, never by their own prefixed class. That is what keeps the\n       stylesheet from touching anything outside this widget.\n\n       Colours are fixed. The widget is an object lying on the page, not chrome\n       that follows a theme, so it carries its own opaque surface. */\n\n    .vld-demo {\n      --bg: #ffffff;\n      --ink: #16181d;\n      --muted: #6b7280;\n      --line: rgba(16, 18, 24, 0.10);\n      --accent: #3b6ef5;\n\n      width: min(100%, 380px);\n      margin: 14px auto;\n      font: 14px/1.4 ui-sans-serif, system-ui, \"Segoe UI\", Roboto, sans-serif;\n      color: var(--ink);\n    }\n\n    .vld-demo * {\n      box-sizing: border-box;\n    }\n\n    .vld-demo .card {\n      padding: 16px;\n      border: 1px solid var(--line);\n      border-radius: 16px;\n      background: var(--bg);\n      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.10);\n    }\n\n    .vld-demo .head {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 10px;\n    }\n\n    .vld-demo .title {\n      font-size: 15px;\n      letter-spacing: -0.01em;\n    }\n\n    .vld-demo .badge {\n      padding: 3px 9px;\n      border-radius: 999px;\n      background: color-mix(in srgb, var(--accent) 14%, transparent);\n      color: var(--accent);\n      font-size: 11px;\n      font-weight: 700;\n      white-space: nowrap;\n    }\n\n    .vld-demo .value {\n      margin: 10px 0 14px;\n      font-size: 30px;\n      font-weight: 650;\n      letter-spacing: -0.03em;\n      font-variant-numeric: tabular-nums;\n    }\n\n    .vld-demo .list {\n      display: grid;\n      gap: 7px;\n      margin: 0;\n      padding: 0;\n      list-style: none;\n    }\n\n    .vld-demo .item {\n      display: flex;\n      gap: 9px;\n      align-items: flex-start;\n      padding: 9px 10px;\n      border-radius: 11px;\n      background: color-mix(in srgb, var(--ink) 4%, transparent);\n      cursor: pointer;\n      transition: opacity 0.18s ease, transform 0.18s ease;\n    }\n\n    .vld-demo .item i {\n      flex: 0 0 auto;\n      width: 16px;\n      height: 16px;\n      margin-top: 1px;\n      border: 2px solid var(--muted);\n      border-radius: 5px;\n      display: grid;\n      place-items: center;\n      font: 700 11px/1 sans-serif;\n      font-style: normal;\n    }\n\n    .vld-demo .item.done {\n      opacity: 0.5;\n      transform: translateX(4px);\n    }\n\n    .vld-demo .item.done i {\n      border-color: var(--accent);\n      background: var(--accent);\n      color: #fff;\n    }\n\n    .vld-demo .item.done i::before {\n      content: \"✓\";\n    }\n\n    .vld-demo .foot {\n      margin-top: 13px;\n      color: var(--muted);\n      font-size: 12px;\n    }\n  </style>\n  <script>\n    (function () {\n      var root = (document.currentScript && document.currentScript.parentElement)\n        || document.querySelector('.vld-demo:not([data-vld-init])');\n      if (!root || root.dataset.vldInit === '1') return;\n      root.dataset.vldInit = '1';\n      // `root` is the widget element; the build wraps this body and guards it against\n      // running twice on the same node. Keep it small — this runs once per widget in\n      // the chat, and there can be a lot of them.\n      root.querySelectorAll('.item').forEach(function (item) {\n        item.addEventListener('click', function () {\n          item.classList.toggle('done');\n        });\n      });\n    })();\n  </script>\n</div>",
