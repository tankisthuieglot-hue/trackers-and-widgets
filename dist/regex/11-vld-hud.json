{
 "id": "ab6a5c25-7a8e-5fea-a3e5-379aab0be4ba",
 "scriptName": "🎚️ VLD RPG HUD",
 "findRegex": "/\\[\\[VLD_HUD(?![A-Z0-9_])(?=[^\\]]*\\|\\s*N\\s*=[ \\t]*([^|\\]]*)|)(?=[^\\]]*\\|\\s*A\\s*=[ \\t]*([^|\\]]*)|)(?=[^\\]]*\\|\\s*H\\s*=[ \\t]*([^|\\]]*)|)(?=[^\\]]*\\|\\s*B1\\s*=[ \\t]*([^|\\]]*)|)(?=[^\\]]*\\|\\s*V1\\s*=[ \\t]*(10|[0-9])|)(?=[^\\]]*\\|\\s*B2\\s*=[ \\t]*([^|\\]]*)|)(?=[^\\]]*\\|\\s*V2\\s*=[ \\t]*(10|[0-9])|)(?=[^\\]]*\\|\\s*B3\\s*=[ \\t]*([^|\\]]*)|)(?=[^\\]]*\\|\\s*V3\\s*=[ \\t]*(10|[0-9])|)(?=[^\\]]*\\|\\s*B4\\s*=[ \\t]*([^|\\]]*)|)(?=[^\\]]*\\|\\s*V4\\s*=[ \\t]*(10|[0-9])|)(?=[^\\]]*\\|\\s*B5\\s*=[ \\t]*([^|\\]]*)|)(?=[^\\]]*\\|\\s*V5\\s*=[ \\t]*(10|[0-9])|)(?=[^\\]]*\\|\\s*C\\s*=[ \\t]*([^|\\]]*)|)(?=[^\\]]*\\|\\s*I\\s*=[ \\t]*([^|\\]]*)|)(?=[^\\]]*\\|\\s*S\\s*=[ \\t]*([^|\\]]*)|)[^\\]]*\\]\\]/g",
 "replaceString": "<div class=\"vld-w vld-hud\">\n  <div class=\"panel\">\n    <div class=\"ident\">\n      <b class=\"name\">$1</b>\n      <span class=\"metrics\">$2 · $3</span>\n    </div>\n\n    <div class=\"bars\">\n      <div class=\"bar lv-$5\"><span class=\"fill\"></span><span class=\"lbl\">$4</span><span class=\"num\">$5</span></div>\n      <div class=\"bar lv-$7\"><span class=\"fill\"></span><span class=\"lbl\">$6</span><span class=\"num\">$7</span></div>\n      <div class=\"bar lv-$9\"><span class=\"fill\"></span><span class=\"lbl\">$8</span><span class=\"num\">$9</span></div>\n      <div class=\"bar lv-$11\"><span class=\"fill\"></span><span class=\"lbl\">$10</span><span class=\"num\">$11</span></div>\n      <div class=\"bar lv-$13\"><span class=\"fill\"></span><span class=\"lbl\">$12</span><span class=\"num\">$13</span></div>\n    </div>\n\n    <details class=\"pack\">\n      <summary><span class=\"k\">При себе</span><span class=\"hint\"></span></summary>\n      <div class=\"v\">$15</div>\n    </details>\n\n    <div class=\"entry\">\n      <span class=\"k\">Одет</span>\n      <span class=\"v\">$14</span>\n    </div>\n\n    <div class=\"entry\">\n      <span class=\"k\">Вид</span>\n      <span class=\"v\">$16</span>\n    </div>\n  </div>\n  <style>\n    /* Виджет обязан работать и в фэнтези, и на космической станции, поэтому в нём\n       нет цвета: красная полоска здоровья и синяя маны выбрали бы сеттинг за\n       пользователя. Монохром, сеттинг приносят подписи.\n\n       Ни одной строчки JavaScript. Заливка шкалы приходит классом из значения,\n       инвентарь раскрывается нативным <details>. */\n\n    .vld-hud {\n      --panel: #191a1e;\n      --track: #26272d;\n      --fill: #dcd8cf;\n      --ink: #dcd8cf;\n      --dim: #7f8189;\n      --hair: rgba(220, 216, 207, .13);\n\n      --serif: \"Georgia\", \"Times New Roman\", serif;\n      --mono: ui-monospace, \"Cascadia Mono\", \"Consolas\", \"DejaVu Sans Mono\", monospace;\n\n      width: min(100%, 384px);\n      margin: 14px auto;\n      color: var(--ink);\n    }\n\n    .vld-hud * {\n      box-sizing: border-box;\n    }\n\n    .vld-hud .panel {\n      padding: 14px 15px 13px;\n      border: 1px solid var(--hair);\n      border-radius: 5px;\n      background: var(--panel);\n      box-shadow: 0 14px 34px rgba(0, 0, 0, .45);\n    }\n\n    .vld-hud .ident {\n      display: flex;\n      align-items: baseline;\n      justify-content: space-between;\n      gap: 12px;\n      padding-bottom: 12px;\n      border-bottom: 1px solid var(--hair);\n    }\n\n    .vld-hud .name {\n      font: 400 19px/1.1 var(--serif);\n      letter-spacing: -.015em;\n    }\n\n    .vld-hud .metrics {\n      flex: 0 0 auto;\n      font: 400 11px/1 var(--mono);\n      letter-spacing: .04em;\n      color: var(--dim);\n    }\n\n    .vld-hud .bars {\n      display: grid;\n      gap: 4px;\n      padding: 12px 0;\n    }\n\n    /* Подпись лежит на шкале, а не рядом с ней, и инвертируется ровно там, где её\n       накрыла заливка. Один элемент вместо двух копий с обрезкой. */\n    .vld-hud .bar {\n      position: relative;\n      isolation: isolate;\n      overflow: hidden;\n      height: 25px;\n      border-radius: 3px;\n      background: var(--track);\n    }\n\n    .vld-hud .fill {\n      position: absolute;\n      inset: 0 auto 0 0;\n      width: 0;\n      background: var(--fill);\n    }\n\n    .vld-hud .lbl,\n    .vld-hud .num {\n      position: absolute;\n      top: 50%;\n      transform: translateY(-50%);\n      color: #fff;\n      mix-blend-mode: difference;\n      white-space: nowrap;\n    }\n\n    .vld-hud .lbl {\n      left: 10px;\n      right: 52px;\n      overflow: hidden;\n      text-overflow: ellipsis;\n      font: 500 12px/1 var(--mono);\n    }\n\n    .vld-hud .num {\n      right: 10px;\n      font: 500 12px/1 var(--mono);\n      font-variant-numeric: tabular-nums;\n    }\n\n    .vld-hud .num::after {\n      content: \"/10\";\n      opacity: .5;\n    }\n\n    /* Значение поля приезжает классом lv-N, поэтому заливка рисуется без скриптов.\n       Мусор вместо числа не совпадёт ни с одним правилом — шкала останется пустой,\n       а вёрстка целой. */\n    .vld-hud .lv-1  .fill { width: 10%; }\n    .vld-hud .lv-2  .fill { width: 20%; }\n    .vld-hud .lv-3  .fill { width: 30%; }\n    .vld-hud .lv-4  .fill { width: 40%; }\n    .vld-hud .lv-5  .fill { width: 50%; }\n    .vld-hud .lv-6  .fill { width: 60%; }\n    .vld-hud .lv-7  .fill { width: 70%; }\n    .vld-hud .lv-8  .fill { width: 80%; }\n    .vld-hud .lv-9  .fill { width: 90%; }\n    .vld-hud .lv-10 .fill { width: 100%; }\n\n    .vld-hud .pack {\n      border-top: 1px solid var(--hair);\n      padding-top: 10px;\n    }\n\n    .vld-hud summary {\n      display: flex;\n      align-items: center;\n      gap: 7px;\n      list-style: none;\n      cursor: pointer;\n    }\n\n    .vld-hud summary::-webkit-details-marker {\n      display: none;\n    }\n\n    .vld-hud .hint {\n      width: 0;\n      height: 0;\n      border-left: 4px solid var(--dim);\n      border-top: 3.5px solid transparent;\n      border-bottom: 3.5px solid transparent;\n      transition: transform .16s ease;\n    }\n\n    .vld-hud .pack[open] .hint {\n      transform: rotate(90deg);\n    }\n\n    .vld-hud .pack .v {\n      padding-top: 5px;\n    }\n\n    .vld-hud .entry {\n      display: grid;\n      gap: 3px;\n      padding-top: 10px;\n    }\n\n    .vld-hud .k {\n      font: 400 9px/1.2 var(--mono);\n      text-transform: uppercase;\n      letter-spacing: .15em;\n      color: var(--dim);\n    }\n\n    .vld-hud .v {\n      font: 400 12.5px/1.45 var(--mono);\n      color: var(--ink);\n    }\n\n    /* Модель не заполнила слот — он исчезает целиком, а не висит пустой полоской.\n       Шкала без названия бессмысленна, шкала без значения — тоже. */\n    .vld-hud .bar:has(.lbl:empty),\n    .vld-hud .bar:has(.num:empty),\n    .vld-hud .entry:has(.v:empty),\n    .vld-hud .pack:has(.v:empty) {\n      display: none;\n    }\n\n    /* Без имени сводка ни о ком. Пустой маркер не оставляет пустую панель. */\n    .vld-hud .panel:has(.name:empty) {\n      display: none;\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      .vld-hud .hint { transition: none; }\n    }\n  </style>\n</div>",
 "trimStrings": [],
